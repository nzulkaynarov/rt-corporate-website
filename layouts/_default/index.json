{{- $pages := where .Site.RegularPages "Draft" false -}}
[
  {{- range $i, $page := $pages -}}
  {{- if $i }},{{ end }}
  {
    "title": {{ .Title | jsonify }},
    "url": {{ .RelPermalink | jsonify }},
    "description": {{ .Description | jsonify }},
    "content": {{ .Plain | jsonify }},
    "section": {{ .Section | jsonify }},
    "tags": {{ .Params.tags | jsonify }}
  }
  {{- end -}}
]
