{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make content)",
      "Bash(make cms)",
      "Bash(make build)",
      "Bash(make e2e)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run *)",
      "Bash(npx playwright test)",
      "Bash(npx playwright test *)",
      "Bash(node scripts/check-content.mjs)",
      "Bash(node scripts/check-content.mjs *)",
      "Bash(node scripts/validate-cms-config.mjs)",
      "Bash(npx astro preview)",
      "Bash(npx astro preview *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git switch -c content/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin content/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push -u origin main*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/check-content-file.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking content rules…"
          }
        ]
      }
    ]
  }
}
