{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",

  "frontMatter.framework.id": "hugo",
  "frontMatter.framework.startCommand": "hugo server -D --navigateToChanged",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.preview.trailingSlash": true,

  "frontMatter.website.host": "http://localhost:1313",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.content.defaultFileType": "md",
  "frontMatter.content.autoUpdateDate": true,
  "frontMatter.content.fmHighlight": true,
  "frontMatter.content.wysiwyg": true,

  "frontMatter.global.timezone": "Asia/Tashkent",

  "frontMatter.taxonomy.frontMatterType": "YAML",
  "frontMatter.taxonomy.seoTitleLength": 60,
  "frontMatter.taxonomy.seoDescriptionLength": 160,
  "frontMatter.taxonomy.seoSlugLength": 75,
  "frontMatter.taxonomy.seoContentLengh": 1760,
  "frontMatter.taxonomy.alignFilename": true,
  "frontMatter.taxonomy.tags": [],
  "frontMatter.taxonomy.categories": [],

  "frontMatter.taxonomy.customTaxonomy": [
    {
      "id": "status",
      "options": ["completed", "in_progress"]
    }
  ],

  "frontMatter.git.enabled": true,
  "frontMatter.git.commitMessage": "content: {{message}}",
  "frontMatter.git.requiresCommitMessage": ["content"],

  "frontMatter.dashboard.openOnStart": true,
  "frontMatter.dashboard.content.cardTags": "tags",
  "frontMatter.dashboard.content.card.fields.date": true,
  "frontMatter.dashboard.content.card.fields.state": true,
  "frontMatter.dashboard.content.card.fields.description": "description",
  "frontMatter.dashboard.content.pagination": 16,

  "frontMatter.content.i18n": [
    { "title": "Russian", "locale": "ru", "path": "content/ru" },
    { "title": "English", "locale": "en", "path": "content/en" },
    { "title": "Uzbek", "locale": "uz", "path": "content/uz" }
  ],

  "frontMatter.content.sorting": [
    { "id": "date-desc", "title": "Date (newest)", "name": "date", "order": "desc", "type": "date" },
    { "id": "date-asc", "title": "Date (oldest)", "name": "date", "order": "asc", "type": "date" },
    { "id": "title-asc", "title": "Title (A-Z)", "name": "title", "order": "asc", "type": "string" },
    { "id": "weight-asc", "title": "Weight (order)", "name": "weight", "order": "asc", "type": "number" },
    { "id": "modified-desc", "title": "Last modified", "name": "lastmod", "order": "desc", "type": "date" }
  ],
  "frontMatter.content.defaultSorting": "date-desc",

  "frontMatter.content.filters": ["contentFolders", "tags", "categories"],

  "frontMatter.content.placeholders": [
    { "id": "year", "value": "{{year}}" },
    { "id": "month", "value": "{{month}}" }
  ],

  "frontMatter.taxonomy.fieldGroups": [
    {
      "id": "seo",
      "labelField": "title",
      "fields": [
        { "title": "SEO Title", "name": "seo_title", "type": "string", "description": "Override page title for search engines (max 60 chars)" },
        { "title": "SEO Description", "name": "seo_description", "type": "string", "description": "Override description for search engines (max 160 chars)" }
      ]
    },
    {
      "id": "timeline_entry",
      "labelField": "year",
      "fields": [
        { "title": "Year", "name": "year", "type": "string" },
        { "title": "Title", "name": "title", "type": "string" },
        { "title": "Description", "name": "description", "type": "string" }
      ]
    }
  ],

  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "blog",
      "pageBundle": false,
      "fields": [
        { "title": "Title", "name": "title", "type": "string", "required": true },
        { "title": "Description", "name": "description", "type": "string", "description": "SEO description (max 160 chars)" },
        { "title": "Date", "name": "date", "type": "datetime", "default": "{{now}}", "isPublishDate": true },
        { "title": "Last Modified", "name": "lastmod", "type": "datetime", "isModifiedDate": true },
        { "title": "Author", "name": "author", "type": "string", "default": "RailTech" },
        { "title": "Image", "name": "image", "type": "image", "description": "Featured image (16:9 ratio, min 800x450)" },
        { "title": "Tags", "name": "tags", "type": "tags" },
        { "title": "Categories", "name": "categories", "type": "categories" },
        { "title": "Draft", "name": "draft", "type": "draft" }
      ]
    },
    {
      "name": "project",
      "pageBundle": false,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Image",
          "name": "image",
          "type": "image",
          "description": "Project photo (16:10 ratio)"
        },
        {
          "title": "Client",
          "name": "client",
          "type": "string"
        },
        {
          "title": "Year",
          "name": "year",
          "type": "string"
        },
        {
          "title": "Scope",
          "name": "scope",
          "type": "string"
        },
        {
          "title": "Status",
          "name": "status",
          "type": "choice",
          "choices": [
            "completed",
            "in_progress"
          ]
        },
        {
          "title": "Category",
          "name": "category",
          "type": "string"
        },
        {
          "title": "Weight",
          "name": "weight",
          "type": "number",
          "description": "Display order (lower = first)"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft"
        }
      ]
    },
    {
      "name": "service",
      "pageBundle": false,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Weight",
          "name": "weight",
          "type": "number",
          "description": "Display order (lower = first)"
        },
        {
          "title": "Icon",
          "name": "icon",
          "type": "image",
          "description": "Service icon (square, 48x48 or 64x64)"
        },
        {
          "title": "Features",
          "name": "features",
          "type": "list",
          "description": "Key features/benefits list"
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft"
        }
      ]
    },
    {
      "name": "platform",
      "pageBundle": false,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Weight",
          "name": "weight",
          "type": "number",
          "description": "Display order (lower = first)"
        },
        {
          "title": "Tag",
          "name": "tag",
          "type": "string",
          "description": "Badge label above the title"
        },
        {
          "title": "Image",
          "name": "image",
          "type": "image",
          "description": "Platform screenshot (16:10 ratio)"
        },
        {
          "title": "Highlights",
          "name": "highlights",
          "type": "list",
          "description": "Key feature highlights"
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft"
        }
      ]
    },
    {
      "name": "page",
      "pageBundle": false,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Image",
          "name": "image",
          "type": "image"
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft"
        }
      ]
    },
    {
      "name": "default",
      "pageBundle": false,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string"
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft"
        }
      ]
    }
  ],

  "frontMatter.content.pageFolders": [
    { "title": "Blog (RU)", "path": "[[workspace]]/content/ru/blog", "contentTypes": ["blog"], "previewPath": "'blog'", "excludeSubdir": true },
    { "title": "Blog (EN)", "path": "[[workspace]]/content/en/blog", "contentTypes": ["blog"], "previewPath": "'en/blog'", "excludeSubdir": true },
    { "title": "Blog (UZ)", "path": "[[workspace]]/content/uz/blog", "contentTypes": ["blog"], "previewPath": "'uz/blog'", "excludeSubdir": true },
    { "title": "Projects (RU)", "path": "[[workspace]]/content/ru/projects", "contentTypes": ["project"], "previewPath": "'projects'" },
    { "title": "Projects (EN)", "path": "[[workspace]]/content/en/projects", "contentTypes": ["project"], "previewPath": "'en/projects'" },
    { "title": "Projects (UZ)", "path": "[[workspace]]/content/uz/projects", "contentTypes": ["project"], "previewPath": "'uz/projects'" },
    { "title": "Services (RU)", "path": "[[workspace]]/content/ru/services", "contentTypes": ["service"], "previewPath": "'services'" },
    { "title": "Services (EN)", "path": "[[workspace]]/content/en/services", "contentTypes": ["service"], "previewPath": "'en/services'" },
    { "title": "Services (UZ)", "path": "[[workspace]]/content/uz/services", "contentTypes": ["service"], "previewPath": "'uz/services'" },
    { "title": "Platform (RU)", "path": "[[workspace]]/content/ru/platform", "contentTypes": ["platform"], "previewPath": "'platform'" },
    { "title": "Platform (EN)", "path": "[[workspace]]/content/en/platform", "contentTypes": ["platform"], "previewPath": "'en/platform'" },
    { "title": "Platform (UZ)", "path": "[[workspace]]/content/uz/platform", "contentTypes": ["platform"], "previewPath": "'uz/platform'" },
    { "title": "Pages (RU)", "path": "[[workspace]]/content/ru", "contentTypes": ["page"], "excludeSubdir": true },
    { "title": "Pages (EN)", "path": "[[workspace]]/content/en", "contentTypes": ["page"], "excludeSubdir": true },
    { "title": "Pages (UZ)", "path": "[[workspace]]/content/uz", "contentTypes": ["page"], "excludeSubdir": true }
  ],

  "frontMatter.content.snippets": {
    "Image with Caption": {
      "description": "Insert an image with caption text",
      "body": "{{< figure src=\"[[src]]\" alt=\"[[alt]]\" caption=\"[[caption]]\" >}}",
      "fields": [
        { "name": "src", "title": "Image path", "type": "image" },
        { "name": "alt", "title": "Alt text", "type": "string" },
        { "name": "caption", "title": "Caption", "type": "string" }
      ]
    },
    "CTA Block": {
      "description": "Insert a call-to-action button",
      "body": [
        "",
        "<div class=\"cta-inline\">",
        "  <p>[[text]]</p>",
        "  <a href=\"[[link]]\" class=\"btn btn-primary\">[[button_text]]</a>",
        "</div>",
        ""
      ],
      "fields": [
        { "name": "text", "title": "CTA text", "type": "string", "default": "Ready to get started?" },
        { "name": "link", "title": "Button URL", "type": "string", "default": "/contact/" },
        { "name": "button_text", "title": "Button label", "type": "string", "default": "Contact Us" }
      ]
    },
    "Info Box": {
      "description": "Insert a highlighted info block",
      "body": [
        "",
        "> **[[title]]**",
        "> [[content]]",
        ""
      ],
      "fields": [
        { "name": "title", "title": "Title", "type": "string" },
        { "name": "content", "title": "Content", "type": "string" }
      ]
    },
    "Feature List": {
      "description": "Insert a feature checklist",
      "body": [
        "",
        "- ✓ [[feature1]]",
        "- ✓ [[feature2]]",
        "- ✓ [[feature3]]",
        ""
      ],
      "fields": [
        { "name": "feature1", "title": "Feature 1", "type": "string" },
        { "name": "feature2", "title": "Feature 2", "type": "string" },
        { "name": "feature3", "title": "Feature 3", "type": "string" }
      ]
    }
  },

  "frontMatter.media.contentTypes": [
    {
      "name": "default",
      "fileTypes": null,
      "fields": [
        { "title": "Title", "name": "title", "type": "string" },
        { "title": "Alt Text", "name": "alt", "type": "string" },
        { "title": "Caption", "name": "caption", "type": "string" }
      ]
    }
  ],

  "frontMatter.data.files": [
    {
      "id": "company",
      "title": "Company Info",
      "file": "[[workspace]]/data/company.yaml",
      "fileType": "yaml",
      "singleEntry": true,
      "schema": {
        "title": "Company Information",
        "type": "object",
        "required": ["brandName"],
        "properties": {
          "brandName": { "type": "string", "title": "Brand Name" },
          "legalName": { "type": "string", "title": "Legal Name (RU)" },
          "legalNameEn": { "type": "string", "title": "Legal Name (EN)" },
          "legalNameUz": { "type": "string", "title": "Legal Name (UZ)" },
          "foundingYear": { "type": "string", "title": "Founding Year" },
          "businessHours": { "type": "string", "title": "Business Hours (schema.org format)" },
          "address": {
            "type": "object",
            "title": "Address",
            "properties": {
              "city": { "type": "string", "title": "City" },
              "country": { "type": "string", "title": "Country Code (ISO)" },
              "street": { "type": "string", "title": "Street Address" }
            }
          },
          "partners": {
            "type": "array",
            "title": "Partners",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "title": "Partner Name" },
                "logo": { "type": "string", "title": "Logo Path (optional)" }
              }
            }
          }
        }
      }
    },
    {
      "id": "social",
      "title": "Social Media Links",
      "file": "[[workspace]]/data/social.yaml",
      "fileType": "yaml",
      "singleEntry": true,
      "schema": {
        "title": "Social Media",
        "type": "object",
        "properties": {
          "telegram": { "type": "string", "title": "Telegram URL" },
          "facebook": { "type": "string", "title": "Facebook URL" },
          "instagram": { "type": "string", "title": "Instagram URL" },
          "linkedin": { "type": "string", "title": "LinkedIn URL" }
        }
      }
    },
    {
      "id": "stats",
      "title": "Homepage Stats",
      "file": "[[workspace]]/data/stats.yaml",
      "fileType": "yaml",
      "singleEntry": true,
      "schema": {
        "title": "Stats Counter",
        "type": "object",
        "properties": {
          "years": { "type": "string", "title": "Years on Market" },
          "partners": { "type": "string", "title": "Number of Partners" },
          "skus": { "type": "string", "title": "SKUs in Catalog" },
          "countries": { "type": "string", "title": "Countries" }
        }
      }
    },
    {
      "id": "advantages",
      "title": "Advantages Section",
      "file": "[[workspace]]/data/advantages.yaml",
      "fileType": "yaml",
      "labelField": "titleKey",
      "schema": {
        "title": "Advantage Item",
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "title": "Advantages",
            "items": {
              "type": "object",
              "properties": {
                "titleKey": { "type": "string", "title": "i18n Title Key" },
                "descKey": { "type": "string", "title": "i18n Description Key" },
                "icon": { "type": "string", "title": "SVG Icon HTML" }
              }
            }
          }
        }
      }
    }
  ],

  "frontMatter.custom.scripts": [
    {
      "id": "create-translation",
      "title": "Create missing translations",
      "script": ".frontmatter/scripts/create-translations.js",
      "command": "node"
    }
  ]
}