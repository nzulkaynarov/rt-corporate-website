{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",

  "frontMatter.framework.id": "hugo",
  "frontMatter.framework.startCommand": "hugo server -D --navigateToChanged",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.preview.trailingSlash": true,

  "frontMatter.website.host": "http://localhost:1313",
  "frontMatter.website.baseUrl": "https://railtech.uz",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.content.defaultFileType": "md",
  "frontMatter.content.autoUpdateDate": true,
  "frontMatter.content.fmHighlight": true,
  "frontMatter.content.wysiwyg": true,

  "frontMatter.global.timezone": "Asia/Tashkent",

  "frontMatter.taxonomy.frontMatterType": "YAML",
  "frontMatter.taxonomy.seoTitleLength": 60,
  "frontMatter.taxonomy.seoDescriptionLength": 160,
  "frontMatter.taxonomy.seoSlugLength": 75,
  "frontMatter.taxonomy.seoContentLengh": 1760,
  "frontMatter.taxonomy.alignFilename": true,
  "frontMatter.taxonomy.tags": [
    "Безопасность", "Железная дорога", "Аналитика", "Платформа", "B2B", "Импорт", "Таможня", "Руководство", "Диагностика", "Мониторинг", "Инфраструктура", "САУТ", "Автоматизация", "Новости",
    "Safety", "Railway", "Analytics", "Platform", "Import", "Customs", "Guide", "Diagnostics", "Monitoring", "Infrastructure", "SAUT", "Automation", "News",
    "Xavfsizlik", "Signalizatsiya", "Texnologiyalar", "B2B platforma", "Raqamlashtirish", "Bojxona", "Logistika", "Sanoat tahlili"
  ],
  "frontMatter.taxonomy.categories": [
    "Аналитика", "Новости компании", "Руководства",
    "Analytics", "Company News", "Guides",
    "Tahlil", "Kompaniya yangiliklari", "Amaliy qo'llanma"
  ],

  "frontMatter.taxonomy.customTaxonomy": [
    {
      "id": "articleType",
      "options": ["Article", "News", "Tutorial", "Case Study", "Opinion"]
    },
    {
      "id": "difficulty",
      "options": ["Beginner", "Intermediate", "Advanced"]
    },
    {
      "id": "projectStatus",
      "options": ["Completed", "In Progress", "Planning"]
    }
  ],

  "frontMatter.git.enabled": true,
  "frontMatter.git.commitMessage": "content: {{date}} — {{title}}",

  "frontMatter.dashboard.openOnStart": true,
  "frontMatter.dashboard.content.cardTags": "tags",
  "frontMatter.dashboard.content.card.fields.date": true,
  "frontMatter.dashboard.content.card.fields.state": true,
  "frontMatter.dashboard.content.card.fields.description": "description",
  "frontMatter.dashboard.content.pagination": 16,

  "frontMatter.content.i18n": [
    { "title": "Russian", "locale": "ru", "path": "[[workspace]]/content/ru" },
    { "title": "English", "locale": "en", "path": "[[workspace]]/content/en" },
    { "title": "Uzbek", "locale": "uz", "path": "[[workspace]]/content/uz" }
  ],

  "frontMatter.content.sorting": [
    { "id": "date-desc", "title": "Date (newest)", "name": "date", "order": "desc", "type": "date" },
    { "id": "date-asc", "title": "Date (oldest)", "name": "date", "order": "asc", "type": "date" },
    { "id": "title-asc", "title": "Title (A-Z)", "name": "title", "order": "asc", "type": "string" },
    { "id": "weight-asc", "title": "Weight (order)", "name": "weight", "order": "asc", "type": "number" }
  ],
  "frontMatter.content.defaultSorting": "date-desc",

  "frontMatter.content.filters": ["contentFolders", "tags", "categories"],

  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "blog",
      "pageBundle": false,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true,
          "description": "Article title (appears in browser tab and search results)"
        },
        {
          "title": "SEO Title",
          "name": "seoTitle",
          "type": "string",
          "description": "Custom title for search results (60 chars max). Leave empty to use title field"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string",
          "description": "Meta description for search engines (160 chars). Used in search results snippet"
        },
        {
          "title": "Date Published",
          "name": "date",
          "type": "datetime",
          "required": true,
          "description": "Publication date (ISO format)"
        },
        {
          "title": "Date Updated",
          "name": "lastmod",
          "type": "datetime",
          "description": "Last modification date (optional)"
        },
        {
          "title": "Author",
          "name": "author",
          "type": "string",
          "default": "RailTech"
        },
        {
          "title": "Featured Image",
          "name": "image",
          "type": "image",
          "description": "Featured image (appears in article header and preview cards)"
        },
        {
          "title": "OG Image",
          "name": "ogImage",
          "type": "image",
          "description": "Custom image for social media sharing (1200x630px recommended). Falls back to featured image"
        },
        {
          "title": "Canonical URL",
          "name": "canonicalUrl",
          "type": "string",
          "description": "Full URL if article exists on another site (optional)"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags",
          "description": "Content tags for filtering"
        },
        {
          "title": "Categories",
          "name": "categories",
          "type": "categories",
          "description": "Content categories"
        },
        {
          "title": "Article Type",
          "name": "articleType",
          "type": "choice",
          "choices": ["Article", "News", "Tutorial", "Case Study", "Opinion"],
          "default": "Article"
        },
        {
          "title": "Difficulty",
          "name": "difficulty",
          "type": "choice",
          "choices": ["Beginner", "Intermediate", "Advanced"],
          "description": "Reading difficulty level (optional)"
        },
        {
          "title": "Show Hero Image",
          "name": "showHero",
          "type": "boolean",
          "default": true,
          "description": "Blowfish: Display hero section at top of article"
        },
        {
          "title": "Hero Style",
          "name": "heroStyle",
          "type": "choice",
          "choices": ["basic", "background", "image"],
          "default": "basic",
          "description": "Blowfish: How hero section displays"
        },
        {
          "title": "Show Table of Contents",
          "name": "showTableOfContents",
          "type": "boolean",
          "default": true,
          "description": "Blowfish: Show auto-generated TOC from headings"
        },
        {
          "title": "Show Related Posts",
          "name": "showRelatedContent",
          "type": "boolean",
          "default": true,
          "description": "Blowfish: Show related articles at bottom"
        },
        {
          "title": "Show Date",
          "name": "showDate",
          "type": "boolean",
          "default": true,
          "description": "Blowfish: Show publication date on article"
        },
        {
          "title": "Show Author",
          "name": "showAuthor",
          "type": "boolean",
          "default": true,
          "description": "Blowfish: Show author name on article"
        },
        {
          "title": "Show Breadcrumbs",
          "name": "showBreadcrumbs",
          "type": "boolean",
          "default": true,
          "description": "Blowfish: Show navigation breadcrumb trail"
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft",
          "description": "Mark as draft to hide from production build"
        }
      ]
    },

    {
      "name": "project",
      "pageBundle": false,
      "fields": [
        {
          "title": "Project Title",
          "name": "title",
          "type": "string",
          "required": true,
          "description": "Project name"
        },
        {
          "title": "SEO Title",
          "name": "seoTitle",
          "type": "string",
          "description": "Custom title for search results (60 chars max)"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string",
          "description": "Project overview (meta description, 160 chars)"
        },
        {
          "title": "Featured Image",
          "name": "image",
          "type": "image",
          "description": "Project hero image"
        },
        {
          "title": "OG Image",
          "name": "ogImage",
          "type": "image",
          "description": "Social sharing image"
        },
        {
          "title": "Client",
          "name": "client",
          "type": "string",
          "description": "Client name (if applicable)"
        },
        {
          "title": "Project Year",
          "name": "year",
          "type": "string",
          "description": "Year completed (YYYY)"
        },
        {
          "title": "Project Scope",
          "name": "scope",
          "type": "string",
          "description": "Brief scope description (equipment supplied, services provided)"
        },
        {
          "title": "Project Status",
          "name": "projectStatus",
          "type": "choice",
          "choices": ["Completed", "In Progress", "Planning"],
          "default": "Completed"
        },
        {
          "title": "Category",
          "name": "category",
          "type": "string",
          "description": "Project category (e.g., Railway Infrastructure, Consulting)"
        },
        {
          "title": "Display Order",
          "name": "weight",
          "type": "number",
          "description": "Lower number = appears first in lists"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Show Hero Image",
          "name": "showHero",
          "type": "boolean",
          "default": true,
          "description": "Blowfish: Display hero image at top"
        },
        {
          "title": "Hero Style",
          "name": "heroStyle",
          "type": "choice",
          "choices": ["basic", "background", "image"],
          "default": "basic",
          "description": "Blowfish: How hero section displays"
        },
        {
          "title": "Show Breadcrumbs",
          "name": "showBreadcrumbs",
          "type": "boolean",
          "default": true,
          "description": "Blowfish: Show navigation breadcrumb trail"
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft"
        }
      ]
    },

    {
      "name": "service",
      "pageBundle": false,
      "fields": [
        {
          "title": "Service Name",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "SEO Title",
          "name": "seoTitle",
          "type": "string",
          "description": "Custom title for search results (60 chars max)"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string",
          "description": "Meta description (160 chars)"
        },
        {
          "title": "Service Icon/Image",
          "name": "icon",
          "type": "image",
          "description": "Icon or image for service card"
        },
        {
          "title": "Featured Image",
          "name": "image",
          "type": "image",
          "description": "Full-width hero image for service page"
        },
        {
          "title": "OG Image",
          "name": "ogImage",
          "type": "image",
          "description": "Social sharing image"
        },
        {
          "title": "Key Features (List)",
          "name": "features",
          "type": "list",
          "description": "Bullet-point features (one per line)"
        },
        {
          "title": "Display Order",
          "name": "weight",
          "type": "number",
          "description": "Lower number = appears first in lists"
        },
        {
          "title": "Show Hero Image",
          "name": "showHero",
          "type": "boolean",
          "default": true,
          "description": "Blowfish: Display hero image at top"
        },
        {
          "title": "Hero Style",
          "name": "heroStyle",
          "type": "choice",
          "choices": ["basic", "background", "image"],
          "default": "basic"
        },
        {
          "title": "Show Breadcrumbs",
          "name": "showBreadcrumbs",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft"
        }
      ]
    },

    {
      "name": "platform",
      "pageBundle": false,
      "fields": [
        {
          "title": "Feature Name",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "SEO Title",
          "name": "seoTitle",
          "type": "string",
          "description": "Custom title for search results"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string",
          "description": "Feature description (meta description)"
        },
        {
          "title": "Feature Tag",
          "name": "tag",
          "type": "string",
          "description": "Grouping tag (e.g., 'Catalog', 'Analytics')"
        },
        {
          "title": "Feature Image",
          "name": "image",
          "type": "image",
          "description": "Screenshot or feature image"
        },
        {
          "title": "OG Image",
          "name": "ogImage",
          "type": "image"
        },
        {
          "title": "Key Highlights (List)",
          "name": "highlights",
          "type": "list",
