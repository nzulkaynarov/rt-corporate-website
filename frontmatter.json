    },
    {
      "title": "Pages (EN)",
      "path": "[[workspace]]/content/en",
      "contentTypes": ["page"],
      "excludeSubdir": true
    },
    {
      "title": "Pages (UZ)",
      "path": "[[workspace]]/content/uz",
      "contentTypes": ["page"],
      "excludeSubdir": true
    }
  ],

  "frontMatter.content.snippets": {
    "Button (CTA)": {
      "description": "Blowfish button — call to action",
      "body": [
        "{{< button href=\"[[link]]\" [[&target]] >}}",
        "[[label]]",
        "{{< /button >}}"
      ],
      "fields": [
        {
          "name": "label",
          "title": "Button text",
          "type": "string",
          "default": "Связаться с нами"
        },
        {
          "name": "link",
          "title": "URL",
          "type": "string",
          "default": "/contact/"
        },
        {
          "name": "target",
          "title": "Opens in new tab?",
          "type": "choice",
          "choices": ["", "target=\"_blank\""],
          "default": ""
        }
      ]
    },

    "Alert Box": {
      "description": "Blowfish highlighted callout box with icon",
      "body": [
        "",
        "{{< alert icon=\"[[icon]]\" >}}",
        "[[content]]",
        "{{< /alert >}}",
        ""
      ],
      "fields": [
        {
          "name": "icon",
          "title": "Icon name",
          "type": "choice",
          "choices": ["circle-info", "triangle-exclamation", "fire", "check", "star", "bell", "chart-bar", "briefcase", "eye", "computer-desktop", "truck"],
          "default": "circle-info"
        },
        {
          "name": "content",
          "title": "Alert text (markdown supported)",
          "type": "string"
        }
      ]
    },

    "Badge": {
      "description": "Blowfish inline badge/tag",
      "body": ["{{< badge >}}[[text]]{{< /badge >}} "],
      "fields": [
        {
          "name": "text",
          "title": "Badge text",
          "type": "string"
        }
      ]
    },

    "Lead Paragraph": {
      "description": "Large introductory paragraph — use at top of page",
      "body": [
        "",
        "{{< lead >}}",
        "[[text]]",
        "{{< /lead >}}",
        ""
      ],
      "fields": [
        {
          "name": "text",
          "title": "Lead text",
          "type": "string"
        }
      ]
    },

    "Carousel (Image Slider)": {
      "description": "Auto-scrolling image slider — great for projects and equipment",
      "body": [
        "",
        "{{< carousel images=\"{[[images]]}\" aspectRatio=\"[[ratio]]\" interval=\"[[interval]]\" >}}",
        ""
      ],
      "fields": [
        {
          "name": "images",
          "title": "Image paths (comma-separated, e.g.: /img/photo1.jpg,/img/photo2.jpg)",
          "type": "string"
        },
        {
          "name": "ratio",
          "title": "Aspect ratio",
          "type": "choice",
          "choices": ["16-9", "21-9", "4-3", "1-1"],
          "default": "16-9"
        },
        {
          "name": "interval",
          "title": "Slide interval (ms)",
          "type": "choice",
          "choices": ["2000", "3000", "4000", "5000"],
          "default": "3000"
        }
      ]
    },

    "Timeline": {
      "description": "Vertical timeline — use for company history or project milestones",
      "body": [
        "",
        "{{< timeline >}}",
        "",
        "{{< timelineItem icon=\"[[icon1]]\" header=\"[[year1]]\" badge=\"[[badge1]]\" subheader=\"[[sub1]]\" >}}",
        "[[desc1]]",
        "{{< /timelineItem >}}",
        "",
        "{{< timelineItem icon=\"[[icon2]]\" header=\"[[year2]]\" badge=\"[[badge2]]\" subheader=\"[[sub2]]\" >}}",
        "[[desc2]]",
        "{{< /timelineItem >}}",
        "",
        "{{< /timeline >}}",
        ""
      ],
      "fields": [
        {
          "name": "year1",
          "title": "First item — year/header",
          "type": "string",
          "default": "2024"
        },
        {
          "name": "badge1",
          "title": "First item — badge label",
          "type": "string",
          "default": "Milestone"
        },
        {
          "name": "sub1",
          "title": "First item — subtitle",
          "type": "string"
        },
        {
          "name": "icon1",
          "title": "First item — icon",
          "type": "choice",
          "choices": ["rocket", "check", "star", "globe-alt", "chart-bar", "computer-desktop", "document-text", "users"],
          "default": "rocket"
        },
        {
          "name": "desc1",
          "title": "First item — description",
          "type": "string"
        },
        {
          "name": "year2",
          "title": "Second item — year/header",
          "type": "string",
          "default": "2025"
        },
        {
          "name": "badge2",
          "title": "Second item — badge label",
          "type": "string",
          "default": "Current"
        },
        {
          "name": "sub2",
          "title": "Second item — subtitle",
          "type": "string"
        },
        {
          "name": "icon2",
          "title": "Second item — icon",
          "type": "choice",
          "choices": ["rocket", "check", "star", "globe-alt", "chart-bar", "computer-desktop", "document-text", "users"],
          "default": "chart-bar"
        },
        {
          "name": "desc2",
          "title": "Second item — description",
          "type": "string"
        }
      ]
    },

    "Timeline Item (add to existing)": {
      "description": "Add one more item to an existing timeline block",
      "body": [
        "",
        "{{< timelineItem icon=\"[[icon]]\" header=\"[[year]]\" badge=\"[[badge]]\" subheader=\"[[sub]]\" >}}",
        "[[desc]]",
        "{{< /timelineItem >}}",
        ""
      ],
      "fields": [
        {
          "name": "year",
          "title": "Year/header",
          "type": "string"
        },
        {
          "name": "badge",
          "title": "Badge label",
          "type": "string"
        },
        {
          "name": "sub",
          "title": "Subtitle",
          "type": "string"
        },
        {
          "name": "icon",
          "title": "Icon",
          "type": "choice",
          "choices": ["rocket", "check", "star", "globe-alt", "chart-bar", "computer-desktop", "document-text", "users"],
          "default": "check"
        },
        {
          "name": "desc",
          "title": "Description",
          "type": "string"
        }
      ]
    },

    "Tabs (Tabbed Content)": {
      "description": "Tabbed content sections — great for service categories",
      "body": [
        "",
        "{{< tabs >}}",
        "",
        "{{< tab label=\"[[label1]]\" icon=\"[[icon1]]\" >}}",
        "[[content1]]",
        "{{< /tab >}}",
        "",
        "{{< tab label=\"[[label2]]\" icon=\"[[icon2]]\" >}}",
        "[[content2]]",
        "{{< /tab >}}",
        "",
        "{{< /tabs >}}",
        ""
      ],
      "fields": [
        {
          "name": "label1",
          "title": "First tab label",
          "type": "string",
          "default": "Tab 1"
        },
        {
          "name": "icon1",
          "title": "First tab icon",
          "type": "choice",
          "choices": ["truck", "search", "globe", "users", "star", "check", "computer-desktop", "chart-bar"],
          "default": "star"
        },
        {
          "name": "content1",
          "title": "First tab content (markdown)",
          "type": "string"
        },
        {
          "name": "label2",
          "title": "Second tab label",
          "type": "string",
          "default": "Tab 2"
        },
        {
          "name": "icon2",
          "title": "Second tab icon",
          "type": "choice",
          "choices": ["truck", "search", "globe", "users", "star", "check", "computer-desktop", "chart-bar"],
          "default": "check"
        },
        {
          "name": "content2",
          "title": "Second tab content (markdown)",
          "type": "string"
        }
      ]
    },

    "Accordion (FAQ/Details)": {
      "description": "Collapsible sections — perfect for FAQ, advantages",
      "body": [
        "",
        "{{< accordion [[&separated]] >}}",
        "",
        "{{< accordionItem title=\"[[title1]]\" [[&icon1]] >}}",
        "[[content1]]",
        "{{< /accordionItem >}}",
        "",
        "{{< accordionItem title=\"[[title2]]\" [[&icon2]] >}}",
        "[[content2]]",
        "{{< /accordionItem >}}",
        "",
        "{{< /accordion >}}",
        ""
      ],
      "fields": [
        {
          "name": "separated",
          "title": "Visual style",
          "type": "choice",
          "choices": ["", "separated=true"],
          "default": ""
        },
        {
          "name": "title1",
          "title": "First item title",
          "type": "string"
        },
        {
          "name": "icon1",
          "title": "First item icon (optional)",
          "type": "choice",
          "choices": ["", "icon=\"star\"", "icon=\"shield\"", "icon=\"check\"", "icon=\"globe\"", "icon=\"comment\"", "icon=\"fire\""],
          "default": ""
        },
        {
          "name": "content1",
          "title": "First item content",
          "type": "string"
        },
        {
          "name": "title2",
          "title": "Second item title",
          "type": "string"
        },
        {
          "name": "icon2",
          "title": "Second item icon (optional)",
          "type": "choice",
          "choices": ["", "icon=\"star\"", "icon=\"shield\"", "icon=\"check\"", "icon=\"globe\"", "icon=\"comment\"", "icon=\"fire\""],
          "default": ""
        },
        {
          "name": "content2",
          "title": "Second item content",
          "type": "string"
        }
      ]
    },

    "Figure (Image with Caption)": {
      "description": "Image with optional caption — auto-optimized by Hugo",
      "body": [
        "",
        "{{< figure src=\"[[src]]\" alt=\"[[alt]]\" caption=\"[[caption]]\" >}}",
        ""
      ],
      "fields": [
        {
          "name": "src",
          "title": "Image file (from page bundle or /img/...)",
          "type": "image"
        },
        {
          "name": "alt",
          "title": "Alt text (accessibility + SEO)",
          "type": "string"
        },
        {
          "name": "caption",
          "title": "Caption (shown below image)",
          "type": "string"
        }
      ]
    },

    "Gallery": {
      "description": "Image grid gallery — place images in page bundle folder",
      "body": [
        "",
        "{{< gallery >}}",
        "  ![[[alt1]]]([[image1]])",
        "  ![[[alt2]]]([[image2]])",
        "  ![[[alt3]]]([[image3]])",
        "{{< /gallery >}}",
        ""
      ],
      "fields": [
        {
          "name": "image1",
          "title": "First image",
          "type": "image"
        },
        {
          "name": "alt1",
          "title": "Alt text 1",
          "type": "string"
        },
        {
          "name": "image2",
          "title": "Second image",
          "type": "image"
        },
        {
          "name": "alt2",
          "title": "Alt text 2",
          "type": "string"
        },
        {
          "name": "image3",
          "title": "Third image",
          "type": "image"
        },
        {
          "name": "alt3",
          "title": "Alt text 3",
          "type": "string"
        }
      ]
    },

    "TypeIt (Animated Text)": {
      "description": "Typing animation effect — use for hero headlines",
      "body": [
        "",
        "{{< typeit speed=\"[[speed]]\" lifeLike=true startDelay=\"500\" >}}",
        "[[text]]",
        "{{< /typeit >}}",
        ""
      ],
      "fields": [
        {
          "name": "text",
          "title": "Text to animate",
          "type": "string"
        },
        {
          "name": "speed",
          "title": "Typing speed (ms per char)",
          "type": "choice",
          "choices": ["30", "50", "80", "100"],
          "default": "50"
        }
      ]
    },

    "List (Article Cards)": {
      "description": "Show article cards from a section — auto-populated",
      "body": [
        "",
        "{{< list title=\"[[title]]\" cardView=true limit=[[limit]] where=\"Section\" value=\"[[section]]\" >}}",
        ""
      ],
      "fields": [
        {
          "name": "title",
          "title": "Section heading",
          "type": "string",
          "default": "Related"
        },
        {
          "name": "section",
          "title": "Section to pull from",
          "type": "choice",
          "choices": ["blog", "projects", "services", "platform"],
          "default": "blog"
        },
        {
          "name": "limit",
          "title": "Max items to show",
          "type": "choice",
          "choices": ["3", "4", "6", "9"],
          "default": "4"
        }
      ]
    },

    "Horizontal Rule": {
      "description": "Visual divider between sections",
      "body": ["", "---", ""]
    }
  },

