          "description": "Homepage title (also used in browser tab and SEO)"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string",
          "description": "Meta description for homepage (160 chars)"
        },
        {
          "title": "FAQ Items",
          "name": "faq",
          "type": "block",
          "description": "Frequently Asked Questions displayed on the homepage",
          "fields": [
            {
              "title": "Question",
              "name": "question",
              "type": "string"
            },
            {
              "title": "Answer",
              "name": "answer",
