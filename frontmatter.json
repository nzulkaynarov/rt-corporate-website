  "frontMatter.content.snippets": {
    "Button": {
      "description": "Blowfish button shortcode (CTA)",
      "body": [
        "",
        "{{< button href=\"[[link]]\" target=\"[[target]]\" >}}",
        "[[label]]",
        "{{< /button >}}",
        ""
      ],
      "fields": [
        {
          "name": "label",
          "title": "Button label",
          "type": "string",
          "default": "Contact Us"
        },
        {
          "name": "link",
          "title": "URL",
          "type": "string",
          "default": "/contact/"
        },
        {
          "name": "target",
          "title": "Target (_self, _blank, etc)",
          "type": "string",
          "default": "_self"
        }
      ]
    },
    "Alert": {
      "description": "Blowfish alert/callout box",
      "body": [
        "",
        "{{< alert \"[[icon]]\" >}}",
        "[[content]]",
        "{{< /alert >}}",
        ""
      ],
      "fields": [
        {
          "name": "icon",
          "title": "Icon (empty, comment, check, fire, bomb, circle-info, circle-check, etc.)",
          "type": "string",
          "default": ""
        },
        {
          "name": "content",
          "title": "Alert text",
          "type": "string"
        }
      ]
    },
    "Badge": {
      "description": "Blowfish inline badge",
      "body": ["{{< badge >}}[[text]]{{< /badge >}}"],
      "fields": [
        {
          "name": "text",
          "title": "Badge text",
          "type": "string"
        }
      ]
    },
    "Gallery": {
      "description": "Blowfish image gallery",
      "body": [
        "",
        "{{< gallery >}}",
        "  {{< img src=\"[[image1]]\" alt=\"[[alt1]]\" >}}",
        "  {{< img src=\"[[image2]]\" alt=\"[[alt2]]\" >}}",
        "{{< /gallery >}}",
        ""
      ],
      "fields": [
        {
          "name": "image1",
          "title": "First image",
          "type": "image"
        },
        {
          "name": "alt1",
          "title": "Alt text for image 1",
          "type": "string"
        },
        {
          "name": "image2",
          "title": "Second image",
          "type": "image"
        },
        {
          "name": "alt2",
          "title": "Alt text for image 2",
          "type": "string"
        }
      ]
    },
    "Columns": {
      "description": "Blowfish multi-column layout",
      "body": [
        "",
        "{{< columns >}}",
        "[[col1_content]]",
        "<---->",
        "[[col2_content]]",
        "{{< /columns >}}",
        ""
      ],
      "fields": [
        {
          "name": "col1_content",
          "title": "Left column content",
          "type": "textarea"
        },
        {
          "name": "col2_content",
          "title": "Right column content",
          "type": "textarea"
        }
      ]
    }
  },

  "frontMatter.data.files": [
    {
      "id": "seo",
      "title": "Global SEO Settings",
      "file": "[[workspace]]/data/seo.yaml",
      "fileType": "yaml",
      "labelField": "site.name",
      "schema": {
        "title": "SEO Configuration",
        "type": "object",
        "properties": {
          "site": {
            "type": "object",
            "title": "Site Identity",
            "properties": {
              "name": { "type": "string", "title": "Site Name" },
              "title": { "type": "string", "title": "Default Site Title" },
              "description": { "type": "string", "title": "Default Meta Description" },
              "url": { "type": "string", "title": "Site URL" },
              "ogImage": { "type": "string", "title": "Fallback OG Image Path" }
            }
          },
          "seo": {
            "type": "object",
            "title": "SEO Settings",
            "properties": {
              "defaultRobots": { "type": "string", "title": "Default robots directive" },
              "canonicalStrategy": { "type": "string", "title": "Canonical URL strategy" }
            }
          },
          "openGraph": {
            "type": "object",
            "title": "Open Graph",
            "properties": {
              "enabled": { "type": "boolean", "title": "Enable OG" },
              "cardType": { "type": "string", "title": "Default card type" }
            }
          },
          "twitter": {
            "type": "object",
            "title": "Twitter Card",
            "properties": {
              "enabled": { "type": "boolean" },
