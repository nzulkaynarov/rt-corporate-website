{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",

  "frontMatter.framework.id": "hugo",
  "frontMatter.framework.startCommand": "hugo server -D --navigateToChanged",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.preview.trailingSlash": true,

  "frontMatter.website.host": "http://localhost:1313",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.content.defaultFileType": "md",
  "frontMatter.content.autoUpdateDate": true,
  "frontMatter.content.fmHighlight": true,
  "frontMatter.content.wysiwyg": true,

  "frontMatter.global.timezone": "Asia/Tashkent",

  "frontMatter.taxonomy.frontMatterType": "YAML",
  "frontMatter.taxonomy.seoTitleLength": 60,
  "frontMatter.taxonomy.seoDescriptionLength": 160,
  "frontMatter.taxonomy.seoSlugLength": 75,
  "frontMatter.taxonomy.seoContentLengh": 1760,
  "frontMatter.taxonomy.alignFilename": true,
  "frontMatter.taxonomy.tags": [],
  "frontMatter.taxonomy.categories": [],

  "frontMatter.taxonomy.customTaxonomy": [
    {
      "id": "status",
      "options": ["completed", "in_progress"]
    }
  ],

  "frontMatter.git.enabled": true,

  "frontMatter.dashboard.openOnStart": true,
  "frontMatter.dashboard.content.cardTags": "tags",
  "frontMatter.dashboard.content.card.fields.date": true,
  "frontMatter.dashboard.content.card.fields.state": true,
  "frontMatter.dashboard.content.card.fields.description": "description",
  "frontMatter.dashboard.content.pagination": 16,

  "frontMatter.content.i18n": [
    { "title": "Russian", "locale": "ru", "path": "[[workspace]]/content/ru" },
    { "title": "English", "locale": "en", "path": "[[workspace]]/content/en" },
    { "title": "Uzbek", "locale": "uz", "path": "[[workspace]]/content/uz" }
  ],

  "frontMatter.content.sorting": [
    { "id": "date-desc", "title": "Date (newest)", "name": "date", "order": "desc", "type": "date" },
    { "id": "date-asc", "title": "Date (oldest)", "name": "date", "order": "asc", "type": "date" },
    { "id": "title-asc", "title": "Title (A-Z)", "name": "title", "order": "asc", "type": "string" },
    { "id": "weight-asc", "title": "Weight (order)", "name": "weight", "order": "asc", "type": "number" }
  ],
  "frontMatter.content.defaultSorting": "date-desc",

  "frontMatter.content.filters": ["contentFolders", "tags", "categories"],

  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "blog",
      "pageBundle": false,
      "fields": [
        { "title": "Title", "name": "title", "type": "string", "required": true },
        { "title": "Description", "name": "description", "type": "string" },
        { "title": "Date", "name": "date", "type": "datetime" },
        { "title": "Author", "name": "author", "type": "string", "default": "RailTech" },
        { "title": "Image", "name": "image", "type": "image" },
        { "title": "Tags", "name": "tags", "type": "tags" },
        { "title": "Categories", "name": "categories", "type": "categories" },
        { "title": "Draft", "name": "draft", "type": "draft" }
      ]
    },
    {
      "name": "project",
      "pageBundle": false,
      "fields": [
        { "title": "Title", "name": "title", "type": "string", "required": true },
        { "title": "Description", "name": "description", "type": "string" },
        { "title": "Image", "name": "image", "type": "image" },
        { "title": "Client", "name": "client", "type": "string" },
        { "title": "Year", "name": "year", "type": "string" },
        { "title": "Scope", "name": "scope", "type": "string" },
        { "title": "Status", "name": "status", "type": "choice", "choices": ["completed", "in_progress"] },
        { "title": "Category", "name": "category", "type": "string" },
        { "title": "Weight", "name": "weight", "type": "number" },
        { "title": "Tags", "name": "tags", "type": "tags" },
        { "title": "Draft", "name": "draft", "type": "draft" }
      ]
    },
    {
      "name": "service",
      "pageBundle": false,
      "fields": [
        { "title": "Title", "name": "title", "type": "string", "required": true },
        { "title": "Description", "name": "description", "type": "string" },
        { "title": "Weight", "name": "weight", "type": "number" },
        { "title": "Icon", "name": "icon", "type": "image" },
        { "title": "Features", "name": "features", "type": "list" },
        { "title": "Draft", "name": "draft", "type": "draft" }
      ]
    },
    {
      "name": "platform",
      "pageBundle": false,
      "fields": [
        { "title": "Title", "name": "title", "type": "string", "required": true },
        { "title": "Description", "name": "description", "type": "string" },
        { "title": "Weight", "name": "weight", "type": "number" },
        { "title": "Tag", "name": "tag", "type": "string" },
        { "title": "Image", "name": "image", "type": "image" },
        { "title": "Highlights", "name": "highlights", "type": "list" },
        { "title": "Draft", "name": "draft", "type": "draft" }
      ]
    },
    {
      "name": "page",
      "pageBundle": false,
      "fields": [
        { "title": "Title", "name": "title", "type": "string", "required": true },
        { "title": "Description", "name": "description", "type": "string" },
        { "title": "Image", "name": "image", "type": "image" },
        { "title": "Draft", "name": "draft", "type": "draft" }
      ]
    },
    {
      "name": "default",
      "pageBundle": false,
      "fields": [
        { "title": "Title", "name": "title", "type": "string", "required": true },
        { "title": "Description", "name": "description", "type": "string" },
        { "title": "Draft", "name": "draft", "type": "draft" }
      ]
    }
  ],

  "frontMatter.content.pageFolders": [
    { "title": "Blog (RU)", "path": "[[workspace]]/content/ru/blog", "contentTypes": ["blog"], "previewPath": "'blog'", "excludeSubdir": true },
    { "title": "Blog (EN)", "path": "[[workspace]]/content/en/blog", "contentTypes": ["blog"], "previewPath": "'en/blog'", "excludeSubdir": true },
    { "title": "Blog (UZ)", "path": "[[workspace]]/content/uz/blog", "contentTypes": ["blog"], "previewPath": "'uz/blog'", "excludeSubdir": true },
    { "title": "Projects (RU)", "path": "[[workspace]]/content/ru/projects", "contentTypes": ["project"], "previewPath": "'projects'" },
    { "title": "Projects (EN)", "path": "[[workspace]]/content/en/projects", "contentTypes": ["project"], "previewPath": "'en/projects'" },
    { "title": "Projects (UZ)", "path": "[[workspace]]/content/uz/projects", "contentTypes": ["project"], "previewPath": "'uz/projects'" },
    { "title": "Services (RU)", "path": "[[workspace]]/content/ru/services", "contentTypes": ["service"], "previewPath": "'services'" },
    { "title": "Services (EN)", "path": "[[workspace]]/content/en/services", "contentTypes": ["service"], "previewPath": "'en/services'" },
    { "title": "Services (UZ)", "path": "[[workspace]]/content/uz/services", "contentTypes": ["service"], "previewPath": "'uz/services'" },
    { "title": "Platform (RU)", "path": "[[workspace]]/content/ru/platform", "contentTypes": ["platform"], "previewPath": "'platform'" },
    { "title": "Platform (EN)", "path": "[[workspace]]/content/en/platform", "contentTypes": ["platform"], "previewPath": "'en/platform'" },
    { "title": "Platform (UZ)", "path": "[[workspace]]/content/uz/platform", "contentTypes": ["platform"], "previewPath": "'uz/platform'" },
    { "title": "Pages (RU)", "path": "[[workspace]]/content/ru", "contentTypes": ["page"], "excludeSubdir": true },
    { "title": "Pages (EN)", "path": "[[workspace]]/content/en", "contentTypes": ["page"], "excludeSubdir": true },
    { "title": "Pages (UZ)", "path": "[[workspace]]/content/uz", "contentTypes": ["page"], "excludeSubdir": true }
  ],

  "frontMatter.content.snippets": {
    "Button": {
      "description": "Blowfish button shortcode",
      "body": [
        "",
        "{{< button href=\"[[link]]\" target=\"[[target]]\" >}}",
        "[[label]]",
        "{{< /button >}}",
        ""
      ],
      "fields": [
        { "name": "label", "title": "Button label", "type": "string", "default": "Contact Us" },
        { "name": "link", "title": "URL", "type": "string", "default": "/contact/" },
        { "name": "target", "title": "Target", "type": "string", "default": "_self" }
      ]
    },
    "Alert": {
      "description": "Blowfish alert shortcode",
      "body": [
        "",
        "{{< alert \"[[icon]]\" >}}",
        "[[content]]",
        "{{< /alert >}}",
        ""
      ],
      "fields": [
        { "name": "icon", "title": "Icon (empty, comment, check, fire, bomb, etc.)", "type": "string", "default": "" },
        { "name": "content", "title": "Alert text", "type": "string" }
      ]
    },
    "Badge": {
      "description": "Blowfish badge shortcode",
      "body": ["{{< badge >}}[[text]]{{< /badge >}}"],
      "fields": [
        { "name": "text", "title": "Badge text", "type": "string" }
      ]
    }
  },

  "frontMatter.data.files": [
    {
      "id": "company",
      "title": "Company Info",
      "file": "[[workspace]]/data/company.yaml",
      "fileType": "yaml",
      "labelField": "brandName",
      "schema": {
        "title": "Company",
        "type": "object",
        "properties": {
          "brandName": { "type": "string", "title": "Brand Name" },
          "legalName": { "type": "string", "title": "Legal Name (RU)" },
          "legalNameEn": { "type": "string", "title": "Legal Name (EN)" },
          "legalNameUz": { "type": "string", "title": "Legal Name (UZ)" },
          "foundingYear": { "type": "string", "title": "Founding Year" },
          "businessHours": { "type": "string", "title": "Business Hours" }
        }
      }
    },
    {
      "id": "social",
      "title": "Social Media Links",
      "file": "[[workspace]]/data/social.yaml",
      "fileType": "yaml",
      "labelField": "telegram",
      "schema": {
        "title": "Social",
        "type": "object",
        "properties": {
          "telegram": { "type": "string", "title": "Telegram URL" },
          "facebook": { "type": "string", "title": "Facebook URL" },
          "instagram": { "type": "string", "title": "Instagram URL" },
          "linkedin": { "type": "string", "title": "LinkedIn URL" }
        }
      }
    },
    {
      "id": "stats",
      "title": "Homepage Stats",
      "file": "[[workspace]]/data/stats.yaml",
      "fileType": "yaml",
      "labelField": "years",
      "schema": {
        "title": "Stats",
        "type": "object",
        "properties": {
          "years": { "type": "string", "title": "Years on Market" },
          "partners": { "type": "string", "title": "Number of Partners" },
          "skus": { "type": "string", "title": "SKUs in Catalog" },
          "countries": { "type": "string", "title": "Countries" }
        }
      }
    }
  ]
}
