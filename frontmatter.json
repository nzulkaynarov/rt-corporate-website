{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",

  "frontMatter.framework.id": "hugo",
  "frontMatter.framework.startCommand": "hugo server -D --navigateToChanged",
  "frontMatter.preview.host": "http://localhost:1313",
  "frontMatter.preview.trailingSlash": true,

  "frontMatter.website.host": "http://localhost:1313",
  "frontMatter.website.baseUrl": "https://railtech.uz",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.content.defaultFileType": "md",
  "frontMatter.content.autoUpdateDate": true,
  "frontMatter.content.fmHighlight": true,
  "frontMatter.content.wysiwyg": true,

  "frontMatter.global.timezone": "Asia/Tashkent",

  "frontMatter.taxonomy.frontMatterType": "YAML",
  "frontMatter.taxonomy.seoTitleLength": 60,
  "frontMatter.taxonomy.seoDescriptionLength": 160,
  "frontMatter.taxonomy.seoSlugLength": 75,
  "frontMatter.taxonomy.seoContentLengh": 1760,
  "frontMatter.taxonomy.alignFilename": true,
  "frontMatter.taxonomy.tags": [
    "Безопасность", "Железная дорога", "Аналитика", "Платформа", "B2B", "Импорт", "Таможня", "Руководство", "Диагностика", "Мониторинг", "Инфраструктура", "САУТ", "Автоматизация", "Новости",
    "Safety", "Railway", "Analytics", "Platform", "Import", "Customs", "Guide", "Diagnostics", "Monitoring", "Infrastructure", "SAUT", "Automation", "News",
    "Xavfsizlik", "Signalizatsiya", "Texnologiyalar", "B2B platforma", "Raqamlashtirish", "Bojxona", "Logistika", "Sanoat tahlili"
  ],
  "frontMatter.taxonomy.categories": [
    "Аналитика", "Новости компании", "Руководства",
    "Analytics", "Company News", "Guides",
    "Tahlil", "Kompaniya yangiliklari", "Amaliy qo'llanma"
  ],

  "frontMatter.taxonomy.customTaxonomy": [
    {
      "id": "articleType",
      "options": ["Article", "News", "Tutorial", "Case Study", "Opinion"]
    },
    {
      "id": "difficulty",
      "options": ["Beginner", "Intermediate", "Advanced"]
    },
    {
      "id": "projectStatus",
      "options": ["Completed", "In Progress", "Planning"]
    }
  ],

  "frontMatter.git.enabled": true,
  "frontMatter.git.commitMessage": "content: {{date}} — {{title}}",

  "frontMatter.dashboard.openOnStart": true,
  "frontMatter.dashboard.content.cardTags": "tags",
  "frontMatter.dashboard.content.card.fields.date": true,
  "frontMatter.dashboard.content.card.fields.state": true,
  "frontMatter.dashboard.content.card.fields.description": "description",
  "frontMatter.dashboard.content.pagination": 16,

  "frontMatter.content.i18n": [
    { "title": "Russian", "locale": "ru", "path": "[[workspace]]/content/ru" },
    { "title": "English", "locale": "en", "path": "[[workspace]]/content/en" },
    { "title": "Uzbek", "locale": "uz", "path": "[[workspace]]/content/uz" }
  ],

  "frontMatter.content.sorting": [
    { "id": "date-desc", "title": "Date (newest)", "name": "date", "order": "desc", "type": "date" },
    { "id": "date-asc", "title": "Date (oldest)", "name": "date", "order": "asc", "type": "date" },
    { "id": "title-asc", "title": "Title (A-Z)", "name": "title", "order": "asc", "type": "string" },
    { "id": "weight-asc", "title": "Weight (order)", "name": "weight", "order": "asc", "type": "number" }
  ],
  "frontMatter.content.defaultSorting": "date-desc",

  "frontMatter.content.filters": ["contentFolders", "tags", "categories"],

  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "blog",
      "pageBundle": true,
      "fields": [
        {
          "title": "Title",
          "name": "title",
          "type": "string",
          "required": true,
          "description": "Article title — appears in browser tab and search results (max 60 chars recommended)"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string",
          "required": true,
          "description": "Meta description for search engines — max 160 chars. Shown in Google snippet"
        },
        {
          "title": "Date Published",
          "name": "date",
          "type": "datetime",
          "required": true,
          "description": "Publication date (ISO format)"
        },
        {
          "title": "Date Updated",
          "name": "lastmod",
          "type": "datetime",
          "description": "Last modification date (auto-updated on save)"
        },
        {
          "title": "Author",
          "name": "author",
          "type": "string",
          "default": "RailTech"
        },
        {
          "title": "Featured Image",
          "name": "featureimage",
          "type": "image",
          "description": "Place featured.jpg in the article folder. Blowfish auto-detects it for hero and cards"
        },
        {
          "title": "OG Image",
          "name": "ogImage",
          "type": "image",
          "description": "Custom image for social media sharing (1200x630px). Falls back to featured image"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags",
          "description": "Content tags for filtering and related posts"
        },
        {
          "title": "Categories",
          "name": "categories",
          "type": "categories",
          "description": "Content categories (Analytics, Company News, Guides)"
        },
        {
          "title": "Article Type",
          "name": "articleType",
          "type": "choice",
          "choices": ["Article", "News", "Tutorial", "Case Study", "Opinion"],
          "default": "Article"
        },
        {
          "title": "Show Hero Image",
          "name": "showHero",
          "type": "boolean",
          "default": true,
          "description": "Blowfish: show hero section at top of article"
        },
        {
          "title": "Hero Style",
          "name": "heroStyle",
          "type": "choice",
          "choices": ["basic", "big", "background", "thumbAndBackground"],
          "default": "background",
          "description": "basic = small bar, big = large centered, background = fullscreen fixed, thumbAndBackground = thumbnail + background"
        },
        {
          "title": "Show Table of Contents",
          "name": "showTableOfContents",
          "type": "boolean",
          "default": true,
          "description": "Auto-generated TOC from headings"
        },
        {
          "title": "Show Related Posts",
          "name": "showRelatedContent",
          "type": "boolean",
          "default": true,
          "description": "Show related articles at bottom"
        },
        {
          "title": "Show Date",
          "name": "showDate",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Show Author",
          "name": "showAuthor",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Show Breadcrumbs",
          "name": "showBreadcrumbs",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft",
          "description": "Draft articles are hidden from production build. Visible only with hugo server -D"
        }
      ]
    },

    {
      "name": "project",
      "pageBundle": true,
      "fields": [
        {
          "title": "Project Title",
          "name": "title",
          "type": "string",
          "required": true,
          "description": "Project name (max 60 chars for SEO)"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string",
          "required": true,
          "description": "Project overview — meta description for search engines (max 160 chars)"
        },
        {
          "title": "Featured Image",
          "name": "featureimage",
          "type": "image",
          "description": "Place featured.jpg in the project folder for hero and card views"
        },
        {
          "title": "Client",
          "name": "client",
          "type": "string",
          "description": "Client or partner name"
        },
        {
          "title": "Project Year",
          "name": "year",
          "type": "string",
          "description": "Year completed (YYYY)"
        },
        {
          "title": "Project Scope",
          "name": "scope",
          "type": "string",
          "description": "Brief scope — equipment supplied, services provided"
        },
        {
          "title": "Project Status",
          "name": "projectStatus",
          "type": "choice",
          "choices": ["Completed", "In Progress", "Planning"],
          "default": "Completed"
        },
        {
          "title": "Display Order",
          "name": "weight",
          "type": "number",
          "description": "Lower number = higher in lists"
        },
        {
          "title": "Tags",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "Show Hero",
          "name": "showHero",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Hero Style",
          "name": "heroStyle",
          "type": "choice",
          "choices": ["basic", "big", "background", "thumbAndBackground"],
          "default": "background"
        },
        {
          "title": "Show Breadcrumbs",
          "name": "showBreadcrumbs",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft"
        }
      ]
    },

    {
      "name": "service",
      "pageBundle": true,
      "fields": [
        {
          "title": "Service Name",
          "name": "title",
          "type": "string",
          "required": true,
          "description": "Service name (max 60 chars for SEO)"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string",
          "required": true,
          "description": "Meta description — max 160 chars"
        },
        {
          "title": "Service Icon",
          "name": "icon",
          "type": "image",
          "description": "SVG icon for card view (place in static/img/icons/)"
        },
        {
          "title": "Featured Image",
          "name": "featureimage",
          "type": "image",
          "description": "Place featured.jpg in the service folder for hero"
        },
        {
          "title": "Key Features",
          "name": "features",
          "type": "list",
          "description": "Bullet-point features displayed on service page"
        },
        {
          "title": "Display Order",
          "name": "weight",
          "type": "number",
          "description": "Lower = first in lists"
        },
        {
          "title": "Show Hero",
          "name": "showHero",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Hero Style",
          "name": "heroStyle",
          "type": "choice",
          "choices": ["basic", "big", "background", "thumbAndBackground"],
          "default": "background"
        },
        {
          "title": "Show Breadcrumbs",
          "name": "showBreadcrumbs",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Show Table of Contents",
          "name": "showTableOfContents",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft"
        }
      ]
    },

    {
      "name": "platform",
      "pageBundle": true,
      "fields": [
        {
          "title": "Feature Name",
          "name": "title",
          "type": "string",
          "required": true,
          "description": "Platform feature name (max 60 chars)"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string",
          "required": true,
          "description": "Feature description — meta description (max 160 chars)"
        },
        {
          "title": "Feature Image",
          "name": "featureimage",
          "type": "image",
          "description": "Screenshot or feature image — place featured.jpg in feature folder"
        },
        {
          "title": "Key Highlights",
          "name": "highlights",
          "type": "list",
          "description": "Main feature highlights"
        },
        {
          "title": "Display Order",
          "name": "weight",
          "type": "number"
        },
        {
          "title": "Show Hero",
          "name": "showHero",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Hero Style",
          "name": "heroStyle",
          "type": "choice",
          "choices": ["basic", "big", "background", "thumbAndBackground"],
          "default": "background"
        },
        {
          "title": "Show Breadcrumbs",
          "name": "showBreadcrumbs",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft"
        }
      ]
    },

    {
      "name": "page",
      "pageBundle": false,
      "fields": [
        {
          "title": "Page Title",
          "name": "title",
          "type": "string",
          "required": true,
          "description": "Page title (max 60 chars for SEO)"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string",
          "required": true,
          "description": "Meta description (max 160 chars)"
        },
        {
          "title": "Featured Image",
          "name": "featureimage",
          "type": "image",
          "description": "Page header image"
        },
        {
          "title": "Show Hero",
          "name": "showHero",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Hero Style",
          "name": "heroStyle",
          "type": "choice",
          "choices": ["basic", "big", "background", "thumbAndBackground"],
          "default": "background"
        },
        {
          "title": "Show Breadcrumbs",
          "name": "showBreadcrumbs",
          "type": "boolean",
          "default": true
        },
        {
          "title": "Draft",
          "name": "draft",
          "type": "draft"
        }
      ]
    },

    {
      "name": "homepage",
      "pageBundle": false,
      "fields": [
        {
          "title": "Page Title",
          "name": "title",
          "type": "string",
          "required": true,
          "description": "Homepage title — appears in browser tab and SEO (max 60 chars)"
        },
        {
          "title": "Description",
          "name": "description",
          "type": "string",
          "required": true,
          "description": "Meta description for homepage — max 160 chars"
        }
      ]
    }
  ],

  "frontMatter.content.pageFolders": [
    {
      "title": "Blog (RU)",
      "path": "[[workspace]]/content/ru/blog",
      "contentTypes": ["blog"],
      "previewPath": "'blog'"
    },
    {
      "title": "Blog (EN)",
      "path": "[[workspace]]/content/en/blog",
      "contentTypes": ["blog"],
      "previewPath": "'en/blog'"
    },
    {
      "title": "Blog (UZ)",
      "path": "[[workspace]]/content/uz/blog",
      "contentTypes": ["blog"],
      "previewPath": "'uz/blog'"
    },
    {
      "title": "Projects (RU)",
      "path": "[[workspace]]/content/ru/projects",
      "contentTypes": ["project"],
      "previewPath": "'projects'"
    },
    {
      "title": "Projects (EN)",
      "path": "[[workspace]]/content/en/projects",
      "contentTypes": ["project"],
      "previewPath": "'en/projects'"
    },
    {
      "title": "Projects (UZ)",
      "path": "[[workspace]]/content/uz/projects",
      "contentTypes": ["project"],
      "previewPath": "'uz/projects'"
    },
    {
      "title": "Services (RU)",
      "path": "[[workspace]]/content/ru/services",
      "contentTypes": ["service"],
      "previewPath": "'services'"
    },
    {
      "title": "Services (EN)",
      "path": "[[workspace]]/content/en/services",
      "contentTypes": ["service"],
      "previewPath": "'en/services'"
    },
    {
      "title": "Services (UZ)",
      "path": "[[workspace]]/content/uz/services",
      "contentTypes": ["service"],
      "previewPath": "'uz/services'"
    },
    {
      "title": "Platform (RU)",
      "path": "[[workspace]]/content/ru/platform",
      "contentTypes": ["platform"],
      "previewPath": "'platform'"
    },
    {
      "title": "Platform (EN)",
      "path": "[[workspace]]/content/en/platform",
      "contentTypes": ["platform"],
      "previewPath": "'en/platform'"
    },
    {
      "title": "Platform (UZ)",
      "path": "[[workspace]]/content/uz/platform",
      "contentTypes": ["platform"],
      "previewPath": "'uz/platform'"
    },
    {
      "title": "Homepage (RU)",
      "path": "[[workspace]]/content/ru",
      "contentTypes": ["homepage"],
      "filePrefix": "_index",
      "excludeSubdir": true
    },
    {
      "title": "Homepage (EN)",
      "path": "[[workspace]]/content/en",
      "contentTypes": ["homepage"],
      "filePrefix": "_index",
      "excludeSubdir": true
    },
    {
      "title": "Homepage (UZ)",
      "path": "[[workspace]]/content/uz",
      "contentTypes": ["homepage"],
      "filePrefix": "_index",
      "excludeSubdir": true
    },
    {
      "title": "Pages (RU)",
      "path": "[[workspace]]/content/ru",
      "contentTypes": ["page"],
