---
/** First screen: eyebrow, H1 (the bridge), lead and two audience entries. The orbit graphic is decorative and hidden on phones. */
import { localeHref, tField } from '../../i18n';
import home from '../../data/cms/home.json';
import { withBase } from '../../utils/url';

const lang = Astro.locals.lang;
const h = home.hero as Record<string, any>;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__in">
    <div class="hero__txt">
      <p class="eyebrow">{tField(h, 'eyebrow', lang)}</p>
      <h1 id="hero-title">{tField(h, 'title', lang)}</h1>
      <p class="hero__lead">{tField(h, 'lead', lang)}</p>
      <ul class="entries">
        {(h.entries || []).map((e: any) => (
          <li>
            <a class="entry" href={localeHref(e.link, lang)}>
              <b>
                {tField(e, 'title', lang)}
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 9h12M10 4l5 5-5 5"></path></svg>
              </b>
              <span>{tField(e, 'text', lang)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="orbit" aria-hidden="true">
      <div class="orbit__disc"></div>
      <div class="orbit__core"><img src={withBase('/brand/rt-mark.svg')} alt="" width="104" height="104" /></div>
      <div class="orbit__dot"></div>
      <div class="orbit__dot orbit__dot--ink"></div>
    </div>
  </div>
  <div class="dots" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero__in {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 48px;
    align-items: center;
    padding-block: 72px 80px;
  }
  .hero__txt {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    font-size: 58px;
    font-weight: 800;
  }
  .hero__lead {
    font-size: 19px;
    color: var(--c-muted);
    max-width: 600px;
  }
  .entries {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 22px 24px;
    border: 1px solid var(--c-line);
    border-top: 3px solid var(--c-accent);
    border-radius: var(--r-sm);
    text-decoration: none;
    color: var(--c-ink);
    background: var(--c-bg);
  }
  .entry:hover {
    border-color: var(--c-brand-mid);
    border-top-color: var(--c-accent);
    box-shadow: var(--shadow-lift);
    color: var(--c-ink);
  }
  .entry b {
    font: 700 19px/1.2 var(--f-display);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .entry svg {
    color: var(--c-brand-ink);
    flex: none;
  }
  .entry span {
    font-size: 15px;
    color: var(--c-muted);
    line-height: 1.5;
  }
  .orbit {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 1 / 1;
    margin-left: auto;
    border-radius: 50%;
    border: 1px solid var(--c-line);
    display: grid;
    place-items: center;
  }
  .orbit__disc {
    position: absolute;
    inset: 9%;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, var(--c-brand-mid) 0%, var(--c-brand-soft) 85%);
  }
  .orbit__core {
    position: relative;
    width: 40%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--c-bg);
    display: grid;
    place-items: center;
    box-shadow: 0 18px 40px -18px rgba(45, 62, 80, 0.45);
  }
  .orbit__core img {
    width: 52%;
    height: 52%;
  }
  .orbit__dot {
    position: absolute;
    width: 5%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--c-accent);
    right: 13%;
    top: 13%;
  }
  .orbit__dot--ink {
    width: 2.8%;
    background: var(--c-ink);
    right: auto;
    top: auto;
    left: 2.5%;
    bottom: 30%;
  }
  .dots {
    position: absolute;
    right: 40px;
    bottom: 28px;
    width: 140px;
    height: 84px;
    background-image: radial-gradient(var(--c-accent) 1.6px, transparent 1.8px);
    background-size: 20px 20px;
    opacity: 0.5;
  }
  @media (max-width: 1080px) {
    h1 {
      font-size: 46px;
    }
    .hero__in {
      grid-template-columns: minmax(0, 1fr);
    }
    .orbit {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .hero__in {
      padding-block: 36px 44px;
      gap: 0;
    }
    .hero__txt {
      gap: 16px;
    }
    h1 {
      font-size: 32px;
    }
    .hero__lead {
      font-size: 16px;
    }
    .entries {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-top: 4px;
    }
    .entry {
      padding: 14px;
    }
    .entry b {
      font-size: 16px;
    }
    .entry span,
    .dots {
      display: none;
    }
  }
</style>
