---
/**
 * «Мост»: what the customer and the partner lose at each stage and what RailTech takes over.
 * Desktop: three columns, the RailTech column in the middle. Phone: only the RailTech column;
 * both sides' losses fold into «Что теряет каждая сторона» (<details>).
 */
import { tField } from '../../i18n';
import { t } from '../../i18n/ui';
import home from '../../data/cms/home.json';
import SectionHead from '../ui/SectionHead.astro';

const lang = Astro.locals.lang;
const b = home.bridge as Record<string, any>;
const rows = (b.rows || []).map((r: Record<string, string>) => ({
  stage: tField(r, 'stage', lang),
  customer: tField(r, 'customer', lang),
  railtech: tField(r, 'railtech', lang),
  partner: tField(r, 'partner', lang),
}));
---

<section class="section section--soft" aria-labelledby="bridge-title">
  <div class="wrap">
    <SectionHead id="bridge-title" eyebrow={tField(b, 'eyebrow', lang)} title={tField(b, 'title', lang)} />

    <div class="bridge" role="table" aria-labelledby="bridge-title">
      <div class="bridge__row bridge__head" role="row">
        <div class="cell" role="columnheader">{tField(b, 'customerTitle', lang)}<small>{tField(b, 'customerNote', lang)}</small></div>
        <div class="cell cell--rt" role="columnheader">{tField(b, 'railtechTitle', lang)}<small>{tField(b, 'railtechNote', lang)}</small></div>
        <div class="cell" role="columnheader">{tField(b, 'partnerTitle', lang)}<small>{tField(b, 'partnerNote', lang)}</small></div>
      </div>
      {rows.map((r: any) => (
        <div class="bridge__row" role="row">
          <div class="cell" role="cell">{r.customer}</div>
          <div class="cell cell--rt" role="cell"><b>{r.stage}</b><span>{r.railtech}</span></div>
          <div class="cell" role="cell">{r.partner}</div>
        </div>
      ))}
    </div>

    <ol class="bridge-m">
      {rows.map((r: any) => (
        <li><b>{r.stage}</b><span>{r.railtech}</span></li>
      ))}
    </ol>
    <details class="bridge-more">
      <summary>{t(lang, 'home.bridge.more')}</summary>
      <dl>
        {rows.map((r: any) => (
          <div>
            <dt>{r.stage}</dt>
            <dd><b>{t(lang, 'home.bridge.customer')}:</b> {r.customer}</dd>
            <dd><b>{t(lang, 'home.bridge.partner')}:</b> {r.partner}</dd>
          </div>
        ))}
      </dl>
    </details>
  </div>
</section>

<style>
  .bridge {
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--c-bg);
  }
  .bridge__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr);
  }
  .cell {
    padding: 20px 24px;
    border-bottom: 1px solid var(--c-line);
    color: var(--c-muted);
    font-size: 16px;
  }
  .bridge__row:last-child .cell {
    border-bottom: 0;
  }
  .bridge__head .cell {
    font: 700 15px/1.3 var(--f-display);
    color: var(--c-ink);
  }
  .bridge__head small {
    display: block;
    margin-top: 4px;
    font: 500 13px/1.4 var(--f-body);
    color: var(--c-muted);
  }
  .cell--rt {
    background: var(--c-ink);
    color: var(--c-on-ink-soft);
    border-bottom-color: var(--c-ink-line);
  }
  .bridge__head .cell--rt {
    color: var(--c-on-ink);
  }
  .bridge__head .cell--rt small {
    color: var(--c-on-ink-muted);
  }
  .cell--rt b {
    display: block;
    font: 700 16px/1.3 var(--f-display);
    color: var(--c-on-ink);
    margin-bottom: 6px;
  }
  .bridge-m,
  .bridge-more {
    display: none;
  }
  @media (max-width: 760px) {
    .bridge {
      display: none;
    }
    .bridge-m {
      display: grid;
      list-style: none;
      margin: 0;
      padding: 0;
      gap: 0;
      background: var(--c-ink);
      border-radius: var(--r-md);
      overflow: hidden;
    }
    .bridge-m li {
      padding: 14px 16px;
      border-bottom: 1px solid var(--c-ink-line);
      color: var(--c-on-ink-soft);
      font-size: 15px;
    }
    .bridge-m li:last-child {
      border-bottom: 0;
    }
    .bridge-m b {
      display: block;
      font: 700 15px/1.3 var(--f-display);
      color: var(--c-on-ink);
      margin-bottom: 2px;
    }
    .bridge-more {
      display: block;
      margin-top: 12px;
    }
    .bridge-more summary {
      cursor: pointer;
      min-height: 44px;
      display: flex;
      align-items: center;
      font-weight: 600;
      color: var(--c-brand-ink);
    }
    .bridge-more dl {
      margin: 0;
      display: grid;
      gap: 12px;
      font-size: 15px;
    }
    .bridge-more dt {
      font-weight: 700;
    }
    .bridge-more dd {
      margin: 2px 0 0;
      color: var(--c-muted);
    }
    .bridge-more dd b {
      color: var(--c-ink);
      font-weight: 600;
    }
  }
</style>
