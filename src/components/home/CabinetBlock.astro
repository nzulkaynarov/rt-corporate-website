---
/** «Кабинет RailTech»: text, three facts, buttons and a drawn example of a deal (hidden on phones). */
import { localeHref, pick, tField } from '../../i18n';
import { t } from '../../i18n/ui';
import home from '../../data/cms/home.json';
import { company } from '../../utils/company';
import { START_PATH } from '../../utils/nav';

const lang = Astro.locals.lang;
const c = home.cabinet as Record<string, any>;
const demo = c.demo as Record<string, any>;
const stages: string[] = pick(lang, demo.stages || [], demo.stages_uz, demo.stages_en);
---

<section class="section section--ink" aria-labelledby="cab-title">
  <div class="wrap cab">
    <div class="cab__txt">
      <p class="eyebrow cab__eyebrow">{tField(c, 'eyebrow', lang)}</p>
      <h2 id="cab-title">{tField(c, 'title', lang)}</h2>
      <p class="cab__lead">{tField(c, 'text', lang)}</p>
      <dl class="facts">
        {(c.facts || []).map((f: any) => (
          <div><dt>{tField(f, 'label', lang)}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
      <div class="btn-row">
        <a class="btn btn--light" href={localeHref(START_PATH, lang)}>{t(lang, 'cta.start')}</a>
        <a class="btn btn--outline-light" href={company.cabinet.loginUrl}>{t(lang, 'cta.cabinet')}</a>
      </div>
    </div>
    <figure class="ui" aria-label={t(lang, 'home.cabinet.demoAria')}>
      <div class="ui__top"><b>{tField(demo, 'title', lang)}</b><span>{tField(demo, 'note', lang)}</span></div>
      <ol class="ui__steps">
        {stages.map((s, i) => (
          <li class:list={{ done: i < demo.current, now: i === demo.current }} aria-current={i === demo.current ? 'step' : undefined}>{s}</li>
        ))}
      </ol>
      {(demo.rows || []).map((r: any) => (
        <div class="ui__row"><span>{tField(r, 'label', lang)}</span><span class:list={['tag', `tag--${r.tone}`]}>{tField(r, 'status', lang)}</span></div>
      ))}
      <figcaption>{tField(demo, 'footnote', lang)}</figcaption>
    </figure>
  </div>
</section>

<style>
  .cab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }
  .cab__txt {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .cab__eyebrow {
    color: var(--c-brand-mid);
  }
  h2 {
    font-size: 40px;
    font-weight: 700;
    color: var(--c-on-ink);
  }
  .cab__lead {
    color: var(--c-on-ink-soft);
  }
  .facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    padding-block: 8px;
  }
  .facts div {
    border-top: 2px solid var(--c-accent);
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 4px;
  }
  .facts dd {
    order: -1;
  }
  .facts dd {
    margin: 0;
    font: 800 28px/1 var(--f-display);
    color: var(--c-on-ink);
  }
  .facts dt {
    font-size: 14px;
    color: var(--c-on-ink-muted);
    line-height: 1.4;
  }
  .ui {
    margin: 0;
    background: var(--c-bg);
    color: var(--c-ink);
    border-radius: var(--r-lg);
    padding: 24px;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ui__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--c-muted);
  }
  .ui__top b {
    font: 700 18px/1.2 var(--f-display);
    color: var(--c-ink);
  }
  .ui__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
  }
  .ui__steps li {
    padding: 10px 6px;
    border-radius: var(--r-sm);
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    background: var(--c-soft);
    color: var(--c-muted);
    line-height: 1.25;
  }
  .ui__steps li.done {
    background: var(--c-brand-soft);
    color: var(--c-brand-ink-hover);
  }
  .ui__steps li.now {
    background: var(--c-accent-soft);
    color: var(--c-accent-ink);
  }
  .ui__row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--c-line);
    border-radius: var(--r-sm);
    font-size: 14px;
  }
  .tag {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: var(--r-pill);
    background: var(--c-soft);
    white-space: nowrap;
  }
  .tag--ok {
    background: var(--c-ok-soft);
    color: var(--c-ok-ink);
  }
  .tag--wait {
    background: var(--c-accent-soft);
    color: var(--c-accent-ink);
  }
  figcaption {
    font-size: 12px;
    color: var(--c-muted);
  }
  @media (max-width: 1080px) {
    .cab {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 760px) {
    h2 {
      font-size: 28px;
    }
    .cab__txt {
      gap: 14px;
    }
    .facts {
      gap: 10px;
    }
    .facts dd {
      font-size: 20px;
    }
    .facts dt {
      font-size: 12px;
    }
    .ui {
      display: none;
    }
    .btn-row .btn {
      flex: 1;
    }
  }
</style>
