---
import globalData from '../data/cms/global.json';

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  {
    href: `${base}/catalog/`,
    label_ru: 'КАТАЛОГ',
    label_uz: 'KATALOG',
    label_en: 'CATALOG',
    index: '01',
    match: (p: string) => p.startsWith(`${base}/catalog`),
  },
  {
    href: `${base}/services/`,
    label_ru: 'УСЛУГИ',
    label_uz: 'XIZMATLAR',
    label_en: 'SERVICES',
    index: '02',
    match: (p: string) => p.startsWith(`${base}/services`),
  },
  {
    href: `${base}/projects/`,
    label_ru: 'ПРОЕКТЫ',
    label_uz: 'LOYIHALAR',
    label_en: 'PROJECTS',
    index: '03',
    match: (p: string) => p.startsWith(`${base}/projects`),
  },
  {
    href: `${base}/blog/`,
    label_ru: 'БЛОГ',
    label_uz: 'BLOG',
    label_en: 'BLOG',
    index: '04',
    match: (p: string) => p.startsWith(`${base}/blog`),
  },
  {
    href: `${base}/about`,
    label_ru: 'О КОМПАНИИ',
    label_uz: 'KOMPANIYA HAQIDA',
    label_en: 'ABOUT US',
    index: '05',
    match: (p: string) => p.startsWith(`${base}/about`),
  },
  {
    href: `${base}/contacts`,
    label_ru: 'КОНТАКТЫ',
    label_uz: 'ALOQA',
    label_en: 'CONTACTS',
    index: '06',
    match: (p: string) => p.startsWith(`${base}/contacts`),
  },
];
---

<header class="border-b border-[#0A0A0A] bg-[#D4D8DC] sticky top-0 z-40 select-none">
  <!-- 1. Top Status Bar: Responsive (Compact on < 768px, Full Telemetry on >= 768px) -->
  <div class="px-4 py-1.5 border-b border-[#0A0A0A]/20 font-mono text-[11px] tracking-wider text-[#4A5056] bg-[#C8CDD2]/70">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <!-- Left: Mobile compact [ ● ONLINE ] + Company / Desktop Full Telemetry -->
      <div class="flex items-center space-x-2 sm:space-x-3 truncate">
        <span class="inline-flex items-center gap-1.5 font-bold text-[#0A0A0A] flex-none">
          <span class="w-2 h-2 bg-emerald-600 inline-block animate-pulse"></span>
          <span>[ ● ONLINE ]</span>
        </span>
        <span class="text-[#0A0A0A]/30">|</span>
        <span class="truncate font-bold text-[#0A0A0A]">
          {globalData.companyName}
        </span>
        <!-- Extra telemetry visible only on desktop -->
        <span class="hidden md:inline text-[#0A0A0A]/30">|</span>
        <span class="hidden md:inline">
          ИНН: {globalData.inn}
        </span>
        <span class="hidden lg:inline text-[#0A0A0A]/30">|</span>
        <span class="hidden lg:inline border border-[#0A0A0A] px-1.5 bg-[#D4D8DC] text-[#0A0A0A] font-semibold text-[10px]">
          НДС 12% ВКЛЮЧЕН
        </span>
      </div>

      <!-- Right: Phone & B2B Portal on desktop (hidden on mobile < 768px) -->
      <div class="hidden md:flex items-center space-x-3 flex-none text-[11px]">
        <a
          href={`tel:${globalData.phone.replace(/[\s-]/g, '')}`}
          class="hover:text-[#0A0A0A] transition-colors font-bold text-[#0A0A0A] flex items-center space-x-1"
        >
          <span>ТЕЛ:</span>
          <span>{globalData.phone}</span>
        </a>
        {globalData.b2bPortalUrl && (
          <a
            href={globalData.b2bPortalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-block border border-[#0A0A0A] px-2 py-0.5 bg-[#0A0A0A] text-white hover:bg-transparent hover:text-[#0A0A0A] transition-colors font-bold text-[10px]"
          >
            PORTAL ↗
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- 2. Main Navigation Row -->
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 py-2.5">
    <!-- Brand / Logo (Always takes user to home /) -->
    <a href={`${base}/`} class="flex items-center space-x-3 group flex-none" aria-label="RailTech Главная">
      <div class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-2.5 py-1.5 font-mono font-bold tracking-widest text-sm group-hover:bg-transparent group-hover:text-[#0A0A0A] transition-colors">
        RAILTECH
      </div>
      <div class="flex flex-col">
        <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-[#4A5056] leading-none">
          ENGINEERING & LOGISTICS
        </span>
        <span class="text-xs font-bold text-[#0A0A0A] leading-tight">
          <span class="rt-lang rt-lang-ru">УЗБЕКИСТАН • B2B / B2G</span>
          <span class="rt-lang rt-lang-uz">O'ZBEKISTON • B2B / B2G</span>
          <span class="rt-lang rt-lang-en">UZBEKISTAN • B2B / B2G</span>
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links (Visible on >= 1024px) -->
    <nav class="hidden lg:flex items-center space-x-1 font-mono text-[11px] font-semibold tracking-wider">
      {navItems.map((item) => {
        const isActive = item.match(pathname);
        return (
          <a
            href={item.href}
            class={`px-2.5 py-1.5 border transition-colors ${
              isActive
                ? 'bg-[#0A0A0A] text-white border-[#0A0A0A]'
                : 'border-transparent text-[#0A0A0A] hover:border-[#0A0A0A] hover:bg-[#0A0A0A]/5'
            }`}
          >
            <span class="text-[#4A5056] group-hover:text-white mr-1 text-[9px]">{item.index}.</span>
            <span class="rt-lang rt-lang-ru">{item.label_ru}</span>
            <span class="rt-lang rt-lang-uz">{item.label_uz}</span>
            <span class="rt-lang rt-lang-en">{item.label_en}</span>
          </a>
        );
      })}
    </nav>

    <!-- Right Controls: Language Switcher + RFQ Button + Mobile Menu Trigger -->
    <div class="flex items-center space-x-2">
      <!-- Brutalist Language Switcher [ RU | UZ | EN ] -->
      <div
        class="rt-lang-switcher border border-[#0A0A0A] bg-[#C8CDD2] p-0.5 inline-flex items-center font-mono text-[11px] font-bold"
        role="group"
        aria-label="Language selector"
      >
        <button
          type="button"
          data-lang-btn="ru"
          class="px-2 py-1 min-h-[32px] sm:min-h-0 transition-colors cursor-pointer text-[#0A0A0A] hover:bg-[#0A0A0A]/10"
          aria-label="Русский язык"
        >
          RU
        </button>
        <span class="text-[#0A0A0A]/30">|</span>
        <button
          type="button"
          data-lang-btn="uz"
          class="px-2 py-1 min-h-[32px] sm:min-h-0 transition-colors cursor-pointer text-[#0A0A0A] hover:bg-[#0A0A0A]/10"
          aria-label="O'zbek tili"
        >
          UZ
        </button>
        <span class="text-[#0A0A0A]/30">|</span>
        <button
          type="button"
          data-lang-btn="en"
          class="px-2 py-1 min-h-[32px] sm:min-h-0 transition-colors cursor-pointer text-[#0A0A0A] hover:bg-[#0A0A0A]/10"
          aria-label="English language"
        >
          EN
        </button>
      </div>

      <!-- Quick Lead Request Button (hidden on narrow screens to protect spacing) -->
      <button
        type="button"
        data-lead-modal
        data-lead-subject="Запрос коммерческого предложения / спецификации с сайта"
        class="hidden sm:inline-block border border-[#0A0A0A] bg-[#0A0A0A] text-white font-mono text-[11px] font-bold px-3 py-1.5 tracking-wider hover:bg-transparent hover:text-[#0A0A0A] transition-colors cursor-pointer whitespace-nowrap"
      >
        <span class="rt-lang rt-lang-ru">[ ЗАПРОС КП ↗ ]</span>
        <span class="rt-lang rt-lang-uz">[ SO'ROV ↗ ]</span>
        <span class="rt-lang rt-lang-en">[ RFQ ↗ ]</span>
      </button>

      <!-- Tactical Mobile Menu Trigger (Zone >= 44x44px for touch) -->
      <button
        id="mobile-nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Открыть мобильное меню"
        class="lg:hidden min-w-[44px] min-h-[44px] p-2 border border-[#0A0A0A] bg-white/40 hover:bg-[#0A0A0A] hover:text-white transition-colors cursor-pointer flex items-center justify-center font-mono text-xs font-bold gap-1"
      >
        <span>МЕНЮ</span>
        <span class="text-sm">≡</span>
      </button>
    </div>
  </div>

  <!-- 3. Fullscreen Matte Mobile HUD Menu (< 1024px) -->
  <div
    id="mobile-menu"
    class="fixed inset-x-0 top-[60px] w-full max-w-[100vw] h-[calc(100dvh-60px)] z-[100] overflow-y-auto overflow-x-hidden bg-[#D4D8DC]/95 backdrop-blur-xl p-5 flex-col justify-between hidden"
    style="overscroll-behavior: contain;"
    role="dialog"
    aria-modal="true"
    aria-label="Навигация по сайту"
  >
    <div class="w-full max-w-xl mx-auto flex flex-col justify-between h-full">
      <div>
        <!-- Drawer Header -->
        <div class="flex items-center justify-between pb-4 border-b border-[#0A0A0A]/20 mb-6">
          <div class="flex items-center space-x-2 font-mono text-xs font-bold text-[#0A0A0A]">
            <span class="w-2.5 h-2.5 bg-[#0A0A0A] inline-block"></span>
            <span>СИСТЕМНОЕ МЕНЮ // HUD</span>
          </div>
          <button
            id="mobile-nav-close"
            type="button"
            aria-label="Закрыть меню"
            class="min-w-[44px] min-h-[44px] border border-[#0A0A0A] bg-white/40 hover:bg-[#0A0A0A] hover:text-white transition-colors cursor-pointer flex items-center justify-center font-mono text-xs font-bold px-3"
          >
            ✕ ЗАКРЫТЬ
          </button>
        </div>

        <!-- 6 Main Universal Sections -->
        <nav class="flex flex-col space-y-2 font-mono" aria-label="Мобильная навигация">
          {navItems.map((item) => {
            const isActive = item.match(pathname);
            return (
              <a
                href={item.href}
                class={`p-3.5 border transition-all flex items-center justify-between min-h-[48px] ${
                  isActive
                    ? 'bg-[#0A0A0A] text-white border-[#0A0A0A] font-bold'
                    : 'bg-white/40 border-[#0A0A0A]/30 text-[#0A0A0A] hover:bg-[#0A0A0A] hover:text-white'
                }`}
              >
                <span class="flex items-center gap-2 text-sm">
                  <span class="opacity-60">{item.index}.</span>
                  <span class="rt-lang rt-lang-ru">{item.label_ru}</span>
                  <span class="rt-lang rt-lang-uz">{item.label_uz}</span>
                  <span class="rt-lang rt-lang-en">{item.label_en}</span>
                </span>
                <span class="text-sm font-bold">→</span>
              </a>
            );
          })}
        </nav>

        <!-- Language Switcher in Drawer -->
        <div class="mt-6 pt-4 border-t border-[#0A0A0A]/20">
          <div class="font-mono text-[10px] text-[#4A5056] uppercase tracking-wider mb-2">
            ВЫБОР ЯЗЫКА / TIL / LANGUAGE:
          </div>
          <div class="grid grid-cols-3 gap-1 font-mono text-xs font-bold">
            <button
              type="button"
              data-lang-btn="ru"
              class="min-h-[44px] border border-[#0A0A0A] py-2 transition-colors cursor-pointer text-center"
            >
              RU
            </button>
            <button
              type="button"
              data-lang-btn="uz"
              class="min-h-[44px] border border-[#0A0A0A] py-2 transition-colors cursor-pointer text-center"
            >
              UZ
            </button>
            <button
              type="button"
              data-lang-btn="en"
              class="min-h-[44px] border border-[#0A0A0A] py-2 transition-colors cursor-pointer text-center"
            >
              EN
            </button>
          </div>
        </div>
      </div>

      <!-- Drawer Bottom: 1-Tap Quick Action Contacts & Lead Modal -->
      <div class="mt-8 pt-6 border-t-2 border-[#0A0A0A] flex flex-col space-y-3 font-mono text-xs">
        <button
          type="button"
          data-lead-modal
          data-lead-subject="Запрос консультации из мобильного меню"
          class="hud-btn w-full min-h-[48px] text-xs font-bold cursor-pointer"
        >
          <span>[ ОСТАВИТЬ ЗАЯВКУ ↗ ]</span>
        </button>

        <div class="grid grid-cols-2 gap-2">
          <a
            href={`tel:${globalData.phone.replace(/[\s-]/g, '')}`}
            class="min-h-[44px] border border-[#0A0A0A] bg-white/40 flex items-center justify-center gap-1.5 font-bold hover:bg-[#0A0A0A] hover:text-white transition-colors"
          >
            <span>📞</span>
            <span>ПОЗВОНИТЬ</span>
          </a>
          <a
            href="https://t.me/railtech_uz"
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[44px] border border-[#0A0A0A] bg-white/40 flex items-center justify-center gap-1.5 font-bold hover:bg-[#0A0A0A] hover:text-white transition-colors"
          >
            <span>💬</span>
            <span>TELEGRAM</span>
          </a>
        </div>

        <div class="text-[10px] text-[#4A5056] text-center pt-2">
          {globalData.address}
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    function getStoredLang() {
      try {
        var param = new URLSearchParams(window.location.search).get('lang');
        if (param === 'ru' || param === 'uz' || param === 'en') return param;
        var stored = localStorage.getItem('rt_lang');
        if (stored === 'ru' || stored === 'uz' || stored === 'en') return stored;
      } catch (e) {}
      return 'ru';
    }

    function syncSwitcherButtons(activeLang) {
      document.querySelectorAll('[data-lang-btn]').forEach(function(btn) {
        var lang = btn.getAttribute('data-lang-btn');
        if (lang === activeLang) {
          btn.className = btn.className.replace(/bg-[\w/]+|text-[\w/]+/g, '');
          btn.classList.add('bg-[#0A0A0A]', 'text-white', 'font-bold');
          btn.setAttribute('aria-current', 'true');
        } else {
          btn.className = btn.className.replace(/bg-[\w/]+|text-[\w/]+/g, '');
          btn.classList.add('text-[#0A0A0A]');
          btn.removeAttribute('aria-current');
        }
      });
    }

    function updateDataLangElements(lang) {
      document.querySelectorAll('[data-lang-ru]').forEach(function(el) {
        var val = el.getAttribute('data-lang-' + lang) || el.getAttribute('data-lang-ru');
        if (val) el.textContent = val;
      });

      document.querySelectorAll('[data-i18n-placeholder-ru]').forEach(function(el) {
        var val = el.getAttribute('data-i18n-placeholder-' + lang) || el.getAttribute('data-i18n-placeholder-ru');
        if (val) el.setAttribute('placeholder', val);
      });
    }

    function applyLanguage(lang) {
      document.documentElement.lang = lang;
      try {
        localStorage.setItem('rt_lang', lang);
      } catch (e) {}
      syncSwitcherButtons(lang);
      updateDataLangElements(lang);
      window.dispatchEvent(new CustomEvent('rt-lang-change', { detail: lang }));
    }

    // Initialize
    var currentLang = getStoredLang();
    applyLanguage(currentLang);

    // Event listeners for language buttons
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-lang-btn]');
      if (!btn) return;
      e.preventDefault();
      var targetLang = btn.getAttribute('data-lang-btn');
      if (targetLang && (targetLang === 'ru' || targetLang === 'uz' || targetLang === 'en')) {
        applyLanguage(targetLang);
      }
    });

    // Mobile menu drawer toggle
    var toggle = document.getElementById('mobile-nav-toggle');
    var closeBtn = document.getElementById('mobile-nav-close');
    var drawer = document.getElementById('mobile-menu');

    function openDrawer() {
      if (!drawer) return;
      drawer.classList.remove('hidden');
      drawer.classList.add('flex');
      document.body.style.overflow = 'hidden';
      if (toggle) toggle.setAttribute('aria-expanded', 'true');
    }

    function closeDrawer() {
      if (!drawer) return;
      drawer.classList.add('hidden');
      drawer.classList.remove('flex');
      document.body.style.overflow = '';
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
    }

    if (toggle) toggle.addEventListener('click', function() {
      if (drawer && drawer.classList.contains('hidden')) {
        openDrawer();
      } else {
        closeDrawer();
      }
    });
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);

    if (drawer) {
      drawer.querySelectorAll('a, button[data-lead-modal]').forEach(function(link) {
        link.addEventListener('click', function() {
          closeDrawer();
        });
      });
    }

    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && drawer && !drawer.classList.contains('hidden')) {
        closeDrawer();
      }
    });
  })();
</script>
