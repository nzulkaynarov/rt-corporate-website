---
import globalData from '../data/cms/global.json';

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  {
    href: `${base}/`,
    label_ru: 'ГЛАВНАЯ',
    label_uz: 'BOSH SAHIFA',
    label_en: 'HOME',
    id: 'home',
    match: (p: string) => p === `${base}/` || p === `${base}`
  },
  {
    href: `${base}/catalog/`,
    label_ru: 'КАТАЛОГ',
    label_uz: 'KATALOG',
    label_en: 'CATALOG',
    id: 'catalog',
    match: (p: string) => p.startsWith(`${base}/catalog`)
  },
  {
    href: `${base}/services/`,
    label_ru: 'УСЛУГИ',
    label_uz: 'XIZMATLAR',
    label_en: 'SERVICES',
    id: 'services',
    match: (p: string) => p.startsWith(`${base}/services`) || p.startsWith(`${base}/contract`) || p.startsWith(`${base}/digital`)
  },
  {
    href: `${base}/projects/`,
    label_ru: 'ПРОЕКТЫ',
    label_uz: 'LOYIHALAR',
    label_en: 'PROJECTS',
    id: 'projects',
    match: (p: string) => p.startsWith(`${base}/projects`)
  },
  {
    href: `${base}/blog/`,
    label_ru: 'БЛОГ',
    label_uz: 'BLOG',
    label_en: 'BLOG',
    id: 'blog',
    match: (p: string) => p.startsWith(`${base}/blog`)
  },
  {
    href: `${base}/about`,
    label_ru: 'О КОМПАНИИ',
    label_uz: 'KOMPANIYA HAQIDA',
    label_en: 'ABOUT US',
    id: 'about',
    match: (p: string) => p.startsWith(`${base}/about`)
  },
  {
    href: `${base}/contacts`,
    label_ru: 'КОНТАКТЫ',
    label_uz: 'ALOQA',
    label_en: 'CONTACTS',
    id: 'contacts',
    match: (p: string) => p.startsWith(`${base}/contacts`)
  },
];
---

<header class="border-b border-[#0A0A0A] bg-[#D4D8DC] sticky top-0 z-50 select-none">
  <!-- Top Operational Telemetry Bar -->
  <div class="hidden lg:flex items-center justify-between px-4 py-1.5 border-b border-[#0A0A0A]/20 font-mono text-[11px] tracking-wider text-[#4A5056] bg-[#C8CDD2]/60">
    <div class="flex items-center space-x-4">
      <div class="flex items-center space-x-1.5 text-[#0A0A0A]">
        <span class="w-2 h-2 bg-[#0A0A0A] inline-block animate-pulse"></span>
        <span class="font-bold">
          <span class="rt-lang rt-lang-ru">РЕСПУБЛИКА УЗБЕКИСТАН</span>
          <span class="rt-lang rt-lang-uz">O'ZBEKISTON RESPUBLIKASI</span>
          <span class="rt-lang rt-lang-en">REPUBLIC OF UZBEKISTAN</span>
        </span>
      </div>
      <span class="text-[#0A0A0A]/30">|</span>
      <span>{globalData.companyName} // ИНН: {globalData.inn}</span>
      <span class="text-[#0A0A0A]/30">|</span>
      <span>
        <span class="rt-lang rt-lang-ru">СКЛАД: {globalData.address.toUpperCase()}</span>
        <span class="rt-lang rt-lang-uz">OMBOR: {globalData.address.toUpperCase()}</span>
        <span class="rt-lang rt-lang-en">WAREHOUSE: {globalData.address.toUpperCase()}</span>
      </span>
      <span class="text-[#0A0A0A]/30">|</span>
      <span class="border border-[#0A0A0A] px-1 bg-[#D4D8DC] text-[#0A0A0A] font-semibold">
        <span class="rt-lang rt-lang-ru">НДС 12% ВКЛЮЧЕН</span>
        <span class="rt-lang rt-lang-uz">QQS 12% KIRITILGAN</span>
        <span class="rt-lang rt-lang-en">VAT 12% INCLUDED</span>
      </span>
    </div>

    <div class="flex items-center space-x-4">
      <a
        href={`tel:${globalData.phone.replace(/[\s-]/g, '')}`}
        class="hover:text-[#0A0A0A] transition-colors font-bold text-[#0A0A0A] flex items-center space-x-1"
      >
        <span>
          <span class="rt-lang rt-lang-ru">ТЕЛ:</span>
          <span class="rt-lang rt-lang-uz">TEL:</span>
          <span class="rt-lang rt-lang-en">TEL:</span>
        </span>
        <span>{globalData.phone}</span>
      </a>
      <span class="text-[#0A0A0A]/30">|</span>
      <a
        href={globalData.b2bPortalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="border border-[#0A0A0A] px-2 py-0.5 bg-[#0A0A0A] text-white hover:bg-transparent hover:text-[#0A0A0A] transition-colors"
      >
        B2B.RAILTECH.UZ ↗
      </a>
    </div>
  </div>

  <!-- Main Navigation Row -->
  <div class="flex items-center justify-between px-4 py-2">
    <!-- Brand / Logo -->
    <a href={`${base}/`} class="flex items-center space-x-3 group">
      <div class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-2.5 py-1.5 font-mono font-bold tracking-widest text-sm group-hover:bg-transparent group-hover:text-[#0A0A0A] transition-colors">
        RAILTECH
      </div>
      <div class="flex flex-col">
        <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-[#4A5056] leading-none">
          ENGINEERING & LOGISTICS
        </span>
        <span class="text-xs font-bold text-[#0A0A0A] leading-tight">
          <span class="rt-lang rt-lang-ru">УЗБЕКИСТАН • B2B / B2G</span>
          <span class="rt-lang rt-lang-uz">O'ZBEKISTON • B2B / B2G</span>
          <span class="rt-lang rt-lang-en">UZBEKISTAN • B2B / B2G</span>
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden xl:flex items-center space-x-1 font-mono text-[11px] font-semibold tracking-wider">
      {navItems.map((item) => {
        const isActive = item.match(pathname);
        return (
          <a
            href={item.href}
            class={`px-2 py-1.5 border transition-colors ${
              isActive
                ? 'bg-[#0A0A0A] text-white border-[#0A0A0A]'
                : 'border-transparent text-[#0A0A0A] hover:border-[#0A0A0A] hover:bg-[#0A0A0A]/5'
            }`}
          >
            <span class="rt-lang rt-lang-ru">{item.label_ru}</span>
            <span class="rt-lang rt-lang-uz">{item.label_uz}</span>
            <span class="rt-lang rt-lang-en">{item.label_en}</span>
          </a>
        );
      })}
    </nav>

    <!-- Right Controls: CAD Language Switcher + Lead Button -->
    <div class="flex items-center space-x-2">
      <!-- Brutalist CAD Language Switcher [ RU | UZ | EN ] -->
      <div class="rt-lang-switcher border border-[#0A0A0A] bg-[#C8CDD2] p-0.5 inline-flex items-center font-mono text-[11px] font-bold" role="group" aria-label="Language selector">
        <button
          type="button"
          data-lang-btn="ru"
          class="px-2 py-0.5 transition-colors cursor-pointer text-[#0A0A0A] hover:bg-[#0A0A0A]/10"
          aria-label="Русский язык"
        >
          RU
        </button>
        <span class="text-[#0A0A0A]/30">|</span>
        <button
          type="button"
          data-lang-btn="uz"
          class="px-2 py-0.5 transition-colors cursor-pointer text-[#0A0A0A] hover:bg-[#0A0A0A]/10"
          aria-label="O'zbek tili"
        >
          UZ
        </button>
        <span class="text-[#0A0A0A]/30">|</span>
        <button
          type="button"
          data-lang-btn="en"
          class="px-2 py-0.5 transition-colors cursor-pointer text-[#0A0A0A] hover:bg-[#0A0A0A]/10"
          aria-label="English language"
        >
          EN
        </button>
      </div>

      <!-- Lead Request Button -->
      <button
        type="button"
        data-lead-modal
        data-lead-subject="Запрос коммерческого предложения / спецификации с сайта"
        class="border border-[#0A0A0A] bg-[#0A0A0A] text-white font-mono text-[11px] font-bold px-3 py-1.5 tracking-wider hover:bg-transparent hover:text-[#0A0A0A] transition-colors cursor-pointer whitespace-nowrap"
      >
        <span class="rt-lang rt-lang-ru">[ ЗАПРОС КП / СЧЕТА ]</span>
        <span class="rt-lang rt-lang-uz">[ TIJORAT TAKLIFI / HISOB ]</span>
        <span class="rt-lang rt-lang-en">[ RFQ / INVOICE REQUEST ]</span>
      </button>

      <!-- Mobile Menu Trigger -->
      <button
        id="mobile-nav-toggle"
        type="button"
        aria-label="Меню навигации"
        class="xl:hidden border border-[#0A0A0A] p-1.5 hover:bg-[#0A0A0A] hover:text-white transition-colors cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-nav-menu" class="hidden xl:hidden border-t border-[#0A0A0A] bg-[#D4D8DC] px-4 py-3 font-mono text-xs">
    <div class="flex flex-col space-y-2">
      <!-- Mobile Language Switcher -->
      <div class="pb-2 border-b border-[#0A0A0A]/20 flex items-center justify-between">
        <span class="text-[#4A5056] font-bold">ЯЗЫК / TIL / LANGUAGE:</span>
        <div class="rt-lang-switcher border border-[#0A0A0A] bg-[#C8CDD2] p-0.5 inline-flex items-center font-mono text-xs font-bold">
          <button type="button" data-lang-btn="ru" class="px-2 py-0.5 transition-colors cursor-pointer">RU</button>
          <span class="text-[#0A0A0A]/30">|</span>
          <button type="button" data-lang-btn="uz" class="px-2 py-0.5 transition-colors cursor-pointer">UZ</button>
          <span class="text-[#0A0A0A]/30">|</span>
          <button type="button" data-lang-btn="en" class="px-2 py-0.5 transition-colors cursor-pointer">EN</button>
        </div>
      </div>

      {navItems.map((item) => {
        const isActive = item.match(pathname);
        return (
          <a
            href={item.href}
            class={`p-2 border border-[#0A0A0A] ${
              isActive ? 'bg-[#0A0A0A] text-white' : 'bg-[#C8CDD2] hover:bg-[#0A0A0A] hover:text-white'
            }`}
          >
            <span class="rt-lang rt-lang-ru">{item.label_ru}</span>
            <span class="rt-lang rt-lang-uz">{item.label_uz}</span>
            <span class="rt-lang rt-lang-en">{item.label_en}</span>
          </a>
        );
      })}
      <div class="pt-2 border-t border-[#0A0A0A]/20 flex flex-col space-y-1.5 text-[11px] text-[#4A5056]">
        <div>ИНН: {globalData.inn} | НДС 12%</div>
        <div>Склад: {globalData.address}</div>
        <a href={`tel:${globalData.phone.replace(/[\s-]/g, '')}`} class="text-[#0A0A0A] font-bold underline">{globalData.phone}</a>
        <a href={globalData.b2bPortalUrl} target="_blank" class="text-[#0A0A0A] font-bold underline">B2B.RAILTECH.UZ ↗</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    function getStoredLang() {
      try {
        var param = new URLSearchParams(window.location.search).get('lang');
        if (param === 'ru' || param === 'uz' || param === 'en') return param;
        var stored = localStorage.getItem('rt_lang');
        if (stored === 'ru' || stored === 'uz' || stored === 'en') return stored;
      } catch (e) {}
      return 'ru';
    }

    function syncSwitcherButtons(activeLang) {
      document.querySelectorAll('[data-lang-btn]').forEach(function(btn) {
        var lang = btn.getAttribute('data-lang-btn');
        if (lang === activeLang) {
          btn.className = 'px-2 py-0.5 transition-colors cursor-pointer bg-[#0A0A0A] text-white font-bold';
          btn.setAttribute('aria-current', 'true');
        } else {
          btn.className = 'px-2 py-0.5 transition-colors cursor-pointer text-[#0A0A0A] hover:bg-[#0A0A0A]/10 font-bold';
          btn.removeAttribute('aria-current');
        }
      });
    }

    function updateDataLangElements(lang) {
      document.querySelectorAll('[data-lang-ru]').forEach(function(el) {
        var val = el.getAttribute('data-lang-' + lang) || el.getAttribute('data-lang-ru');
        if (val) el.textContent = val;
      });

      document.querySelectorAll('[data-i18n-placeholder-ru]').forEach(function(el) {
        var val = el.getAttribute('data-i18n-placeholder-' + lang) || el.getAttribute('data-i18n-placeholder-ru');
        if (val) el.setAttribute('placeholder', val);
      });
    }

    function applyLanguage(lang) {
      document.documentElement.lang = lang;
      try {
        localStorage.setItem('rt_lang', lang);
      } catch (e) {}
      syncSwitcherButtons(lang);
      updateDataLangElements(lang);
      window.dispatchEvent(new CustomEvent('rt-lang-change', { detail: lang }));
    }

    // Initialize
    var currentLang = getStoredLang();
    applyLanguage(currentLang);

    // Event listeners for language buttons
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-lang-btn]');
      if (!btn) return;
      e.preventDefault();
      var targetLang = btn.getAttribute('data-lang-btn');
      if (targetLang && (targetLang === 'ru' || targetLang === 'uz' || targetLang === 'en')) {
        applyLanguage(targetLang);
      }
    });

    // Mobile menu toggle
    var toggle = document.getElementById('mobile-nav-toggle');
    var menu = document.getElementById('mobile-nav-menu');
    if (toggle && menu) {
      toggle.addEventListener('click', function() {
        menu.classList.toggle('hidden');
      });
    }
  })();
</script>
