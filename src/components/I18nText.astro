---
/**
 * Renders ONE language — the page language from Astro.locals.lang (see src/middleware.ts).
 *
 *   <I18nText k="common.details" />                      — interface string from src/data/cms/ui/*.json
 *   <I18nText ru={d.title} uz={d.title_uz} en={d.title_en} />  — CMS content with RU fallback
 *
 * Values are rendered as HTML (CMS fields may contain <br>, <b> …).
 */
import { pick } from '../i18n';
import { t } from '../i18n/ui';

interface Props {
  k?: string;
  vars?: Record<string, string | number>;
  ru?: string;
  uz?: string;
  en?: string;
  class?: string;
  as?: 'span' | 'div' | 'p' | 'h1' | 'h2' | 'h3' | 'h4' | 'strong' | 'b';
}

const { k, vars, ru = '', uz, en, class: className, as: Tag = 'span' } = Astro.props;
const lang = Astro.locals.lang;
const value = k ? t(lang, k, vars) : pick(lang, ru, uz, en);
---

<Tag class={className || undefined} set:html={value} />
