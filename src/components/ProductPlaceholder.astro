---
/**
 * Shown instead of a product photo when the catalog entry has no `image` yet:
 * a CAD-style frame with the SKU (no fake stock photo, no broken image).
 */
import { t } from '../i18n/ui';

interface Props {
  sku: string;
  /** Compact variant for thumbnails (SKU only) */
  compact?: boolean;
  class?: string;
}
const { sku, compact = false, class: className = '' } = Astro.props;
const label = t(Astro.locals.lang, 'media.photoPending');
---

<div
  role="img"
  aria-label={`${sku} — ${label}`}
  class={`relative w-full h-full flex flex-col items-center justify-center bg-[#D4D8DC] font-mono text-[#0A0A0A] cad-grid-bg ${className}`}
>
  <span class={`font-bold tracking-wider ${compact ? 'text-[8px]' : 'text-xs sm:text-sm'}`}>{sku}</span>
  {!compact && <span class="mt-1 text-[10px] uppercase tracking-widest text-[#4A5056]">{label}</span>}
</div>
