---
/**
 * «На странице»: links to the sections of a long page (article, partner profile, legal page).
 * Shown in the side column on wide screens only (the page decides); anchors come from withToc() or the page itself.
 */
import { t } from '../../i18n/ui';
import type { TocItem } from '../../utils/markdown';

interface Props {
  items: TocItem[];
}
const lang = Astro.locals.lang;
const { items } = Astro.props;
---

{items.length > 1 && (
  <nav class="toc" aria-label={t(lang, 'article.toc')}>
    <p class="toc__title">{t(lang, 'article.toc')}</p>
    <ol>
      {items.map((i) => <li><a href={`#${i.id}`}>{i.text}</a></li>)}
    </ol>
  </nav>
)}

<style>
  .toc__title {
    font: 700 13px/1.2 var(--f-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-bottom: 10px;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--c-line);
  }
  a {
    display: block;
    padding: 7px 0 7px 14px;
    margin-left: -2px;
    border-left: 2px solid transparent;
    font-size: 15px;
    line-height: 1.35;
    color: var(--c-muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--c-brand-ink);
    border-left-color: var(--c-brand-ink);
  }
</style>
