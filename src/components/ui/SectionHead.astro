---
/** Eyebrow + heading (+ optional lead) above a section. `id` labels the section via aria-labelledby. */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  id?: string;
  level?: 1 | 2;
  class?: string;
}
const { eyebrow, title, lead, id, level = 2, class: className } = Astro.props;
const Tag = level === 1 ? 'h1' : 'h2';
---

<div class:list={['shead', className]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id} class:list={['shead__title', { 'shead__title--h1': level === 1 }]}>{title}</Tag>
  {lead && <p class="shead__lead">{lead}</p>}
  <slot />
</div>

<style>
  .shead {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 780px;
    margin-bottom: 44px;
  }
  .shead__title {
    font-size: 40px;
    font-weight: 700;
  }
  .shead__title--h1 {
    font-size: 52px;
    font-weight: 800;
  }
  .shead__lead {
    font-size: 19px;
    color: var(--c-muted);
  }
  @media (max-width: 760px) {
    .shead {
      margin-bottom: 28px;
    }
    .shead__title {
      font-size: 28px;
    }
    .shead__title--h1 {
      font-size: 34px;
    }
    .shead__lead {
      font-size: 17px;
    }
  }
</style>
