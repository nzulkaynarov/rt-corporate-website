---
/** Questions and answers as <details> (no JavaScript). Items are already localized. */
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {items.map((item, i) => (
    <details open={i === 0}>
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq {
    border-top: 1px solid var(--c-line);
  }
  details {
    border-bottom: 1px solid var(--c-line);
    padding: 18px 0;
  }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font: 700 17px/1.35 var(--f-display);
    min-height: 28px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    color: var(--c-brand-ink);
    font-weight: 700;
  }
  details[open] summary::after {
    content: '–';
  }
  p {
    margin-top: 10px;
    color: var(--c-muted);
    font-size: 16px;
  }
</style>
