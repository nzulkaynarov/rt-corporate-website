---
/** Wraps the LeadForm island with its props from company.json and the form styles (global, prefixed .lf). */
import LeadForm from '../islands/LeadForm';
import { localeHref } from '../../i18n';
import { company, telegramUrl, telHref } from '../../utils/company';

interface Props {
  idPrefix?: string;
}
const lang = Astro.locals.lang;
---

<div class="lf-card">
  <LeadForm
    client:visible
    lang={lang}
    idPrefix={Astro.props.idPrefix}
    endpoint={company.leadEndpoint}
    privacyHref={localeHref('/privacy/', lang)}
    newClientUrl={company.cabinet.newClientUrl}
    telegramUrl={telegramUrl()}
    phone={company.phone}
    phoneHref={telHref()}
    email={company.email}
  />
</div>

<style is:global>
  .lf-card {
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    padding: 32px;
    box-shadow: 0 24px 50px -36px rgba(45, 62, 80, 0.55);
  }
  .lf {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .lf label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--c-ink);
  }
  .lf input[type='text'],
  .lf textarea {
    font: 400 16px/1.4 var(--f-body);
    color: var(--c-ink);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-sm);
    padding: 12px 14px;
    background: var(--c-bg);
    width: 100%;
    min-height: 46px;
  }
  .lf textarea {
    min-height: 110px;
    resize: vertical;
  }
  .lf [aria-invalid='true'] {
    border-color: var(--c-danger-ink);
  }
  .lf__two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .lf__err {
    color: var(--c-danger-ink);
    font-weight: 500;
    font-size: 14px;
  }
  .lf__chk {
    flex-direction: row !important;
    align-items: flex-start;
    gap: 10px !important;
    font-weight: 400 !important;
    color: var(--c-muted) !important;
    line-height: 1.45;
  }
  .lf__chk input {
    width: 20px;
    height: 20px;
    margin-top: 1px;
    flex: none;
  }
  .lf__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .lf__submit {
    width: 100%;
    min-height: 50px;
    font-size: 16px;
  }
  .lf__submit[disabled] {
    opacity: 0.7;
    cursor: progress;
  }
  .lf__fail {
    border-left: 3px solid var(--c-accent);
    padding: 4px 0 4px 14px;
    color: var(--c-ink);
    font-size: 15px;
  }
  .lf__alt {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .lf__alt a {
    font-weight: 600;
  }
  .lf--done .lf__done-title {
    font: 700 22px/1.2 var(--f-display);
    margin-bottom: 8px;
  }
  @media (max-width: 760px) {
    .lf-card {
      padding: 20px;
    }
    .lf__two {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
