---
/**
 * Manufacturer tiles from the partners collection (src/content/partners: one record = tile + article). The brand is
 * the tile heading (with the manufacturer's logo above it, if the record has one), the legal entity is shown under it; the tile links to /news/partner-<id>/ once the article text is
 * written. Country names come from country.<code> interface strings. The basis of a dealer status is not shown.
 * On phones the tiles become a horizontal swipe row.
 */
import { localeHref, tField } from '../../i18n';
import { t } from '../../i18n/ui';
import { getPartners } from '../../utils/feed';
import { withBase } from '../../utils/url';

interface Props {
  /** Ids to show (default: all). */
  ids?: string[];
}
const lang = Astro.locals.lang;
const partners = (await getPartners())
  .filter((p) => !Astro.props.ids || Astro.props.ids.includes(p.id))
  .map((p) => {
    const label = tField(p.data, 'name', lang) as string;
    const legal = tField(p.data, 'legalName', lang) as string;
    return {
      label,
      logo: p.data.logo ? withBase(p.data.logo) : '',
      legal: legal && legal !== label ? legal : '',
      country: t(lang, `country.${p.data.country}`),
      statusKey: p.data.status,
      status: t(lang, `partner.status.${p.data.status}`),
      href: p.articleSlug ? localeHref(`/news/${p.articleSlug}/`, lang) : '',
    };
  });
// A tile without a logo keeps the same top space, so the names line up across the row.
const anyLogo = partners.some((p) => p.logo);
---

<ul class="tiles" aria-label={t(lang, 'partner.tilesAria')}>
  {partners.map((p) => (
    <li>
      {p.href ? (
        <a class:list={['tile', 'lift', { 'tile--dealer': p.statusKey === 'dealer' }]} href={p.href}>
          {p.logo ? <span class="tile__logo"><img src={p.logo} alt="" loading="lazy" decoding="async" /></span> : anyLogo && <span class="tile__logo tile__logo--none" aria-hidden="true"></span>}
          <b>{p.label}</b>
          {p.legal && <span class="tile__legal">{p.legal}</span>}
          <span class="tile__country">{p.country}</span>
          <span class="tile__status">{p.status}</span>
          <svg class="tile__arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 9h12M10 4l5 5-5 5"></path></svg>
        </a>
      ) : (
        <div class:list={['tile', { 'tile--dealer': p.statusKey === 'dealer' }]}>
          {p.logo ? <span class="tile__logo"><img src={p.logo} alt="" loading="lazy" decoding="async" /></span> : anyLogo && <span class="tile__logo tile__logo--none" aria-hidden="true"></span>}
          <b>{p.label}</b>
          {p.legal && <span class="tile__legal">{p.legal}</span>}
          <span class="tile__country">{p.country}</span>
          <span class="tile__status">{p.status}</span>
        </div>
      )}
    </li>
  ))}
</ul>

<style>
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    padding: 18px 20px 18px;
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    background: var(--c-bg);
    color: var(--c-ink);
    text-decoration: none;
  }
  a.tile:hover {
    border-color: var(--c-brand-mid);
    box-shadow: var(--shadow-lift);
    color: var(--c-ink);
  }
  /* Logo plate: always white, so a mark drawn for a light background reads on the tinted dealer tile too. */
  .tile__logo {
    display: flex;
    align-items: center;
    align-self: flex-start;
    height: 44px;
    max-width: calc(100% - 26px);
    margin-bottom: 8px;
    padding: 6px 10px;
    border-radius: var(--r-sm);
    background: var(--c-bg);
  }
  /* Fixed height, width by the mark's proportions (an SVG with only a viewBox has no size of its own). */
  .tile__logo--none {
    background: none;
  }
  .tile__logo img {
    display: block;
    height: 100%;
    width: auto;
    max-width: 132px;
    object-fit: contain;
    object-position: left center;
  }
  .tile b {
    font: 700 16px/1.3 var(--f-display);
    padding-right: 22px;
  }
  .tile__legal,
  .tile__country {
    font-size: 14px;
    color: var(--c-muted);
  }
  .tile__status {
    margin-top: 8px;
    align-self: flex-start;
    font-size: 13px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: var(--c-soft);
  }
  .tile--dealer {
    background: var(--c-brand-soft);
    border-color: var(--c-brand-mid);
  }
  .tile--dealer .tile__status {
    background: var(--c-bg);
    color: var(--c-brand-ink-hover);
  }
  .tile__arrow {
    position: absolute;
    right: 16px;
    top: 20px;
    color: var(--c-brand-ink);
  }
  @media (max-width: 760px) {
    .tiles {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      /* snap to the page gutter, not to the screen edge */
      scroll-padding-inline: var(--gutter);
      gap: 10px;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      padding-bottom: 6px;
    }
    .tiles li {
      flex: 0 0 72%;
      scroll-snap-align: start;
    }
  }
</style>
