---
/**
 * Contact bar fixed to the bottom of the screen on phones (≤ 760 px; docs/DESIGN.md → «Телефон»).
 * On a phone the header buttons live inside «Меню», so the main action stays one tap away here:
 * «Начать работу» (the request form), Telegram and a call. Not a second navigation — the same actions as the header.
 * No JavaScript: the bar hides while a form field has focus (the keyboard is open) and is not rendered on wider screens.
 */
import { localeHref } from '../../i18n';
import { t } from '../../i18n/ui';
import { company, telHref, telegramUrl } from '../../utils/company';
import { START_PATH } from '../../utils/nav';

const lang = Astro.locals.lang;
const tg = telegramUrl();
const tel = telHref();
---

<nav class="mbar" aria-label={t(lang, 'mbar.aria')}>
  <a class="btn btn--primary mbar__main" href={localeHref(START_PATH, lang)}>{t(lang, 'cta.start')}</a>
  {tg && (
    <a class="mbar__icon" href={tg} target="_blank" rel="noopener noreferrer" aria-label={t(lang, 'mbar.telegram')}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.4 4.3 18.5 19c-.2 1-.8 1.2-1.6.8l-4.500-3.300-2.200 2.100c-.2.200-.4.400-.9.400l.300-4.600 8.300-7.500c.400-.3-.1-.5-.6-.2L7.100 13.200 2.700 11.800c-1-.3-1-1 .2-1.400l17.200-6.600c.800-.300 1.500.200 1.300.5Z"/></svg>
    </a>
  )}
  {company.phone && (
    <a class="mbar__icon" href={tel} aria-label={t(lang, 'mbar.call')}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
    </a>
  )}
</nav>

<style>
  .mbar {
    display: none;
  }
  @media (max-width: 760px) {
    .mbar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 15; /* under the sticky header and its menu (20) */
      display: flex;
      align-items: center;
      gap: 8px;
      min-height: var(--mbar-h);
      padding: 8px var(--gutter) calc(8px + env(safe-area-inset-bottom, 0px));
      background: var(--c-bg);
      border-top: 1px solid var(--c-line);
    }
    .mbar__main {
      flex: 1;
      justify-content: center;
      min-height: 48px;
    }
    .mbar__icon {
      flex: none;
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border: 1.5px solid var(--c-ink);
      border-radius: var(--r-sm);
      color: var(--c-ink);
    }
    /* the keyboard is open: give the form the whole screen */
    :global(body:has(input:focus, textarea:focus, select:focus)) .mbar {
      display: none;
    }
  }
  @media print {
    .mbar {
      display: none;
    }
  }
</style>
