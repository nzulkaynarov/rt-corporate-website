---
import globalData from '../data/cms/global.json';
import { localeHref, tField } from '../i18n';
import { t } from '../i18n/ui';
import { withBase, telHref } from '../utils/url';
import { fillCounters, getCounters } from '../utils/counters';

const lang = Astro.locals.lang;
const tr = (key: string) => t(lang, key);
const g = globalData as Record<string, any>;
const footer: Record<string, any> = g.footer || {};
const F = (field: string): string => tField(footer, field, lang);

const companyName: string = tField(g, 'companyName', lang);
const address: string = tField(g, 'address', lang);
const counters = await getCounters();
const links = (footer.links || []).map((link: any) => ({
  href: localeHref(link.path, lang),
  index: link.index,
  label: tField(link, 'label', lang),
  badge: fillCounters(tField(link, 'badge', lang), counters),
}));
const hubText = F('hubText').replace('{address}', address);
const phoneHref = telHref(g.phone);
---

<footer class="border-t-2 border-[#0A0A0A] bg-[#C8CDD2] text-[#0A0A0A] font-mono text-xs select-none">
  <!-- Main Grid -->
  <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    <!-- Col 1: Legal Dossier -->
    <div class="flex flex-col space-y-3">
      <div class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-2 py-1 inline-block w-max font-bold tracking-widest text-xs">
        {companyName.toUpperCase()}
      </div>
      <p class="text-[11px] text-[#4A5056] leading-relaxed">
        <span>{F('companyDesc')}</span>
      </p>
      <div class="border border-[#0A0A0A]/30 p-2.5 bg-[#D4D8DC] text-[11px] space-y-1">
        <div class="font-bold text-[#0A0A0A]">
          <span>{tr('footer.requisites')}</span>
        </div>
        <div>
          <span>{tr('footer.tin')}</span>
          <span class="font-bold"> {g.inn}</span>
        </div>
      </div>
      <div class="pt-1 flex flex-wrap gap-2 text-[10px]">
        <a href={localeHref('/privacy/', lang)} class="text-[#4A5056] hover:text-[#0A0A0A] underline">
          <span>{tr('footer.privacy')}</span>
        </a>
        <span class="text-[#0A0A0A]/30">·</span>
        <a href={localeHref('/terms/', lang)} class="text-[#4A5056] hover:text-[#0A0A0A] underline">
          <span>{tr('footer.terms')}</span>
        </a>
      </div>
    </div>

    <!-- Col 2: Navigation (Strict 6 Universal Sections) -->
    <div class="flex flex-col space-y-2">
      <div class="border-b border-[#0A0A0A] pb-1 font-bold text-[11px] tracking-wider text-[#0A0A0A]">
        <span>{F('sectionsTitle')}</span>
      </div>
      <ul class="space-y-0.5 text-[11px]">
        {links.map((link: { href: string; index: string; label: string; badge: string }) => (
          <li>
            <a href={link.href} class="hover:underline flex items-center justify-between min-h-[24px] py-1">
              <span>
                <span>[{link.index}] {link.label}</span>
              </span>
              {link.badge && (
                <span class="text-[#4A5056]">
                  <span>{link.badge}</span>
                </span>
              )}
            </a>
          </li>
        ))}
        <li class="pt-1 border-t border-[#0A0A0A]/20">
          <a href={withBase('/admin/')} class="text-[#4A5056] hover:text-[#0A0A0A] hover:underline flex items-center justify-between">
            <span>[CMS] Sveltia CMS ↗</span>
            <span>{tr('footer.admin')}</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Col 3: Logistics & Warehouse Hub -->
    <div class="flex flex-col space-y-2">
      <div class="border-b border-[#0A0A0A] pb-1 font-bold text-[11px] tracking-wider text-[#0A0A0A]">
        <span>{F('hubTitle')}</span>
      </div>
      <p class="text-[11px] text-[#4A5056] leading-relaxed">
        <span>{hubText}</span>
      </p>
      <div class="border border-[#0A0A0A]/30 p-2.5 bg-[#D4D8DC] text-[11px] space-y-1">
        <div>{tr('footer.office')} {tField(g, 'officeAddress', lang)}</div>
        <div>
          <span>{F('hubAccess')}</span>
        </div>
        <div>
          <span>{F('hubHours')}</span>
        </div>
        <div class="text-[#0A0A0A] font-semibold">
          <span>{F('hubDispatch')}</span>
        </div>
      </div>
    </div>

    <!-- Col 4: Contacts & Telemetry -->
    <div class="flex flex-col space-y-2">
      <div class="border-b border-[#0A0A0A] pb-1 font-bold text-[11px] tracking-wider text-[#0A0A0A]">
        <span>{F('contactsTitle')}</span>
      </div>
      <div class="space-y-1 text-[11px]">
        <div class="text-[#4A5056]">
          <span>{tr('footer.phone')}</span>
        </div>
        <a href={phoneHref} class="block font-bold text-sm text-[#0A0A0A] hover:underline">
          {g.phone}
        </a>
      </div>
      <div class="space-y-1 text-[11px]">
        <div class="text-[#4A5056]">
          <span>{tr('footer.email')}</span>
        </div>
        <a href={`mailto:${g.emailGeneral}`} class="block text-[#0A0A0A] underline hover:no-underline">
          {g.emailGeneral}
        </a>
      </div>
      <div class="pt-2">
        <button
          type="button"
          data-lead-modal
          data-lead-subject={t(lang, 'lead.subject.footer')}
          class="w-full border border-[#0A0A0A] bg-[#0A0A0A] text-white py-2 text-center hover:bg-transparent hover:text-[#0A0A0A] transition-colors font-bold cursor-pointer"
        >
          <span>{tr('footer.submitRequest')}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Bottom Telemetry Bar -->
  <div class="border-t border-[#0A0A0A] bg-[#0A0A0A] text-[#D4D8DC] px-4 py-2 text-[10px] flex flex-col md:flex-row items-center justify-between gap-2">
    <div class="flex items-center space-x-3">
      <span class="inline-block w-1.5 h-1.5 bg-green-400"></span>
      <span>
        <span>{F('statusLine')}</span>
      </span>
      <span class="text-white/40">|</span>
      <span>{F('securityLine')}</span>
    </div>
    <div class="flex items-center space-x-4">
      <a href={localeHref('/privacy/', lang)} class="text-[#D4D8DC] hover:text-white underline">
        <span>{tr('footer.privacyShort')}</span>
      </a>
      <a href={localeHref('/terms/', lang)} class="text-[#D4D8DC] hover:text-white underline">
        <span>{tr('footer.termsShort')}</span>
      </a>
      <span>
        © {g.copyrightYear} {companyName}.
      </span>
    </div>
  </div>
</footer>
