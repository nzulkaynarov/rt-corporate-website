---
import globalData from '../data/cms/global.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="border-t-2 border-[#0A0A0A] bg-[#C8CDD2] text-[#0A0A0A] font-mono text-xs select-none">
  <!-- Main Grid -->
  <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    <!-- Col 1: Legal Dossier -->
    <div class="flex flex-col space-y-3">
      <div class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-2 py-1 inline-block w-max font-bold tracking-widest text-xs">
        {globalData.companyName.toUpperCase()}
      </div>
      <p class="text-[11px] text-[#4A5056] leading-relaxed">
        {globalData.legalStatus}. Инженерный поставщик комплектующих подвижного состава, систем СЦБ и инфраструктурных решений для железных дорог Центральной Азии.
      </p>
      <div class="border border-[#0A0A0A]/30 p-2.5 bg-[#D4D8DC] text-[11px] space-y-1">
        <div class="font-bold text-[#0A0A0A]">РЕКВИЗИТЫ ПРЕДПРИЯТИЯ:</div>
        <div>ИНН: <span class="font-bold">{globalData.inn}</span></div>
        <div>НДС: <span class="font-bold">12% (ПЛАТЕЛЬЩИК)</span></div>
        <div>ОКЭД: 46.69.0</div>
        <div>ЭСФ: Didox / Soliq / Factura.uz</div>
      </div>
      <div class="pt-1 flex flex-wrap gap-2 text-[10px]">
        <a href={`${base}/privacy`} class="text-[#4A5056] hover:text-[#0A0A0A] underline">
          Политика конфиденциальности
        </a>
        <span class="text-[#0A0A0A]/30">·</span>
        <a href={`${base}/terms`} class="text-[#4A5056] hover:text-[#0A0A0A] underline">
          Условия использования
        </a>
      </div>
    </div>

    <!-- Col 2: Navigation -->
    <div class="flex flex-col space-y-2">
      <div class="border-b border-[#0A0A0A] pb-1 font-bold text-[11px] tracking-wider text-[#0A0A0A]">
        НАВИГАЦИЯ ПО ПОРТАЛУ
      </div>
      <ul class="space-y-1.5 text-[11px]">
        <li>
          <a href={`${base}/catalog/`} class="hover:underline flex items-center justify-between">
            <span>[01] Каталог со склада</span>
            <span class="text-[#4A5056]">10 групп</span>
          </a>
        </li>
        <li>
          <a href={`${base}/contract`} class="hover:underline flex items-center justify-between">
            <span>[02] Контрактный ВЭД DDP</span>
            <span class="text-[#4A5056]">4 этапа</span>
          </a>
        </li>
        <li>
          <a href={`${base}/digital`} class="hover:underline flex items-center justify-between">
            <span>[03] RailTech Digital & ПО</span>
            <span class="text-[#4A5056]">b2b.railtech.uz</span>
          </a>
        </li>
        <li>
          <a href={`${base}/projects`} class="hover:underline flex items-center justify-between">
            <span>[04] Спецпроекты & Арт-лаб</span>
            <span class="text-[#4A5056]">Локализация</span>
          </a>
        </li>
        <li>
          <a href={`${base}/blog/`} class="hover:underline flex items-center justify-between">
            <span>[05] Блог и Новости</span>
            <span class="text-[#4A5056]">Аналитика</span>
          </a>
        </li>
        <li>
          <a href={`${base}/about`} class="hover:underline flex items-center justify-between">
            <span>[06] О компании</span>
            <span class="text-[#4A5056]">Статус юрлица</span>
          </a>
        </li>
        <li>
          <a href={`${base}/contacts`} class="hover:underline flex items-center justify-between">
            <span>[07] Контакты и реквизиты</span>
            <span class="text-[#4A5056]">Схема проезда</span>
          </a>
        </li>
        <li class="pt-1 border-t border-[#0A0A0A]/20">
          <a href={`${base}/admin/`} class="text-[#4A5056] hover:text-[#0A0A0A] hover:underline flex items-center justify-between">
            <span>[CMS] Панель управления</span>
            <span>Sveltia CMS ↗</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Col 3: Logistics & Warehouse -->
    <div class="flex flex-col space-y-2">
      <div class="border-b border-[#0A0A0A] pb-1 font-bold text-[11px] tracking-wider text-[#0A0A0A]">
        СКЛАДСКОЙ ХАБ В ТАШКЕНТЕ
      </div>
      <p class="text-[11px] text-[#4A5056] leading-relaxed">
        Собственный складской комплекс в {globalData.address}. Постоянный неснижаемый запас критических позиций (СА-3, СП-6М, колесные пары, колодки 25610-Н).
      </p>
      <div class="border border-[#0A0A0A]/30 p-2.5 bg-[#D4D8DC] text-[11px] space-y-1">
        <div>GPS: 41.2214° N, 69.1852° E</div>
        <div>Колея: 1520 мм (подъездной ЖД путь)</div>
        <div>Режим: Пн-Пт 09:00 - 18:00</div>
        <div class="text-[#0A0A0A] font-semibold">Отгрузка ЖД платформ: 24/7</div>
      </div>
    </div>

    <!-- Col 4: Contacts & Telemetry -->
    <div class="flex flex-col space-y-2">
      <div class="border-b border-[#0A0A0A] pb-1 font-bold text-[11px] tracking-wider text-[#0A0A0A]">
        ОПЕРАТИВНЫЙ СВЯЗНОЙ УЗЕЛ
      </div>
      <div class="space-y-1 text-[11px]">
        <div class="text-[#4A5056]">Прямая линия снабжения:</div>
        <a href={`tel:${globalData.phone.replace(/[\s-]/g, '')}`} class="block font-bold text-sm text-[#0A0A0A] hover:underline">
          {globalData.phone}
        </a>
      </div>
      <div class="space-y-1 text-[11px]">
        <div class="text-[#4A5056]">Электронная почта:</div>
        <a href={`mailto:${globalData.emailGeneral}`} class="block text-[#0A0A0A] underline hover:no-underline">
          {globalData.emailGeneral}
        </a>
        <a href={`mailto:supply@railtech.uz`} class="block text-[#0A0A0A] underline hover:no-underline">
          supply@railtech.uz (Заявки)
        </a>
        <a href={`mailto:${globalData.emailLegal}`} class="block text-[#4A5056] hover:text-[#0A0A0A] text-[10px]">
          Юротдел: {globalData.emailLegal}
        </a>
      </div>
      <div class="pt-2">
        <button
          type="button"
          data-lead-modal
          data-lead-subject="Запрос счета и паспортов качества"
          class="w-full border border-[#0A0A0A] bg-[#0A0A0A] text-white py-2 text-center hover:bg-transparent hover:text-[#0A0A0A] transition-colors font-bold cursor-pointer"
        >
          [ ЗАГРУЗИТЬ СПЕЦИФИКАЦИЮ ]
        </button>
      </div>
    </div>
  </div>

  <!-- Bottom Telemetry Bar -->
  <div class="border-t border-[#0A0A0A] bg-[#0A0A0A] text-[#D4D8DC] px-4 py-2 text-[10px] flex flex-col md:flex-row items-center justify-between gap-2">
    <div class="flex items-center space-x-3">
      <span class="inline-block w-1.5 h-1.5 bg-green-400"></span>
      <span>STATUS: PRODUCTION // NODE: TASHKENT</span>
      <span class="text-white/40">|</span>
      <span>SECURITY: TLS 1.3 / E-SIGN VERIFIED</span>
    </div>
    <div class="flex items-center space-x-4">
      <a href={`${base}/privacy`} class="text-[#D4D8DC] hover:text-white underline">
        Конфиденциальность
      </a>
      <a href={`${base}/terms`} class="text-[#D4D8DC] hover:text-white underline">
        Условия сервиса
      </a>
      <span>
        © 2026 {globalData.companyName}. РЕСПУБЛИКА УЗБЕКИСТАН.
      </span>
    </div>
  </div>
</footer>
