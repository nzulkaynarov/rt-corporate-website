---
import globalData from '../data/cms/global.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="border-t-2 border-[#0A0A0A] bg-[#C8CDD2] text-[#0A0A0A] font-mono text-xs select-none">
  <!-- Main Grid -->
  <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    <!-- Col 1: Legal Dossier -->
    <div class="flex flex-col space-y-3">
      <div class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-2 py-1 inline-block w-max font-bold tracking-widest text-xs">
        {globalData.companyName.toUpperCase()}
      </div>
      <p class="text-[11px] text-[#4A5056] leading-relaxed">
        <span class="rt-lang rt-lang-ru">{globalData.legalStatus}. Многопрофильный оператор промышленных поставок, контрактного ВЭД под ключ, инженерного сорсинга и заказного цифрового ПО в Узбекистане.</span>
        <span class="rt-lang rt-lang-uz">{globalData.legalStatus_uz || globalData.legalStatus}. O'zbekistonda sanoat ta'minoti, kalit topshirish shartnomaviy TQI, muhandislik sorsingi va buyurtma dasturiy ta'minotning ko'p tarmoqli operatori.</span>
        <span class="rt-lang rt-lang-en">{globalData.legalStatus_en || globalData.legalStatus}. Multi-sector operator for industrial supply, turnkey DDP import, engineering sourcing, and enterprise software engineering in Uzbekistan.</span>
      </p>
      <div class="border border-[#0A0A0A]/30 p-2.5 bg-[#D4D8DC] text-[11px] space-y-1">
        <div class="font-bold text-[#0A0A0A]">
          <span class="rt-lang rt-lang-ru">РЕКВИЗИТЫ ПРЕДПРИЯТИЯ:</span>
          <span class="rt-lang rt-lang-uz">KORXONA REKVIZITLARI:</span>
          <span class="rt-lang rt-lang-en">COMPANY REQUISITES:</span>
        </div>
        <div>
          <span class="rt-lang rt-lang-ru">ИНН:</span>
          <span class="rt-lang rt-lang-uz">STIR (INN):</span>
          <span class="rt-lang rt-lang-en">TIN / INN:</span>
          <span class="font-bold"> {globalData.inn}</span>
        </div>
        <div>
          <span class="rt-lang rt-lang-ru">НДС: <span class="font-bold">12% (ПЛАТЕЛЬЩИК)</span></span>
          <span class="rt-lang rt-lang-uz">QQS: <span class="font-bold">12% (TO'LOVCHI)</span></span>
          <span class="rt-lang rt-lang-en">VAT: <span class="font-bold">12% (ACCREDITED)</span></span>
        </div>
        <div>ОКЭД / IFUT: 46.69.0</div>
        <div>ЭСФ / EHF: Didox / Soliq / Factura.uz</div>
      </div>
      <div class="pt-1 flex flex-wrap gap-2 text-[10px]">
        <a href={`${base}/privacy`} class="text-[#4A5056] hover:text-[#0A0A0A] underline">
          <span class="rt-lang rt-lang-ru">Политика конфиденциальности</span>
          <span class="rt-lang rt-lang-uz">Maxfiylik siyosati</span>
          <span class="rt-lang rt-lang-en">Privacy Policy</span>
        </a>
        <span class="text-[#0A0A0A]/30">·</span>
        <a href={`${base}/terms`} class="text-[#4A5056] hover:text-[#0A0A0A] underline">
          <span class="rt-lang rt-lang-ru">Условия использования</span>
          <span class="rt-lang rt-lang-uz">Foydalanish shartlari</span>
          <span class="rt-lang rt-lang-en">Terms of Service</span>
        </a>
      </div>
    </div>

    <!-- Col 2: Navigation (Strict 6 Universal Sections) -->
    <div class="flex flex-col space-y-2">
      <div class="border-b border-[#0A0A0A] pb-1 font-bold text-[11px] tracking-wider text-[#0A0A0A]">
        <span class="rt-lang rt-lang-ru">РАЗДЕЛЫ ПОРТАЛА</span>
        <span class="rt-lang rt-lang-uz">PORTAL BO'LIMLARI</span>
        <span class="rt-lang rt-lang-en">PORTAL SECTIONS</span>
      </div>
      <ul class="space-y-1.5 text-[11px]">
        <li>
          <a href={`${base}/catalog/`} class="hover:underline flex items-center justify-between">
            <span>
              <span class="rt-lang rt-lang-ru">[01] Каталог продукции</span>
              <span class="rt-lang rt-lang-uz">[01] Mahsulotlar katalogi</span>
              <span class="rt-lang rt-lang-en">[01] Products catalog</span>
            </span>
            <span class="text-[#4A5056]">
              <span class="rt-lang rt-lang-ru">1 200+ SKU</span>
              <span class="rt-lang rt-lang-uz">1 200+ SKU</span>
              <span class="rt-lang rt-lang-en">1,200+ SKU</span>
            </span>
          </a>
        </li>
        <li>
          <a href={`${base}/services/`} class="hover:underline flex items-center justify-between">
            <span>
              <span class="rt-lang rt-lang-ru">[02] Услуги компании</span>
              <span class="rt-lang rt-lang-uz">[02] Kompaniya xizmatlari</span>
              <span class="rt-lang rt-lang-en">[02] Corporate services</span>
            </span>
            <span class="text-[#4A5056]">
              <span class="rt-lang rt-lang-ru">ВЭД / IT / Сорсинг</span>
              <span class="rt-lang rt-lang-uz">TQI / IT / Sorsing</span>
              <span class="rt-lang rt-lang-en">DDP / IT / Sourcing</span>
            </span>
          </a>
        </li>
        <li>
          <a href={`${base}/projects/`} class="hover:underline flex items-center justify-between">
            <span>
              <span class="rt-lang rt-lang-ru">[03] Проекты и кейсы</span>
              <span class="rt-lang rt-lang-uz">[03] Loyihalar va keyslar</span>
              <span class="rt-lang rt-lang-en">[03] Projects & cases</span>
            </span>
            <span class="text-[#4A5056]">
              <span class="rt-lang rt-lang-ru">Кейсы</span>
              <span class="rt-lang rt-lang-uz">Keyslar</span>
              <span class="rt-lang rt-lang-en">Portfolio</span>
            </span>
          </a>
        </li>
        <li>
          <a href={`${base}/blog/`} class="hover:underline flex items-center justify-between">
            <span>
              <span class="rt-lang rt-lang-ru">[04] Блог и аналитика</span>
              <span class="rt-lang rt-lang-uz">[04] Blog va tahlil</span>
              <span class="rt-lang rt-lang-en">[04] Blog & analytics</span>
            </span>
            <span class="text-[#4A5056]">
              <span class="rt-lang rt-lang-ru">Статьи</span>
              <span class="rt-lang rt-lang-uz">Maqolalar</span>
              <span class="rt-lang rt-lang-en">Articles</span>
            </span>
          </a>
        </li>
        <li>
          <a href={`${base}/about`} class="hover:underline flex items-center justify-between">
            <span>
              <span class="rt-lang rt-lang-ru">[05] О компании</span>
              <span class="rt-lang rt-lang-uz">[05] Kompaniya haqida</span>
              <span class="rt-lang rt-lang-en">[05] About company</span>
            </span>
            <span class="text-[#4A5056]">
              <span class="rt-lang rt-lang-ru">Статус РУз</span>
              <span class="rt-lang rt-lang-uz">O'zR maqomi</span>
              <span class="rt-lang rt-lang-en">Accreditation</span>
            </span>
          </a>
        </li>
        <li>
          <a href={`${base}/contacts`} class="hover:underline flex items-center justify-between">
            <span>
              <span class="rt-lang rt-lang-ru">[06] Контакты и реквизиты</span>
              <span class="rt-lang rt-lang-uz">[06] Aloqa va rekvizitlar</span>
              <span class="rt-lang rt-lang-en">[06] Contacts & requisites</span>
            </span>
            <span class="text-[#4A5056]">
              <span class="rt-lang rt-lang-ru">КПП №3</span>
              <span class="rt-lang rt-lang-uz">KPP №3</span>
              <span class="rt-lang rt-lang-en">Gate №3</span>
            </span>
          </a>
        </li>
        <li class="pt-1 border-t border-[#0A0A0A]/20">
          <a href={`${base}/admin/`} class="text-[#4A5056] hover:text-[#0A0A0A] hover:underline flex items-center justify-between">
            <span>[CMS] Sveltia CMS ↗</span>
            <span class="rt-lang rt-lang-ru">Панель управления</span>
            <span class="rt-lang rt-lang-uz">Boshqaruv paneli</span>
            <span class="rt-lang rt-lang-en">Admin panel</span>
          </a>
        </li>
      </ul>
    </div>

    <!-- Col 3: Logistics & Warehouse Hub -->
    <div class="flex flex-col space-y-2">
      <div class="border-b border-[#0A0A0A] pb-1 font-bold text-[11px] tracking-wider text-[#0A0A0A]">
        <span class="rt-lang rt-lang-ru">СКЛАДСКОЙ ХАБ В ТАШКЕНТЕ</span>
        <span class="rt-lang rt-lang-uz">TOSHKENTDAGI OMBOR HUBI</span>
        <span class="rt-lang rt-lang-en">WAREHOUSE HUB IN TASHKENT</span>
      </div>
      <p class="text-[11px] text-[#4A5056] leading-relaxed">
        <span class="rt-lang rt-lang-ru">Собственный распределительный терминал в {globalData.address}. Постоянный неснижаемый запас сертифицированной промышленной продукции, оборудования и комплектующих.</span>
        <span class="rt-lang rt-lang-uz">{globalData.address} manzilidagi shaxsiy taqsimlash terminali. Sertifikatlangan sanoat mahsulotlari, uskunalar va butlovchi qismlarning doimiy kamaymaydigan zaxirasi.</span>
        <span class="rt-lang rt-lang-en">Company-owned distribution terminal at {globalData.address}. Constant safety stock of certified industrial products, equipment, and components.</span>
      </p>
      <div class="border border-[#0A0A0A]/30 p-2.5 bg-[#D4D8DC] text-[11px] space-y-1">
        <div>GPS: 41.2214° N, 69.1852° E</div>
        <div>
          <span class="rt-lang rt-lang-ru">Подъездные пути: Прямой доступ (Ж/Д и авто)</span>
          <span class="rt-lang rt-lang-uz">Kirish yo'llari: To'g'ridan-to'g'ri (T/y va avto)</span>
          <span class="rt-lang rt-lang-en">Access: Direct rail & road connectivity</span>
        </div>
        <div>
          <span class="rt-lang rt-lang-ru">Режим: Пн-Пт 09:00 - 18:00</span>
          <span class="rt-lang rt-lang-uz">Tartib: Dsh-Juma 09:00 - 18:00</span>
          <span class="rt-lang rt-lang-en">Hours: Mon-Fri 09:00 - 18:00</span>
        </div>
        <div class="text-[#0A0A0A] font-semibold">
          <span class="rt-lang rt-lang-ru">Отгрузка и приемка: 24/7</span>
          <span class="rt-lang rt-lang-uz">Yuklash va qabul: 24/7</span>
          <span class="rt-lang rt-lang-en">Dispatch & intake: 24/7</span>
        </div>
      </div>
    </div>

    <!-- Col 4: Contacts & Telemetry -->
    <div class="flex flex-col space-y-2">
      <div class="border-b border-[#0A0A0A] pb-1 font-bold text-[11px] tracking-wider text-[#0A0A0A]">
        <span class="rt-lang rt-lang-ru">ОПЕРАТИВНЫЙ СВЯЗНОЙ УЗЕЛ</span>
        <span class="rt-lang rt-lang-uz">TEZKOR ALOQA TUGUNI</span>
        <span class="rt-lang rt-lang-en">COMMUNICATIONS NODE</span>
      </div>
      <div class="space-y-1 text-[11px]">
        <div class="text-[#4A5056]">
          <span class="rt-lang rt-lang-ru">Прямая линия снабжения:</span>
          <span class="rt-lang rt-lang-uz">To'g'ridan-to'g'ri ta'minot:</span>
          <span class="rt-lang rt-lang-en">Direct supply line:</span>
        </div>
        <a href={`tel:${globalData.phone.replace(/[\s-]/g, '')}`} class="block font-bold text-sm text-[#0A0A0A] hover:underline">
          {globalData.phone}
        </a>
      </div>
      <div class="space-y-1 text-[11px]">
        <div class="text-[#4A5056]">
          <span class="rt-lang rt-lang-ru">Электронная почта:</span>
          <span class="rt-lang rt-lang-uz">Elektron pochta:</span>
          <span class="rt-lang rt-lang-en">Email address:</span>
        </div>
        <a href={`mailto:${globalData.emailGeneral}`} class="block text-[#0A0A0A] underline hover:no-underline">
          {globalData.emailGeneral}
        </a>
      </div>
      <div class="pt-2">
        <button
          type="button"
          data-lead-modal
          data-lead-subject="Запрос спецификации с сайта"
          class="w-full border border-[#0A0A0A] bg-[#0A0A0A] text-white py-2 text-center hover:bg-transparent hover:text-[#0A0A0A] transition-colors font-bold cursor-pointer"
        >
          <span class="rt-lang rt-lang-ru">[ ОСТАВИТЬ ЗАЯВКУ ↗ ]</span>
          <span class="rt-lang rt-lang-uz">[ ARIZA QOLDIRISH ↗ ]</span>
          <span class="rt-lang rt-lang-en">[ SUBMIT REQUEST ↗ ]</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Bottom Telemetry Bar -->
  <div class="border-t border-[#0A0A0A] bg-[#0A0A0A] text-[#D4D8DC] px-4 py-2 text-[10px] flex flex-col md:flex-row items-center justify-between gap-2">
    <div class="flex items-center space-x-3">
      <span class="inline-block w-1.5 h-1.5 bg-green-400"></span>
      <span>
        <span class="rt-lang rt-lang-ru">STATUS: PRODUCTION // NODE: TASHKENT</span>
        <span class="rt-lang rt-lang-uz">STATUS: PRODUCTION // TUGUN: TOSHKENT</span>
        <span class="rt-lang rt-lang-en">STATUS: PRODUCTION // NODE: TASHKENT</span>
      </span>
      <span class="text-white/40">|</span>
      <span>SECURITY: TLS 1.3 / E-SIGN VERIFIED</span>
    </div>
    <div class="flex items-center space-x-4">
      <a href={`${base}/privacy`} class="text-[#D4D8DC] hover:text-white underline">
        <span class="rt-lang rt-lang-ru">Конфиденциальность</span>
        <span class="rt-lang rt-lang-uz">Maxfiylik</span>
        <span class="rt-lang rt-lang-en">Privacy</span>
      </a>
      <a href={`${base}/terms`} class="text-[#D4D8DC] hover:text-white underline">
        <span class="rt-lang rt-lang-ru">Условия сервиса</span>
        <span class="rt-lang rt-lang-uz">Foydalanish shartlari</span>
        <span class="rt-lang rt-lang-en">Terms</span>
      </a>
      <span>
        © 2026 {globalData.companyName}.
      </span>
    </div>
  </div>
</footer>
