---
/**
 * FAQ accordion (<details>/<summary>). All texts come from the CMS via props —
 * the page also builds the matching schema.org FAQPage from the same items.
 */
import I18nText from './I18nText.astro';

interface I18n { ru: string; uz?: string; en?: string }
export interface FaqItem {
  q: string;
  q_uz?: string;
  q_en?: string;
  a: string;
  a_uz?: string;
  a_en?: string;
}
interface Props {
  badge: I18n;
  title: I18n;
  subtitle?: I18n;
  note?: I18n;
  items: FaqItem[];
}

const { badge, title, subtitle, note, items = [] } = Astro.props;
---

<div class="hud-glass-card p-6 lg:p-8 font-mono">
  <div class="border-b border-[#0A0A0A] pb-3 mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
    <div>
      <span class="bg-[#0A0A0A] text-white px-2 py-0.5 text-xs font-bold mr-2 inline-block">
        <I18nText ru={badge.ru} uz={badge.uz} en={badge.en} />
      </span>
      <h2 class="text-xl sm:text-2xl font-bold text-[#0A0A0A] inline-block align-middle font-sans">
        <I18nText ru={title.ru} uz={title.uz} en={title.en} />
      </h2>
    </div>
    {note && (
      <div class="text-xs text-[#4A5056]">
        <I18nText ru={note.ru} uz={note.uz} en={note.en} />
      </div>
    )}
  </div>

  {subtitle && (
    <p class="text-xs text-[#4A5056] font-sans leading-relaxed mb-6 max-w-3xl">
      <I18nText ru={subtitle.ru} uz={subtitle.uz} en={subtitle.en} />
    </p>
  )}

  <div class="divide-y divide-[#0A0A0A]/30 border border-[#0A0A0A]">
    {items.map((item, idx) => (
      <details class="group bg-[#C8CDD2]/60 open:bg-white transition-colors">
        <summary class="p-4 cursor-pointer list-none flex items-center justify-between gap-4 font-sans text-sm font-bold text-[#0A0A0A] hover:bg-[#C8CDD2] select-none">
          <div class="flex items-center space-x-3">
            <span class="font-mono text-xs border border-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5 shrink-0">
              Q{idx + 1 < 10 ? `0${idx + 1}` : idx + 1}
            </span>
            <span>
              <I18nText ru={item.q} uz={item.q_uz} en={item.q_en} />
            </span>
          </div>
          <span class="font-mono text-base font-bold text-[#0A0A0A] transition-transform duration-200 group-open:rotate-45 shrink-0" aria-hidden="true">
            +
          </span>
        </summary>
        <div class="px-4 pb-4 pt-1 font-sans text-xs text-[#4A5056] leading-relaxed border-t border-[#0A0A0A]/10 bg-white">
          <div class="pl-8 border-l-2 border-[#0A0A0A]">
            <I18nText ru={item.a} uz={item.a_uz} en={item.a_en} />
          </div>
        </div>
      </details>
    ))}
  </div>
</div>
