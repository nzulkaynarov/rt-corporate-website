---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { GlobalLeadManager } from '../components/islands/GlobalLeadManager';
import globalData from '../data/cms/global.json';
import { withBase } from '../utils/url';
import { LANGS, LANG_META, DEFAULT_LANG, alternateHrefs, localeHref, pick } from '../i18n';
import { t } from '../i18n/ui';
import { pageSeo, siteSeo, absoluteUrl } from '../utils/seo';

interface Crumb {
  /** Already localized label */
  name: string;
  /** Site route, e.g. '/catalog/' (localized automatically) */
  path: string;
}

interface Props {
  /** Localized <title>. Use pageSeo()/entrySeo() from src/utils/seo.ts — never hardcode. */
  title?: string;
  description?: string;
  /** Social preview image (asset path or absolute URL) */
  image?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  /** Breadcrumb trail after «Home» → rendered as schema.org BreadcrumbList */
  breadcrumbs?: Crumb[];
  /** Extra page-specific schema.org nodes (Product, Article, Service, FAQPage…) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const lang = Astro.locals.lang;
const site = siteSeo(lang);
const fallback = pageSeo('home', lang);
const {
  title = fallback.title,
  description = fallback.description,
  image,
  ogType = 'website',
  noindex = false,
  breadcrumbs = [],
  jsonLd,
} = Astro.props;

const g = globalData as Record<string, any>;
const L = (field: string) => pick(lang, g[field] ?? '', g[`${field}_uz`], g[`${field}_en`]);

const siteUrl = Astro.site;
const alternates = alternateHrefs(Astro.url.pathname);
const canonicalURL = absoluteUrl(alternates[lang], siteUrl);
const homeUrl = absoluteUrl(localeHref('/', lang), siteUrl);
const orgId = `${absoluteUrl('/', siteUrl)}#organization`;
const ogImageUrl = absoluteUrl(withBase(image || site.defaultImage), siteUrl);
const isPng = /\.png($|\?)/i.test(ogImageUrl);

const sameAs = [g.telegramUrl, g.b2bPortalUrl].filter(Boolean);
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: g.brandName || g.companyName,
    legalName: L('fullName') || L('companyName'),
    description: site.organizationDescription,
    url: absoluteUrl('/', siteUrl),
    telephone: g.phone,
    email: g.emailGeneral,
    taxID: g.inn || g.taxId,
    ...(g.vatNumber ? { vatID: g.vatNumber } : {}),
    address: {
      '@type': 'PostalAddress',
      streetAddress: L('address'),
      addressLocality: L('city'),
      addressRegion: L('region'),
      postalCode: g.postalCode,
      addressCountry: g.countryCode || 'UZ',
    },
    ...(g.latitude && g.longitude ? { location: { '@type': 'Place', geo: { '@type': 'GeoCoordinates', latitude: g.latitude, longitude: g.longitude } } } : {}),
    ...(sameAs.length ? { sameAs } : {}),
    knowsAbout: site.knowsAbout,
  },
  {
    '@type': 'WebSite',
    '@id': `${homeUrl}#website`,
    url: homeUrl,
    name: site.siteName,
    inLanguage: LANG_META[lang].hreflang,
    publisher: { '@id': orgId },
  },
];
if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: t(lang, 'nav.home'), path: '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: absoluteUrl(localeHref(c.path, lang), siteUrl),
    })),
  });
}
if (jsonLd) graph.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
---

<!doctype html>
<html lang={LANG_META[lang].hreflang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && (
      <>
        <link rel="canonical" href={canonicalURL} />
        {LANGS.map((code) => (
          <link rel="alternate" hreflang={LANG_META[code].hreflang} href={absoluteUrl(alternates[code], siteUrl)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates[DEFAULT_LANG], siteUrl)} />
      </>
    )}

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    {g.latitude && g.longitude && (
      <>
        <meta name="geo.region" content={`${g.countryCode || 'UZ'}-TK`} />
        <meta name="geo.placename" content={L('city')} />
        <meta name="geo.position" content={`${g.latitude};${g.longitude}`} />
        <meta name="ICBM" content={`${g.latitude}, ${g.longitude}`} />
      </>
    )}

    <!-- Open Graph & Social -->
    <meta property="og:type" content={ogType === 'product' ? 'website' : ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImageUrl} />
    {isPng && <meta property="og:image:type" content="image/png" />}
    {isPng && <meta property="og:image:width" content="1200" />}
    {isPng && <meta property="og:image:height" content="630" />}
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:locale" content={LANG_META[lang].ogLocale} />
    {LANGS.filter((code) => code !== lang).map((code) => (
      <meta property="og:locale:alternate" content={LANG_META[code].ogLocale} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />

    <!-- Legacy ?lang=uz|en links (old language switcher) → real language URL -->
    <script is:inline define:vars={{ alternates }}>
      try {
        var legacy = new URLSearchParams(window.location.search).get('lang');
        if (legacy && alternates[legacy] && window.location.pathname !== alternates[legacy]) {
          window.location.replace(alternates[legacy] + window.location.hash);
        }
      } catch (e) {}
    </script>
  </head>
  <body class="bg-[#D4D8DC] text-[#0A0A0A] font-sans antialiased min-h-screen flex flex-col selection:bg-[#0A0A0A] selection:text-white">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <GlobalLeadManager client:load lang={lang} />

    <script is:inline>
      // Self-drawing step dividers on scroll
      (function() {
        if (typeof window === 'undefined') return;
        var initDividers = function() {
          var dividers = document.querySelectorAll('.hud-step-divider-container');
          if (!dividers.length) return;
          if ('IntersectionObserver' in window) {
            var obs = new IntersectionObserver(function(entries) {
              entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-drawn');
                  obs.unobserve(entry.target);
                }
              });
            }, { threshold: 0.1 });
            dividers.forEach(function(el) { obs.observe(el); });
          } else {
            dividers.forEach(function(el) { el.classList.add('is-drawn'); });
          }
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initDividers);
        } else {
          initDividers();
        }
      })();
    </script>
  </body>
</html>
