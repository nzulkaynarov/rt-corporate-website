---
/**
 * Page shell: <head> (SEO, canonical, hreflang, Open Graph, JSON-LD), skip link, Header, <main>, Footer.
 * Fonts are self-hosted (@fontsource) — the site makes no third-party requests and sets no cookies.
 */
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/golos-text/400.css';
import '@fontsource/golos-text/500.css';
import '@fontsource/golos-text/600.css';
import '../styles/global.css';
// Every face used on screen is preloaded (src/utils/fonts.ts), so text never jumps when a font arrives.
import { PRELOAD_FONTS } from '../utils/fonts';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { company, telegramUrl } from '../utils/company';
import { withBase } from '../utils/url';
import { LANGS, LANG_META, DEFAULT_LANG, alternateHrefs, localeHref, tField } from '../i18n';
import { t } from '../i18n/ui';
import { pageSeo, siteSeo, absoluteUrl } from '../utils/seo';
import stage from '../data/content-stage.json';

interface Crumb {
  /** Already localized label */
  name: string;
  /** Site route, e.g. '/services/' (localized automatically) */
  path: string;
}

interface Props {
  /** Localized <title>: use pageSeo()/entrySeo() from src/utils/seo.ts — never hardcode. */
  title?: string;
  description?: string;
  /** Social preview image (asset path or absolute URL) */
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Breadcrumb trail after «Главная» → schema.org BreadcrumbList */
  breadcrumbs?: Crumb[];
  /** Extra schema.org nodes (Article, Service, FAQPage…) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Override language-switcher targets (404 has no per-language twin). */
  langLinks?: Record<'ru' | 'uz' | 'en', string>;
}

const lang = Astro.locals.lang;
const site = siteSeo(lang);
const fallback = pageSeo('home', lang);
const { title = fallback.title, description = fallback.description, image, ogType = 'website', noindex: noindexProp = false, breadcrumbs = [], jsonLd, langLinks } = Astro.props;
// RU-first stage (src/data/content-stage.json): UZ/EN pages still show Russian text, so they are kept out of search
// and RU pages do not announce them as alternates until the translation pass.
const ruOnly = stage.ruOnly === true;
const noindex = noindexProp || (ruOnly && lang !== DEFAULT_LANG);
const hreflangs = ruOnly ? [DEFAULT_LANG] : LANGS;

const siteUrl = Astro.site;
const alternates = alternateHrefs(Astro.url.pathname);
const canonicalURL = absoluteUrl(alternates[lang], siteUrl);
const homeUrl = absoluteUrl(localeHref('/', lang), siteUrl);
const orgId = `${absoluteUrl('/', siteUrl)}#organization`;
const ogImageUrl = absoluteUrl(withBase(image || site.defaultImage), siteUrl);
const isPng = /\.png($|\?)/i.test(ogImageUrl);
const tg = telegramUrl();

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: company.brandName,
    legalName: tField(company, 'fullName', lang),
    description: site.organizationDescription,
    url: absoluteUrl('/', siteUrl),
    logo: absoluteUrl(withBase(company.logo), siteUrl),
    telephone: company.phone,
    email: company.email,
    taxID: company.inn,
    foundingDate: company.foundedYear,
    address: {
      '@type': 'PostalAddress',
      streetAddress: tField(company, 'legalAddress', lang),
      addressLocality: tField(company, 'city', lang),
      addressCountry: company.countryCode,
    },
    location: {
      '@type': 'Place',
      address: { '@type': 'PostalAddress', streetAddress: tField(company, 'officeAddress', lang), addressLocality: tField(company, 'city', lang), addressCountry: company.countryCode },
    },
    ...(tg ? { sameAs: [tg.split('?')[0]] } : {}),
    knowsAbout: site.knowsAbout,
  },
  { '@type': 'WebSite', '@id': `${homeUrl}#website`, url: homeUrl, name: site.siteName, inLanguage: LANG_META[lang].hreflang, publisher: { '@id': orgId } },
];
if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: t(lang, 'nav.home'), path: '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: absoluteUrl(localeHref(c.path, lang), siteUrl),
    })),
  });
}
if (jsonLd) graph.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
---

<!doctype html>
<html lang={LANG_META[lang].hreflang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {PRELOAD_FONTS.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && (
      <>
        <link rel="canonical" href={canonicalURL} />
        {hreflangs.map((code) => <link rel="alternate" hreflang={LANG_META[code].hreflang} href={absoluteUrl(alternates[code], siteUrl)} />)}
        <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates[DEFAULT_LANG], siteUrl)} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="theme-color" content="#2d3e50" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImageUrl} />
    {isPng && <meta property="og:image:type" content="image/png" />}
    {isPng && <meta property="og:image:width" content="1200" />}
    {isPng && <meta property="og:image:height" content="630" />}
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:locale" content={LANG_META[lang].ogLocale} />
    {hreflangs.filter((code) => code !== lang).map((code) => <meta property="og:locale:alternate" content={LANG_META[code].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />

    <!-- Legacy ?lang=uz|en links (v1 language switcher) → real language URL -->
    <script is:inline define:vars={{ alternates }}>
      try {
        var legacy = new URLSearchParams(window.location.search).get('lang');
        if (legacy && alternates[legacy] && window.location.pathname !== alternates[legacy]) window.location.replace(alternates[legacy] + window.location.hash);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip.toMain')}</a>
    <Header alternates={langLinks} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
