---
/**
 * GitHub Pages serves this page for ANY missing URL. Russian page; a visitor of /uz/… or /en/… is sent to /uz/404/
 * or /en/404/ (src/pages/[...lang]/404.astro) so the header, menu and footer are in their language.
 */
import NotFound from '../components/NotFound.astro';
---

<NotFound />

<script>
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const lang = location.pathname.slice(base.length).match(/^\/(uz|en)\//)?.[1];
  if (lang) location.replace(`${base}/${lang}/404/`);
</script>
