---
/**
 * GitHub Pages serves this page for ANY missing URL (/…, /uz/…, /en/…): the message and the links are
 * shown in all three languages (each block has its own lang). Texts: pages.json → notFound.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import pages from '../data/cms/pages.json';
import { LANGS, LANG_META, localeHref, tField } from '../i18n';
import { t } from '../i18n/ui';
import { pageSeo } from '../utils/seo';

const seo = pageSeo('notFound', 'ru');
const homeLinks = { ru: localeHref('/', 'ru'), uz: localeHref('/', 'uz'), en: localeHref('/', 'en') };
const nf = pages.notFound as Record<string, string>;
const blocks = LANGS.map((code) => ({
  code,
  hreflang: LANG_META[code].hreflang,
  title: tField(nf, 'title', code),
  text: tField(nf, 'text', code),
  home: localeHref('/', code),
  homeLabel: t(code, 'nav.home'),
  services: localeHref('/services/', code),
  servicesLabel: t(code, 'nav.services'),
  contacts: localeHref('/contacts/', code),
  contactsLabel: t(code, 'nav.contacts'),
}));
const [first, ...rest] = blocks;
const uniqueRest = rest.filter((b) => b.title !== first.title);
---

<BaseLayout title={seo.title} description={seo.description} noindex langLinks={homeLinks}>
  <section class="wrap nf">
    <div lang={first.hreflang} class="nf__main">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1>{first.title}</h1>
      <p class="muted">{first.text}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={first.home}>{first.homeLabel}</a>
        <a class="btn btn--outline" href={first.services}>{first.servicesLabel}</a>
        <a class="btn btn--outline" href={first.contacts}>{first.contactsLabel}</a>
      </div>
    </div>
    {uniqueRest.map((b) => (
      <div lang={b.hreflang} class="nf__alt">
        <p><b>{b.title}.</b> {b.text}</p>
        <a href={b.home}>{b.homeLabel} →</a>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: 72px 96px;
    display: grid;
    gap: 28px;
    max-width: 860px;
  }
  .nf__main {
    display: grid;
    gap: 18px;
  }
  .nf__code {
    font: 800 96px/1 var(--f-display);
    color: var(--c-brand-mid);
  }
  h1 {
    font-size: 40px;
    font-weight: 800;
  }
  .nf__alt {
    border-top: 1px solid var(--c-line);
    padding-top: 16px;
    color: var(--c-muted);
  }
  @media (max-width: 760px) {
    .nf__code {
      font-size: 64px;
    }
    h1 {
      font-size: 28px;
    }
  }
</style>
