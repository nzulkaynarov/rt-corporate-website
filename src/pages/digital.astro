---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SmartMatchAiTester } from '../components/islands/SmartMatchAiTester';
import { CadInspector } from '../components/islands/CadInspector';
import I18nText from '../components/I18nText.astro';

const digitalProducts = await getCollection('digital');
digitalProducts.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="RailTech Digital — B2B платформа b2b.railtech.uz, Smart Match AI и заказное ПО"
  description="Цифровая экосистема ООО «RailTech»: оптовый портал b2b.railtech.uz, алгоритм парсинга спецификаций Smart Match AI (98.4%), система WMS для ЖД складов и заказная разработка ERP/B2B платформ."
  keywords="b2b railtech uz, smart match ai, парсинг спецификаций 1с, разработка b2b порталов ташкент, железнодорожный софт узбекистан, wms для металла"
>
  <div class="max-w-7xl mx-auto px-4 py-10 font-sans">
    <!-- Breadcrumbs -->
    <div class="flex items-center space-x-2 font-mono text-xs text-[#4A5056] mb-4">
      <a href={`${base}/`} class="hover:underline">
        <I18nText ru="ГЛАВНАЯ" uz="BOSH SAHIFA" en="HOME" />
      </a>
      <span>/</span>
      <span class="text-[#0A0A0A] font-bold">
        <I18nText ru="DIGITAL & ПО (.DIGITAL)" uz="DIGITAL VA DASTURIY TA'MINOT (.DIGITAL)" en="DIGITAL & SOFTWARE (.DIGITAL)" />
      </span>
    </div>

    <!-- Header Section -->
    <div class="hud-glass-card p-3 mb-6 flex items-center justify-between font-mono text-xs">
      <span class="hud-callout"><i></i><I18nText ru="DIGITAL РАЗДЕЛ ОБЪЕДИНЕН В ЕДИНЫЙ ХАБ УСЛУГ" uz="DIGITAL BO'LIMI YAGONA XIZMATLAR BO'LIMIGA BIRLASHTIRILDI" en="DIGITAL MERGED INTO UNIFIED SERVICES HUB" /></span>
      <a href={`${base}/services/custom-software/`} class="font-bold underline hover:no-underline">
        <I18nText ru="ПАСПОРТ IT-УСЛУГИ ↗" uz="IT-XIZMATI PASPORTI ↗" en="VIEW IT SERVICE PASSPORT ↗" />
      </a>
    </div>

    <div class="border-b-2 border-[#0A0A0A] pb-6 mb-8">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs mb-3">
        <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-2 py-0.5 font-bold inline-block">
          <I18nText ru="IT & INDUSTRIAL AI" uz="IT VA SANOAT AI" en="IT & INDUSTRIAL AI" />
        </span>
        <span class="border border-[#0A0A0A] bg-[#C8CDD2] px-2 py-0.5 text-[#0A0A0A] inline-block">
          B2B.RAILTECH.UZ
        </span>
        <span class="border border-emerald-600 bg-emerald-100 text-emerald-900 px-2 py-0.5 font-bold inline-block">
          <I18nText ru="ТОЧНОСТЬ NLP: 98.4%" uz="NLP ANIKLIGI: 98.4%" en="NLP ACCURACY: 98.4%" />
        </span>
      </div>

      <I18nText
        as="h1"
        class="text-3xl sm:text-4xl font-bold text-[#0A0A0A] tracking-tight mb-3"
        ru="RAILTECH DIGITAL: ЦИФРОВЫЕ ПРОДУКТЫ И ЗАКАЗНАЯ РАЗРАБОТКА"
        uz="RAILTECH DIGITAL: RAQAMLI MAHSULOTLAR VA BUYURTMA DASTURIY TA'MINOT"
        en="RAILTECH DIGITAL: DIGITAL PRODUCTS & CUSTOM ENGINEERING"
      />

      <I18nText
        as="p"
        class="text-base text-[#4A5056] max-w-3xl leading-relaxed"
        ru="Собственное IT-подразделение ООО «RailTech» разрабатывает программные решения на стыке промышленной логистики, железнодорожных стандартов и искусственного интеллекта. Мы оцифровываем закупки тяжелого машиностроения, исключая человеческие ошибки при сверке ГОСТов и номенклатур."
        uz="«RailTech» MChJ ning shaxsiy IT-bo'linmasi sanoat logistikasi, temir yo'l standartlari va sun'iy intellekt tutashuvida dasturiy yechimlarni ishlab chiqadi. Biz og'ir mashinasozlik xaridlarini raqamlashtiramiz, GOSTlar va nomenklaturalarni solishtirishda inson xatolarini butunlay yo'qotamiz."
        en="RailTech's proprietary IT division engineers specialized software solutions bridging heavy industrial supply chains, railway standards, and artificial intelligence. We digitalize procurement, eliminating human errors in cross-referencing GOST standards and part catalogs."
      />
    </div>

    <!-- Top Two-Column Grid: CAD + Value Proposition -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12 items-start">
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <div class="border-2 border-[#0A0A0A] bg-[#C8CDD2] p-6 font-mono">
          <div class="text-xs font-bold text-[#0A0A0A] border-b border-[#0A0A0A] pb-2 mb-4">
            <I18nText
              ru="АРХИТЕКТУРНЫЕ ОСОБЕННОСТИ ПЛАТФОРМЫ B2B.RAILTECH.UZ:"
              uz="B2B.RAILTECH.UZ PLATFORMASINING ARXITEKTURA XUSUSIYATLARI:"
              en="B2B.RAILTECH.UZ PLATFORM ARCHITECTURAL HIGHLIGHTS:"
            />
          </div>
          <div class="space-y-4 text-xs">
            <div class="flex items-start space-x-3">
              <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5 font-bold">01</span>
              <div>
                <span class="font-bold text-[#0A0A0A] block">
                  <I18nText ru="ПРЯМОЙ СКЛАДСКОЙ ОСТАТОК 24/7" uz="TO'G'RIDAN-TO'G'RI OMBOR QOLDIG'I 24/7" en="REAL-TIME INVENTORY VISIBILITY 24/7" />
                </span>
                <span class="text-[#4A5056]">
                  <I18nText ru="Клиенты видят фактическое наличие на складе Index B2-2097 и резервы в реальном времени." uz="Mijozlar Index B2-2097 omboridagi haqiqiy mavjudlikni va bronlarni real vaqtda ko'radilar." en="Clients inspect live physical stock at Index B2-2097 terminal and active warehouse reservations." />
                </span>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5 font-bold">02</span>
              <div>
                <span class="font-bold text-[#0A0A0A] block">
                  <I18nText ru="АВТОМАТИЧЕСКАЯ ГЕНЕРАЦИЯ СЧЕТОВ С НДС 12%" uz="12% QQS BILAN HISOB-FAKTURALARNI AVTOMATIK YARATISH" en="AUTOMATED INVOICE GENERATION WITH 12% VAT" />
                </span>
                <span class="text-[#4A5056]">
                  <I18nText ru="Мгновенное формирование договора поставки и счета на оплату без ожидания ответа менеджера." uz="Menejer javobini kutmasdan yetkazib berish shartnomasi va to'lov hisobini bir zumda shakllantirish." en="Instant contract and invoice generation without waiting for account manager response." />
                </span>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5 font-bold">03</span>
              <div>
                <span class="font-bold text-[#0A0A0A] block">
                  <I18nText ru="ИНТЕГРАЦИЯ С 1C:ПРЕДПРИЯТИЕ И DIDOX" uz="1C:KORXONA VA DIDOX BILAN INTEGRATSIYA" en="INTEGRATION WITH 1C:ENTERPRISE & DIDOX" />
                </span>
                <span class="text-[#4A5056]">
                  <I18nText ru="Двусторонняя синхронизация номенклатурных справочников, остатков и закрывающих электронных актов." uz="Nomenklatura ma'lumotnomalari, qoldiqlar va yakuniy elektron dalolatnomalarni ikki tomonlama sinxronlashtirish." en="Bi-directional synchronization of part catalogs, stock balances, and electronic closing documents." />
                </span>
              </div>
            </div>
          </div>

          <div class="pt-5 mt-5 border-t border-[#0A0A0A]/20 flex flex-wrap gap-3">
            <a
              href="https://b2b.railtech.uz"
              target="_blank"
              rel="noopener noreferrer"
              class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-4 py-2 font-bold hover:bg-transparent hover:text-[#0A0A0A] transition-colors"
            >
              <I18nText ru="ВОЙТИ НА ПЛАТФОРМУ B2B.RAILTECH.UZ ↗" uz="B2B.RAILTECH.UZ PLATFORMASIGA KIRISH ↗" en="ENTER B2B.RAILTECH.UZ PORTAL ↗" />
            </a>
            <button
              type="button"
              data-lead-modal
              data-lead-subject="Запрос доступа к платформе b2b.railtech.uz"
              class="border border-[#0A0A0A] bg-white text-[#0A0A0A] px-4 py-2 font-bold hover:bg-[#0A0A0A] hover:text-white transition-colors cursor-pointer"
            >
              <I18nText ru="[ ЗАПРОСИТЬ ДОСТУП И ЛИМИТЫ ]" uz="[ KIRISH HUQUQI VA LIMITLARNI SO'RASH ]" en="[ REQUEST WHOLESALE ACCESS ]" />
            </button>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5">
        <CadInspector
          client:load
          modelType="network"
          title="ТОПОЛОГИЯ ДАННЫХ B2B-СЕТИ"
          titleUz="B2B TARMOG'I MA'LUMOTLAR TOPOLOGIYASI"
          titleEn="B2B NETWORK DATA TOPOLOGY"
          subtitle="НЕЙРОСЕТЕВОЙ ГРАФ СВЯЗЕЙ ГОСТ И ТН ВЭД"
          subtitleUz="GOST VA TQI TH O'ZARO BOG'LIQLIK NEYROTARMOQ GRAFI"
          subtitleEn="NEURAL GRAPH OF GOST & HS CODE CORRELATIONS"
        />
      </div>
    </div>

    <!-- Section: Smart Match AI Interactive Sandbox -->
    <div class="mb-16">
      <div class="border-b-2 border-[#0A0A0A] pb-3 mb-6 font-mono">
        <span class="bg-[#0A0A0A] text-white px-2 py-0.5 text-xs font-bold mr-2 inline-block">
          <I18nText ru="ДЕМОНСТРАЦИОННЫЙ СТЕНД" uz="NAMOYISH STENDI" en="DEMO SANDBOX" />
        </span>
        <span class="font-bold text-base text-[#0A0A0A]">
          <I18nText ru="ТЕСТИРОВАНИЕ АЛГОРИТМА SMART MATCH AI" uz="SMART MATCH AI ALGORITMINI SINOVDAN O'TKAZISH" en="SMART MATCH AI ALGORITHM INTERACTIVE TESTBENCH" />
        </span>
      </div>

      <SmartMatchAiTester client:load />
    </div>

    <!-- Section: Products & Custom Dev Showcase -->
    <div class="border-b-2 border-[#0A0A0A] pb-4 mb-8">
      <div class="font-mono text-xs font-bold text-[#0A0A0A] uppercase tracking-wider">
        <I18nText ru="ПРОДУКТОВЫЙ ПОРТФЕЛЬ И IT-УСЛУГИ" uz="MAHSULOTLAR PORTFELI VA IT-XIZMATLAR" en="PRODUCT PORTFOLIO & IT SERVICES" />
      </div>
      <I18nText
        as="h2"
        class="text-2xl font-bold text-[#0A0A0A] mt-1"
        ru="СОБСТВЕННЫЕ IT-ПРОДУКТЫ И ЗАКАЗНАЯ РАЗРАБОТКА"
        uz="XUSUSIY IT-MAHSULOTLAR VA BUYURTMA ASOSIDA ISHLAB CHIQISH"
        en="PROPRIETARY IT PRODUCTS & CUSTOM ENGINEERING"
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {digitalProducts.map((prod) => (
        <div class="border-2 border-[#0A0A0A] bg-[#D4D8DC] p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between font-mono text-xs border-b border-[#0A0A0A]/30 pb-2 mb-3">
              <span class="font-bold text-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5">{prod.data.code}</span>
              <span class="text-[#4A5056] text-[10px]">
                <I18nText ru={prod.data.tag} uz={prod.data.tag_uz} en={prod.data.tag_en} />
              </span>
            </div>

            <h3 class="font-sans font-bold text-base text-[#0A0A0A] mb-2 leading-snug">
              <I18nText ru={prod.data.title} uz={prod.data.title_uz} en={prod.data.title_en} />
            </h3>

            <p class="text-xs text-[#4A5056] leading-relaxed mb-4">
              <I18nText ru={prod.data.subtitle} uz={prod.data.subtitle_uz} en={prod.data.subtitle_en} />
            </p>
          </div>

          <div class="pt-3 border-t border-[#0A0A0A]/20 font-mono text-[11px] text-[#0A0A0A] space-y-1 bg-[#C8CDD2]/50 p-2.5">
            {prod.data.metrics.map((metric, idx) => {
              const metricUz = prod.data.metrics_uz && prod.data.metrics_uz[idx];
              const metricEn = prod.data.metrics_en && prod.data.metrics_en[idx];
              return (
                <div>• <I18nText ru={metric} uz={metricUz} en={metricEn} /></div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- Section: Custom Dev CTA Banner -->
    <div class="border-2 border-[#0A0A0A] bg-[#C8CDD2] p-8 font-mono flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <div class="text-sm font-bold text-[#0A0A0A] flex items-center space-x-2">
          <span class="w-3 h-3 bg-[#0A0A0A] inline-block"></span>
          <span>
            <I18nText
              ru="НУЖНА ЗАКАЗНАЯ РАЗРАБОТКА ERP / WMS / B2B-ПОРТАЛА?"
              uz="BUYURTMA ERP / WMS / B2B-PORTAL ISHLAB CHIQISH KERAKMI?"
              en="NEED CUSTOM ERP / WMS / B2B PORTAL ENGINEERING?"
            />
          </span>
        </div>
        <p class="text-xs text-[#4A5056] font-sans leading-relaxed">
          <I18nText
            ru="Команда инженеров RailTech Digital проектирует и внедряет индивидуальные программные комплексы для логистических операторов, складов ответственного хранения и производителей."
            uz="RailTech Digital muhandislar jamoasi logistika operatorlari, saqlash omborlari va ishlab chiqaruvchilar uchun maxsus dasturiy majmualarni loyihalashtiradi va joriy qiladi."
            en="The RailTech Digital engineering team designs and delivers custom software suites for logistics operators, industrial warehouses, and manufacturing plants."
          />
        </p>
      </div>

      <button
        type="button"
        data-lead-modal
        data-lead-subject="Запрос на заказную разработку ПО / WMS / B2B портала"
        class="border-2 border-[#0A0A0A] bg-[#0A0A0A] text-white px-8 py-3.5 text-xs font-bold whitespace-nowrap hover:bg-transparent hover:text-[#0A0A0A] transition-colors cursor-pointer"
      >
        <I18nText
          ru="[ ОБСУДИТЬ IT-ПРОЕКТ ]"
          uz="[ IT-LOYIHANI MUHOKAMA QILISH ]"
          en="[ DISCUSS IT PROJECT ]"
        />
      </button>
    </div>
  </div>
</BaseLayout>
