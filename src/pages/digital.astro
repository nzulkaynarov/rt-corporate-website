---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/services/custom-software/`;
return Astro.redirect(target, 301);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Перенаправление в раздел IT-услуги и ПО — ООО «RailTech»</title>
  </head>
  <body>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
    <p>Перенаправление в раздел <a href={target}>IT-услуги и ПО</a>...</p>
  </body>
</html>
