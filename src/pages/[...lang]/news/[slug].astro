---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import Lightbox from '../../../components/ui/Lightbox.astro';
import RelatedMaterials from '../../../components/ui/RelatedMaterials.astro';
import ArticleAside from '../../../components/ui/ArticleAside.astro';
import CtaBand from '../../../components/ui/CtaBand.astro';
import { getCollection } from 'astro:content';
import { getFeed, getPartners, materialsOfPartner, relatedTo, servicesOf, type FeedItem } from '../../../utils/feed';
import { expandLangs, facts, fillFacts, localeHref, localize, tField } from '../../../i18n';
import { t } from '../../../i18n/ui';
import { formatDate } from '../../../utils/format';
import { liftHeadings, renderBody, withToc } from '../../../utils/markdown';
import { entrySeo, absoluteUrl } from '../../../utils/seo';
import { withBase } from '../../../utils/url';
import { ogImagePath } from '../../../utils/og';
import { entryContentLang, entryLangs } from '../../../utils/stage';

export async function getStaticPaths() {
  const feed = await getFeed();
  return expandLangs(feed.map((entry) => ({ params: { slug: entry.slug }, props: { entry } })));
}
interface Props {
  /** A news entry or a partner article (src/utils/feed.ts). */
  entry: FeedItem;
}
const lang = Astro.locals.lang;
const { entry } = Astro.props;
// Content language: the page language when this material is translated, otherwise RU (src/utils/stage.ts → entryLangs);
// an untranslated page is noindex and announces only the locales it exists in. The UI stays in `lang`.
const langs = entryLangs('news', entry.data, entry.body);
const cl = entryContentLang(lang, 'news', entry.data, entry.body);
// RU at the root, translations in the uz/en blocks (src/i18n/blocks.mjs): one localized view of the entry.
const d = localize(entry.data, cl) as Record<string, any>;
const title = tField(d, 'title', cl) as string;
const localizedBody = cl === 'ru' ? undefined : (entry.data as Record<string, any>)[cl]?.body;
const { html: bodyHtml, toc } = withToc(liftHeadings(await renderBody(fillFacts(localizedBody || entry.body, facts(lang)), lang)));
const seo = entrySeo(d, cl, entry.body);
const gallery: { image: string; alt: string }[] = (d.gallery || []).map((g: Record<string, string>) => ({ image: g.image, alt: tField(g, 'alt', cl) || '' }));

// Recommendations are computed (src/utils/feed.ts): a partner page lists the materials naming the partner,
// any other material shows those with the same partners, then the same services, then the newest.
const feed = await getFeed();
const partnerId = entry.partnerId;
const related = partnerId ? materialsOfPartner(partnerId, feed) : relatedTo(entry, feed);
const relatedTitle = partnerId ? t(lang, 'news.partnerMaterials') : t(lang, 'news.related');
// Partner header: tile data of the same record, in the page language.
const partner = partnerId ? localize(entry.data, lang) : undefined;
const partnerLegal = partner && partner.legalName !== partner.name ? partner.legalName : '';
// Side column (src/components/ui/ArticleAside.astro): for a news item — the manufacturers and services it is about.
const allPartners = await getPartners();
const asidePartners = partnerId
  ? []
  : (d.partners || []).flatMap((id: string) => {
      const p = allPartners.find((x) => x.id === id);
      return p ? [{ label: tField(p.data, 'name', lang) as string, note: t(lang, `partner.status.${p.data.status}`), href: p.articleSlug ? localeHref(`/news/${p.articleSlug}/`, lang) : undefined }] : [];
    });
const serviceEntries = await getCollection('services');
const asideServices = servicesOf(entry).flatMap((slug) => {
  const sv = serviceEntries.find((x) => x.slug === slug);
  return sv ? [{ label: tField(sv.data, 'title', lang) as string, href: localeHref(`/services/${slug}/`, lang) }] : [];
});

const crumbs = [
  partnerId ? { name: t(lang, 'nav.partners'), path: '/partners/' } : { name: t(lang, 'nav.news'), path: '/news/' },
  { name: title, path: `/news/${entry.slug}/` },
];
const url = absoluteUrl(localeHref(`/news/${entry.slug}/`, lang), Astro.site);
// Social preview: the material's cover, otherwise a card with its title (src/pages/og/[...path].png.ts).
const shareImage: string = d.cover || ogImagePath('news', entry.slug, lang);
const jsonLd = {
  '@type': d.type === 'news' ? 'NewsArticle' : 'Article',
  headline: title,
  description: seo.description,
  datePublished: d.date,
  dateModified: d.date,
  inLanguage: cl,
  url,
  // Google requires an image for Article rich results: the cover, otherwise the generated preview card.
  image: absoluteUrl(withBase(shareImage), Astro.site),
  author: { '@id': `${absoluteUrl('/', Astro.site)}#organization` },
  publisher: { '@id': `${absoluteUrl('/', Astro.site)}#organization` },
};
---

<BaseLayout title={seo.title} description={seo.description} breadcrumbs={crumbs} jsonLd={jsonLd} ogType="article" image={shareImage} langs={langs}>
  <div class="wrap"><Breadcrumbs items={crumbs} /></div>

  <article class="wrap art" data-lightbox lang={cl !== lang ? cl : undefined}>
    <header class="art__head">
      <p class="art__meta"><b>{t(lang, `news.type.${d.type}`)}</b><time datetime={d.date}>{formatDate(d.date, lang)}</time></p>
      <h1>{title}</h1>
      <p class="art__summary">{tField(d, 'summary', cl)}</p>
    </header>
    <div class:list={['art__aside', { 'art__aside--last': !partner }]}>
      <ArticleAside
        partner={partner ? { logo: partner.logo, status: partner.status, country: partner.country, legalName: partnerLegal, group: partner.group, brands: partner.brands } : undefined}
        partners={asidePartners}
        services={partner ? [] : asideServices}
        toc={toc}
      />
    </div>
    <div class="art__body">
      {d.cover && <img class="art__cover" src={withBase(d.cover)} alt={tField(d, 'coverAlt', cl)} width="1200" height="675" />}
      <div class="prose" set:html={bodyHtml} />
      {gallery.length > 0 && (
        <section class="gallery" aria-labelledby="gallery-title">
          <h2 id="gallery-title">{t(lang, 'news.gallery.title')}</h2>
          <ul>
            {gallery.map((g, i) => (
              <li>
                <button type="button" data-lightbox-item aria-label={t(lang, 'news.gallery.open', { n: i + 1, total: gallery.length })}>
                  <img src={withBase(g.image)} alt={g.alt} loading="lazy" decoding="async" width="480" height="320" />
                </button>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
  <Lightbox />

  <RelatedMaterials title={relatedTitle} items={related} />

  <CtaBand title={t(lang, 'services.cta.title')} text={t(lang, 'services.cta.text')} />
</BaseLayout>

<style>
  /*
   * Single page (docs/DESIGN.md → «Одиночные страницы»): one column up to 1079 px; from 1080 px the text keeps its
   * reading width on the left and the side column (partner card, related links, «На странице») stays in view on
   * the right — the page uses the full content width like a service page does.
   */
  .art {
    padding-block: 28px 80px;
    display: flex;
    flex-direction: column;
  }
  .art__head {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 28px;
  }
  .art__aside {
    margin-bottom: 32px;
  }
  .art__aside:empty {
    display: none;
  }
  /* news, article, project: on one column the related links follow the text */
  .art__aside--last {
    order: 3;
    margin: 40px 0 0;
  }
  @media (min-width: 1080px) {
    .art {
      display: grid;
      grid-template-columns: minmax(0, 760px) minmax(280px, 340px);
      justify-content: space-between;
      column-gap: 64px;
      align-items: start;
    }
    .art__head,
    .art__body {
      grid-column: 1;
    }
    .art__head {
      margin-bottom: 36px;
    }
    .art__aside,
    .art__aside--last {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin: 0;
      position: sticky;
      top: calc(var(--hdr-h) + 24px);
      padding-top: 6px;
    }
  }
  .art__meta {
    display: flex;
    gap: 12px;
    font-size: 15px;
    color: var(--c-muted);
  }
  .art__meta b {
    color: var(--c-brand-ink);
    font-weight: 600;
  }
  h1 {
    font-size: var(--fs-h1);
    font-weight: 800;
  }
  .art__summary {
    font-size: var(--fs-lead);
    color: var(--c-muted);
  }
  .art__cover {
    width: 100%;
    border-radius: var(--r-md);
    margin-bottom: 36px;
  }
  .gallery {
    margin-top: 48px;
  }
  .gallery h2 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .gallery ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
  }
  .gallery button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--c-brand-soft);
  }
  .gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform var(--dur) var(--ease-out);
  }
  .gallery button:hover img {
    transform: scale(1.04);
  }
  @media (max-width: 760px) {
    .art {
      padding-block: 20px 48px;
    }
  }
</style>
