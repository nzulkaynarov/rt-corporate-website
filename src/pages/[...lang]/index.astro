---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import Bridge from '../../components/home/Bridge.astro';
import Directions from '../../components/home/Directions.astro';
import About from '../../components/home/About.astro';
import CabinetBlock from '../../components/home/CabinetBlock.astro';
import LatestNews from '../../components/home/LatestNews.astro';
import Invite from '../../components/home/Invite.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import PartnerTiles from '../../components/ui/PartnerTiles.astro';
import home from '../../data/cms/home.json';
import { langStaticPaths, tField } from '../../i18n';
import { pageSeo } from '../../utils/seo';

export const getStaticPaths = langStaticPaths;
const lang = Astro.locals.lang;
const seo = pageSeo('home', lang);
const p = home.partners as Record<string, string>;
---

<BaseLayout title={seo.title} description={seo.description}>
  <Hero />
  <Bridge />
  <Directions />
  <About />
  <section class="section" id="partners" aria-labelledby="partners-title">
    <div class="wrap">
      <SectionHead id="partners-title" eyebrow={tField(p, 'eyebrow', lang)} title={tField(p, 'title', lang)} lead={tField(p, 'note', lang)} />
      <PartnerTiles />
    </div>
  </section>
  <CabinetBlock />
  <LatestNews />
  <Invite />
</BaseLayout>
