---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import SectionHead from '../../../components/ui/SectionHead.astro';
import Faq from '../../../components/ui/Faq.astro';
import CtaBand from '../../../components/ui/CtaBand.astro';
import { expandLangs, localeHref, tField } from '../../../i18n';
import { t } from '../../../i18n/ui';
import { company } from '../../../utils/company';
import { START_PATH } from '../../../utils/nav';
import { entrySeo, absoluteUrl } from '../../../utils/seo';
import { renderBody } from '../../../utils/markdown';

export async function getStaticPaths() {
  const entries = await getCollection('services');
  return expandLangs(entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } })));
}
interface Props {
  entry: CollectionEntry<'services'>;
}
const lang = Astro.locals.lang;
const { entry } = Astro.props;
const d = entry.data as Record<string, any>;
const L = (obj: Record<string, any>, field: string) => tField(obj, field, lang) as string;
const localizedBody = lang === 'uz' ? d.body_uz : lang === 'en' ? d.body_en : undefined;
const bodyHtml = await renderBody(localizedBody || entry.body, lang);
const seo = entrySeo(d, lang, entry.body);
const title = L(d, 'title');
const audienceLabel = t(lang, `services.audience.${d.audience}`);
const faq = (d.faq || []).map((f: Record<string, string>) => ({ q: L(f, 'q'), a: L(f, 'a') }));
const others = (await getCollection('services')).filter((s) => s.slug !== entry.slug).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const crumbs = [
  { name: t(lang, 'nav.services'), path: '/services/' },
  { name: title, path: `/services/${entry.slug}/` },
];
const pageUrl = absoluteUrl(localeHref(`/services/${entry.slug}/`, lang), Astro.site);
const jsonLd: Record<string, unknown>[] = [
  { '@type': 'Service', name: title, serviceType: title, description: seo.description, url: pageUrl, areaServed: 'UZ', provider: { '@id': `${absoluteUrl('/', Astro.site)}#organization` } },
];
if (faq.length) {
  jsonLd.push({ '@type': 'FAQPage', mainEntity: faq.map((f: { q: string; a: string }) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
}
const benefitsKey = d.audience === 'partners' ? 'services.benefits.partners' : 'services.benefits.customers';
---

<BaseLayout title={seo.title} description={seo.description} breadcrumbs={crumbs} jsonLd={jsonLd}>
  <div class="wrap"><Breadcrumbs items={crumbs} /></div>

  <section class="wrap hero" aria-labelledby="svc-title">
    <div class="hero__txt">
      <p class="eyebrow">{t(lang, 'nav.services')} · {audienceLabel}</p>
      <h1 id="svc-title">{title}</h1>
      <p class="hero__lead">{L(d, 'lead')}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={localeHref(START_PATH, lang)}>{t(lang, 'cta.request')}</a>
        <a class="btn btn--outline" href={company.cabinet.loginUrl}>{t(lang, 'cta.cabinet')}</a>
      </div>
    </div>
    {d.highlights?.length > 0 && (
      <aside class="brief" aria-labelledby="brief-title">
        <h2 id="brief-title">{t(lang, 'services.highlights')}</h2>
        <dl>
          {d.highlights.map((h: any) => (
            <div><dt>{L(h, 'label')}</dt><dd>{L(h, 'value')}</dd></div>
          ))}
        </dl>
      </aside>
    )}
  </section>

  {bodyHtml && (
    <section class="section section--soft">
      <div class="wrap"><div class="prose" set:html={bodyHtml} /></div>
    </section>
  )}

  {d.steps?.length > 0 && (
    <section class="section" aria-labelledby="steps-title">
      <div class="wrap">
        <SectionHead id="steps-title" title={t(lang, 'services.steps')} />
        <ol class="flow">
          {d.steps.map((s: any, i: number) => (
            <li><em>{String(i + 1).padStart(2, '0')}</em><b>{L(s, 'title')}</b><span>{L(s, 'text')}</span></li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {d.benefits?.length > 0 && (
    <section class="section section--soft" aria-labelledby="ben-title">
      <div class="wrap">
        <SectionHead id="ben-title" title={t(lang, benefitsKey)} />
        <ul class="gets">
          {d.benefits.map((b: any) => <li><b>{L(b, 'title')}</b><span>{L(b, 'text')}</span></li>)}
        </ul>
      </div>
    </section>
  )}

  {d.requirements?.length > 0 && (
    <section class="section" aria-labelledby="req-title">
      <div class="wrap">
        <SectionHead id="req-title" title={t(lang, 'services.requirements')} />
        <ul class="req">
          {d.requirements.map((r: any) => <li><b>{L(r, 'title')}</b><span>{L(r, 'text')}</span></li>)}
        </ul>
      </div>
    </section>
  )}

  {faq.length > 0 && (
    <section class="section section--soft" aria-labelledby="faq-title">
      <div class="wrap two">
        <div>
          <SectionHead id="faq-title" title={t(lang, 'services.faq')} />
          <nav class="others" aria-label={t(lang, 'services.other')}>
            <p class="eyebrow">{t(lang, 'services.other')}</p>
            <ul>{others.map((s) => <li><a href={localeHref(`/services/${s.slug}/`, lang)}>{tField(s.data, 'title', lang)}</a></li>)}</ul>
          </nav>
        </div>
        <Faq items={faq} />
      </div>
    </section>
  )}

  <CtaBand title={t(lang, 'services.cta.title')} text={t(lang, 'services.cta.text')} />
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: 56px;
    align-items: start;
    padding-block: 28px 80px;
  }
  .hero__txt {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  h1 {
    font-size: var(--fs-h1);
    font-weight: 800;
  }
  .hero__lead {
    font-size: var(--fs-lead);
    color: var(--c-muted);
    max-width: 660px;
  }
  .brief {
    border: 1px solid var(--c-line);
    border-top: 3px solid var(--c-accent);
    border-radius: var(--r-md);
    padding: 22px 24px;
  }
  .brief h2 {
    font: 600 14px/1.2 var(--f-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-bottom: 4px;
  }
  .brief dl {
    margin: 0;
  }
  .brief div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
    border-bottom: 1px solid var(--c-line);
  }
  .brief div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .brief dt {
    font: 700 16px/1.3 var(--f-display);
  }
  .brief dd {
    margin: 0;
    font-size: 15px;
    color: var(--c-muted);
  }
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 2px solid var(--c-ink);
  }
  .flow li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 20px 0 0;
  }
  .flow em {
    font: 800 15px/1 var(--f-display);
    font-style: normal;
    color: var(--c-accent-ink);
  }
  .flow b {
    font: 700 19px/1.2 var(--f-display);
  }
  .flow span {
    font-size: 15px;
    color: var(--c-muted);
  }
  .gets,
  .req {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 28px;
  }
  .gets li,
  .req li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--c-line);
  }
  .gets b,
  .req b {
    font: 700 20px/1.25 var(--f-display);
  }
  .gets span,
  .req span {
    color: var(--c-muted);
    font-size: 16px;
  }
  .req li {
    border-top: 3px solid var(--c-brand-mid);
  }
  .two {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 64px;
    align-items: start;
  }
  .others {
    display: grid;
    gap: 10px;
  }
  .others ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .others a {
    font-weight: 600;
  }
  @media (max-width: 1080px) {
    .hero,
    .two {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .flow {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 24px;
    }
  }
  @media (max-width: 760px) {
    .hero {
      padding-block: 20px 44px;
    }
    .flow {
      grid-template-columns: minmax(0, 1fr);
      border-top: 0;
    }
    .flow li {
      display: grid;
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 2px 10px;
      padding: 12px 0;
      border-top: 1px solid var(--c-line);
    }
    .flow em {
      grid-row: span 2;
      padding-top: 3px;
    }
    .gets,
    .req {
      gap: 16px;
    }
    .gets b,
    .req b {
      font-size: 17px;
    }
  }
</style>
