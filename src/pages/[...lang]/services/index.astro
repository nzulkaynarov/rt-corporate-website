---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import SectionHead from '../../../components/ui/SectionHead.astro';
import CtaBand from '../../../components/ui/CtaBand.astro';
import pages from '../../../data/cms/pages.json';
import { langStaticPaths, localeHref, tField } from '../../../i18n';
import { t } from '../../../i18n/ui';
import { pageSeo } from '../../../utils/seo';

export const getStaticPaths = langStaticPaths;
const lang = Astro.locals.lang;
const seo = pageSeo('services', lang);
const p = pages.services as Record<string, string>;
const services = (await getCollection('services')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const groups = (['customers', 'partners'] as const).map((audience) => ({
  audience,
  title: tField(p, `${audience}Title`, lang),
  text: tField(p, `${audience}Text`, lang),
  items: services.filter((s) => s.data.audience === audience),
}));
const crumbs = [{ name: t(lang, 'nav.services'), path: '/services/' }];
---

<BaseLayout title={seo.title} description={seo.description} breadcrumbs={crumbs}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
  </div>
  <section class="wrap intro">
    <SectionHead level={1} eyebrow={tField(p, 'eyebrow', lang)} title={tField(p, 'title', lang)} lead={tField(p, 'lead', lang)} />
  </section>
  {groups.map((g, i) => (
    <section class:list={['section', { 'section--soft': i % 2 === 0 }]} aria-labelledby={`grp-${g.audience}`}>
      <div class="wrap grp">
        <div class="grp__head">
          <h2 id={`grp-${g.audience}`}>{g.title}</h2>
          <p class="muted">{g.text}</p>
        </div>
        <div class="grp__cards">
          {g.items.map((s) => (
            <a class="scard lift" href={localeHref(`/services/${s.slug}/`, lang)}>
              <b>{tField(s.data, 'title', lang)}</b>
              <span>{tField(s.data, 'summary', lang)}</span>
              <i>{t(lang, 'common.more')} →</i>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
  <CtaBand title={t(lang, 'services.cta.title')} text={t(lang, 'services.cta.text')} />
</BaseLayout>

<style>
  .intro {
    padding-block: 28px 32px;
  }
  .grp {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 48px;
    align-items: start;
  }
  .grp__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  h2 {
    font-size: var(--fs-h2);
    font-weight: 700;
  }
  .grp__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .scard {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border: 1px solid var(--c-line);
    border-top: 3px solid var(--c-accent);
    border-radius: var(--r-md);
    background: var(--c-bg);
    text-decoration: none;
    color: var(--c-ink);
  }
  .scard:hover {
    border-color: var(--c-brand-mid);
    border-top-color: var(--c-accent);
    box-shadow: var(--shadow-lift);
    color: var(--c-ink);
  }
  .scard b {
    font: 700 22px/1.2 var(--f-display);
  }
  .scard span {
    color: var(--c-muted);
  }
  .scard i {
    margin-top: auto;
    font-style: normal;
    font-weight: 600;
    color: var(--c-brand-ink);
  }
  @media (max-width: 1080px) {
    .grp {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
  @media (max-width: 760px) {
    .grp__cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .scard {
      padding: 18px;
    }
    .scard b {
      font-size: 19px;
    }
  }
</style>
