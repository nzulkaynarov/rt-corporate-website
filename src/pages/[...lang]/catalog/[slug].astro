---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ProductMediaGallery } from '../../../components/islands/ProductMediaGallery';
import I18nText from '../../../components/I18nText.astro';
import HudPageHeader from '../../../components/hud/HudPageHeader.astro';
import { withBase } from '../../../utils/url';
import { marked } from 'marked';
import globalData from '../../../data/cms/global.json';
import pagesData from '../../../data/cms/pages.json';
import { expandLangs, localeHref, pick, tField, type Lang } from '../../../i18n';
import { t } from '../../../i18n/ui';
import { entrySeo, absoluteUrl } from '../../../utils/seo';
import { navLabel, navLabels } from '../../../utils/nav';

export async function getStaticPaths() {
  const catalogEntries = await getCollection('catalog');
  const paths = catalogEntries.map((entry) => {
    const entryCat = entry.data.category || entry.data.subsystem || '';
    const related = catalogEntries
      .filter((e) => e.slug !== entry.slug)
      .sort((a, b) => {
        const aCat = a.data.category || a.data.subsystem || '';
        const bCat = b.data.category || b.data.subsystem || '';
        const aMatch = aCat === entryCat;
        const bMatch = bCat === entryCat;
        if (aMatch && !bMatch) return -1;
        if (!aMatch && bMatch) return 1;
        return 0;
      })
      .slice(0, 3);

    return {
      params: { slug: entry.slug },
      props: { entry, related },
    };
  });
  return expandLangs(paths);
}

const { entry, related } = Astro.props;
const { Content } = await entry.render();
const lang = Astro.locals.lang;
const tr = (key: string, vars?: Record<string, string | number>) => t(lang, key, vars);
const L = (obj: Record<string, any>, field: string) => tField(obj, field, lang) as string;

type CatalogData = typeof entry.data;
const data = entry.data;
const cPage = pagesData.catalogPage;
const detail = cPage.detail;

const productRoute = `/catalog/${entry.slug}/`;
const productUrl = absoluteUrl(localeHref(productRoute, lang), Astro.site);
const orgId = `${absoluteUrl('/', Astro.site)}#organization`;

/** Category with the legacy `subsystem` alias; falls back to pages.json catalogPage.defaultCategory. */
const categoryOf = (d: CatalogData) => {
  const ru = d.category || d.subsystem;
  if (!ru) return { ru: cPage.defaultCategory, uz: cPage.defaultCategory_uz, en: cPage.defaultCategory_en };
  return { ru, uz: d.category_uz || d.subsystem_uz, en: d.category_en || d.subsystem_en };
};
const category = categoryOf(data);
const categoryName = pick(lang, category.ru, category.uz, category.en);

/** Stock status: explicit status_uz/status_en override, otherwise the dictionary label for statusKey. */
const statusLabel = (d: CatalogData, l: Lang) => {
  const override = l === 'uz' ? d.status_uz : l === 'en' ? d.status_en : undefined;
  return override || t(l, `catalog.status.${d.statusKey}`);
};
const status = statusLabel(data, lang);

const title = L(data, 'title');
const warehouse = data.warehouse ? L(data, 'warehouse') : L(cPage, 'defaultWarehouse');
const warranty = data.warranty ? L(data, 'warranty') : L(cPage, 'defaultWarranty');
const priceNote = data.priceNote ? L(data, 'priceNote') : L(cPage, 'defaultPriceNote');

// Markdown body: translated body_uz / body_en when present, otherwise the RU body.
const localizedBody = lang === 'uz' ? data.body_uz : lang === 'en' ? data.body_en : undefined;
const bodyHtml = localizedBody ? await marked.parse(localizedBody) : '';

const mainImageUrl = data.image || `/images/catalog/${data.sku.toLowerCase()}.jpg`;
const seo = entrySeo(data, lang, {
  titleExtra: `(${data.sku})`,
  descriptionFields: ['specs'],
  body: localizedBody || entry.body,
});

// schema.org Offer: availability from statusKey; price only when the CMS has a real numeric price.
const availability: Record<string, string> = {
  in_stock: 'https://schema.org/InStock',
  reserved: 'https://schema.org/LimitedAvailability',
  on_order: 'https://schema.org/PreOrder',
};
const priceDigits = (data.price || '').replace(/[^\d.,]/g, '');
const priceValue = /^\d+,\d{1,2}$/.test(priceDigits) ? priceDigits.replace(',', '.') : priceDigits.replace(/,/g, '');
const hasPrice = priceValue !== '' && Number(priceValue) > 0;

const productJsonLd = {
  '@type': 'Product',
  '@id': `${productUrl}#product`,
  name: title,
  description: seo.description,
  image: absoluteUrl(withBase(mainImageUrl), Astro.site),
  url: productUrl,
  sku: data.sku,
  mpn: data.sku,
  category: categoryName,
  brand: { '@id': orgId },
  manufacturer: { '@id': orgId },
  offers: {
    '@type': 'Offer',
    url: productUrl,
    availability: availability[data.statusKey] || availability.in_stock,
    itemCondition: 'https://schema.org/NewCondition',
    seller: { '@id': orgId },
    ...(hasPrice ? { price: priceValue, priceCurrency: 'UZS' } : {}),
  },
};

const phoneHref = `tel:${globalData.phone.replace(/[\s-]/g, '')}`;
const catalogHref = localeHref('/catalog/', lang);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  image={mainImageUrl}
  ogType="product"
  breadcrumbs={[
    { name: navLabel('/catalog/', lang), path: '/catalog/' },
    { name: title, path: productRoute },
  ]}
  jsonLd={productJsonLd}
>
  <div class="max-w-7xl mx-auto px-4 pb-16 font-sans">
    <HudPageHeader
      code={tr('catalog.detail.code', { sku: data.sku })}
      parent={{ href: '/catalog/', label: navLabels('/catalog/') }}
      crumb={{ ru: data.sku, uz: data.sku, en: data.sku }}
      title={{ ru: data.title, uz: data.title_uz, en: data.title_en }}
      lead={data.specs ? { ru: data.specs, uz: data.specs_uz, en: data.specs_en } : undefined}
    />

    <!-- Status and Meta Badges Bar -->
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs mb-8">
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A] font-bold border border-[#0A0A0A]">
        {data.sku}
      </span>
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A]">
        {categoryName}
      </span>
      <span class="hud-glass-card px-2.5 py-1 text-emerald-900 font-bold bg-emerald-100/50">
        {status}
      </span>
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A]">
        <I18nText ru={detail.vatBadge} uz={detail.vatBadge_uz} en={detail.vatBadge_en} />
      </span>
      {data.price && (
        <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A] font-bold">
          {data.price}
        </span>
      )}
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Specs Table & Detailed Text -->
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <!-- Technical Specifications Table -->
        <div class="hud-glass-card p-6">
          <div class="border-b border-[#0A0A0A]/20 pb-2 mb-4 flex justify-between items-center font-mono text-xs">
            <span class="font-bold text-[#0A0A0A] tracking-wider uppercase">
              <I18nText ru={detail.specsTitle} uz={detail.specsTitle_uz} en={detail.specsTitle_en} />
            </span>
            <span class="text-[#4A5056]">{detail.specsCode}</span>
          </div>

          <table class="w-full font-mono text-xs border-collapse">
            <tbody class="divide-y divide-[#0A0A0A]/15">
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056] w-2/5">
                  <I18nText k="catalog.detail.sku" />
                </td>
                <td class="py-2.5 font-bold text-[#0A0A0A]">{data.sku}</td>
              </tr>
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056]">
                  <I18nText k="catalog.detail.category" />
                </td>
                <td class="py-2.5 text-[#0A0A0A]">
                  {categoryName}
                </td>
              </tr>
              {data.gost && (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="py-2.5 pr-3 text-[#4A5056]">
                    <I18nText k="catalog.detail.gost" />
                  </td>
                  <td class="py-2.5 font-bold text-[#0A0A0A]">{data.gost}</td>
                </tr>
              )}
              {data.tnved && (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="py-2.5 pr-3 text-[#4A5056]">
                    <I18nText k="catalog.detail.tnved" />
                  </td>
                  <td class="py-2.5 font-bold text-[#0A0A0A]">{data.tnved}</td>
                </tr>
              )}
              {data.dimensions && (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="py-2.5 pr-3 text-[#4A5056]">
                    <I18nText k="catalog.detail.dimensions" />
                  </td>
                  <td class="py-2.5 text-[#0A0A0A]">{data.dimensions}</td>
                </tr>
              )}
              {data.weight && (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="py-2.5 pr-3 text-[#4A5056]">
                    <I18nText k="catalog.detail.weight" />
                  </td>
                  <td class="py-2.5 text-[#0A0A0A]">{data.weight}</td>
                </tr>
              )}
              {data.material && (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="py-2.5 pr-3 text-[#4A5056]">
                    <I18nText k="catalog.detail.material" />
                  </td>
                  <td class="py-2.5 text-[#0A0A0A]">{data.material}</td>
                </tr>
              )}
              {/* Dynamic CMS attributes */}
              {data.attributes && data.attributes.map((attr) => (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="py-2.5 pr-3 text-[#4A5056]">
                    <I18nText ru={attr.label} uz={attr.label_uz} en={attr.label_en} />
                  </td>
                  <td class="py-2.5 font-bold text-[#0A0A0A]">
                    <I18nText ru={attr.value} uz={attr.value_uz} en={attr.value_en} />
                  </td>
                </tr>
              ))}
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056]">
                  <I18nText k="catalog.detail.warehouse" />
                </td>
                <td class="py-2.5 font-bold text-[#0A0A0A]">
                  {warehouse}
                </td>
              </tr>
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056]">
                  <I18nText k="catalog.detail.warranty" />
                </td>
                <td class="py-2.5 text-[#0A0A0A]">
                  {warranty}
                </td>
              </tr>
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056]">
                  <I18nText k="catalog.detail.priceTerms" />
                </td>
                <td class="py-2.5 font-bold text-[#0A0A0A]">
                  {priceNote}
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Detailed Description Content -->
        <div class="hud-glass-card p-6">
          <div class="border-b border-[#0A0A0A]/20 pb-2 mb-4 font-mono text-xs font-bold text-[#0A0A0A] uppercase tracking-wider">
            <I18nText ru={detail.descriptionTitle} uz={detail.descriptionTitle_uz} en={detail.descriptionTitle_en} />
          </div>
          <div class="prose prose-sm text-[#0A0A0A] max-w-none leading-relaxed">
            {bodyHtml ? <div set:html={bodyHtml} /> : <Content />}
          </div>
        </div>

        <!-- Downloadable Documentation & Files -->
        {data.documents && data.documents.length > 0 && (
          <div class="hud-glass-card p-6">
            <div class="border-b border-[#0A0A0A]/20 pb-2 mb-4 flex justify-between items-center font-mono text-xs">
              <span class="font-bold text-[#0A0A0A] tracking-wider uppercase flex items-center gap-2">
                <span class="w-2 h-2 bg-[#0A0A0A] inline-block"></span>
                <I18nText ru={detail.documentsTitle} uz={detail.documentsTitle_uz} en={detail.documentsTitle_en} />
              </span>
              <span class="text-[#4A5056]">{tr('docs.filesCount', { count: data.documents.length })}</span>
            </div>
            <div class="space-y-2.5 font-mono text-xs">
              {data.documents.map((doc) => {
                const fileUrl = doc.file.startsWith('http') ? doc.file : withBase(doc.file);
                return (
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3 border border-[#0A0A0A]/20 bg-white/40 hover:bg-white/80 transition-colors gap-2">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5 text-[10px] font-bold">DOC</span>
                      <div class="min-w-0">
                        <div class="font-bold text-[#0A0A0A] truncate">
                          <I18nText ru={doc.title} uz={doc.title_uz} en={doc.title_en} />
                        </div>
                        <div class="text-[10px] text-[#4A5056] uppercase tracking-wider">
                          {doc.type || tr('docs.typeFallback')}
                        </div>
                      </div>
                    </div>
                    {doc.file === 'https://railtech.uz' || !doc.file ? (
                      <button
                        type="button"
                        data-lead-modal
                        data-lead-subject={t('ru', 'lead.subject.catalogDatasheet', { doc: doc.title, sku: data.sku })}
                        class="hud-btn hud-btn--ghost text-[11px] py-1.5 px-3 self-start sm:self-auto text-center shrink-0 cursor-pointer"
                      >
                        <I18nText k="catalog.detail.requestDatasheet" />
                      </button>
                    ) : (
                      <a
                        href={fileUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hud-btn hud-btn--ghost text-[11px] py-1.5 px-3 self-start sm:self-auto text-center shrink-0"
                      >
                        <I18nText k="docs.download" />
                      </a>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        )}

        <!-- Completeness of Supply & Regulatory Box -->
        <div class="hud-glass-card p-5 font-mono text-xs space-y-2">
          <div class="font-bold text-[#0A0A0A] flex items-center gap-2">
            <span class="w-2 h-2 bg-[#0A0A0A] inline-block"></span>
            <I18nText ru={detail.supplyTitle} uz={detail.supplyTitle_uz} en={detail.supplyTitle_en} />
          </div>
          <div class="text-[#4A5056] space-y-1.5 text-[11px] leading-relaxed">
            {(detail.supplyItems || []).map((item: any) => (
              <div>
                <I18nText ru={item.text} uz={item.text_uz} en={item.text_en} />
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Media Gallery & Commercial Ordering Card -->
      <div class="lg:col-span-5 flex flex-col space-y-6">
        <ProductMediaGallery
          client:load
          lang={lang}
          sku={data.sku}
          title={data.title}
          title_uz={data.title_uz}
          title_en={data.title_en}
          category={category.ru}
          category_uz={category.uz}
          category_en={category.en}
          status={status}
          specs={data.specs}
          specs_uz={data.specs_uz}
          specs_en={data.specs_en}
          image={mainImageUrl}
          images={data.images}
          gallery={data.gallery}
        />

        <!-- Commercial Action Box -->
        <div class="hud-glass-card p-6 font-mono gap-4">
          <div class="border-b border-[#0A0A0A]/20 pb-2">
            <span class="text-xs font-bold text-[#0A0A0A] uppercase tracking-wider block">
              <I18nText ru={detail.procurementTitle} uz={detail.procurementTitle_uz} en={detail.procurementTitle_en} />
            </span>
            <span class="text-[11px] text-[#4A5056]">
              <I18nText ru={detail.dispatchNote} uz={detail.dispatchNote_uz} en={detail.dispatchNote_en} />
            </span>
          </div>

          <div class="space-y-2 text-xs">
            <div class="flex justify-between text-[#4A5056]">
              <span><I18nText k="catalog.detail.stockStatus" /></span>
              <span class="font-bold text-[#0A0A0A]">
                {status}
              </span>
            </div>
            <div class="flex justify-between text-[#4A5056]">
              <span><I18nText k="catalog.detail.taxation" /></span>
              <span class="font-bold text-[#0A0A0A]">
                <I18nText ru={detail.taxationValue} uz={detail.taxationValue_uz} en={detail.taxationValue_en} />
              </span>
            </div>
            <div class="flex justify-between text-[#4A5056]">
              <span><I18nText k="catalog.detail.salesDirect" /></span>
              <a href={phoneHref} class="font-bold text-[#0A0A0A] hover:underline">{globalData.phone}</a>
            </div>
          </div>

          <div class="pt-2 flex flex-col gap-2">
            <button
              type="button"
              data-lead-modal
              data-lead-subject={t('ru', 'lead.subject.catalogInvoice', { title: data.title, sku: data.sku })}
              class="hud-btn w-full cursor-pointer"
            >
              <I18nText k="catalog.detail.requestQuote" />
            </button>
            <a
              href={catalogHref}
              class="hud-btn hud-btn--ghost w-full text-center"
            >
              <I18nText k="catalog.detail.back" />
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    {related && related.length > 0 && (
      <div class="mt-12 pt-8 border-t border-[#0A0A0A]/20 font-mono">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-[#0A0A0A] inline-block"></span>
            <h2 class="text-sm sm:text-base font-bold text-[#0A0A0A] uppercase tracking-wider">
              <I18nText ru={detail.relatedTitle} uz={detail.relatedTitle_uz} en={detail.relatedTitle_en} />
            </h2>
          </div>
          <a href={catalogHref} class="text-xs font-bold text-[#0A0A0A] hover:underline">
            <I18nText k="catalog.detail.viewAll" />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {related.map((item) => {
            const itemCategory = categoryOf(item.data);
            const itemTitle = L(item.data, 'title');
            return (
              <a
                href={localeHref(`/catalog/${item.slug}/`, lang)}
                class="hud-glass-card p-4 group flex flex-col justify-between hover:border-[#0A0A0A] transition-all"
              >
                <div>
                  <div class="hud-card-media aspect-[16/10] mb-3">
                    <img
                      src={withBase(item.data.image || `/images/catalog/${item.data.sku.toLowerCase()}.jpg`)}
                      alt={tr('catalog.detail.imageAlt', { title: itemTitle, sku: item.data.sku })}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="flex items-center justify-between text-[11px] text-[#4A5056] mb-1">
                    <span class="font-bold text-[#0A0A0A]">{item.data.sku}</span>
                    <span class="uppercase truncate max-w-[50%]">
                      {pick(lang, itemCategory.ru, itemCategory.uz, itemCategory.en)}
                    </span>
                  </div>
                  <h3 class="text-xs sm:text-sm font-bold text-[#0A0A0A] line-clamp-2 mb-2 group-hover:underline">
                    {itemTitle}
                  </h3>
                </div>
                <div class="pt-3 border-t border-[#0A0A0A]/15 flex items-center justify-between text-xs mt-2">
                  <span class="text-emerald-900 font-bold text-[11px] bg-emerald-100/60 px-1.5 py-0.5">
                    {statusLabel(item.data, lang)}
                  </span>
                  <span class="font-bold text-[#0A0A0A]">
                    <I18nText k="catalog.detail.details" />
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
