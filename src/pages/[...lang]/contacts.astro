---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import LeadFormBlock from '../../components/ui/LeadFormBlock.astro';
import pages from '../../data/cms/pages.json';
import { langStaticPaths, tField } from '../../i18n';
import { t } from '../../i18n/ui';
import { company, mailHref, mapUrl, telHref, telegramUrl } from '../../utils/company';
import { pageSeo } from '../../utils/seo';

export const getStaticPaths = langStaticPaths;
const lang = Astro.locals.lang;
const tr = (key: string) => t(lang, key);
const seo = pageSeo('contacts', lang);
const p = pages.contacts as Record<string, string>;
const office = tField(company, 'officeAddress', lang) as string;
const tg = telegramUrl();
const crumbs = [{ name: tr('nav.contacts'), path: '/contacts/' }];
---

<BaseLayout title={seo.title} description={seo.description} breadcrumbs={crumbs}>
  <div class="wrap"><Breadcrumbs items={crumbs} /></div>
  <section class="wrap page" aria-labelledby="contacts-h1">
    <SectionHead id="contacts-h1" level={1} eyebrow={tField(p, 'eyebrow', lang)} title={tField(p, 'title', lang)} lead={tField(p, 'lead', lang)} />
    <div class="grid">
      <div class="info">
        <h2 class="visually-hidden">{tr('contacts.channels')}</h2>
        <dl class="list">
          <div><dt>{tr('contacts.office')}</dt><dd>{office}<br /><a href={mapUrl(office)} target="_blank" rel="noopener noreferrer">{tr('contacts.map')} ↗</a></dd></div>
          <div><dt>{tr('contacts.phone')}</dt><dd><a href={telHref()}>{company.phone}</a></dd></div>
          <div><dt>{tr('contacts.email')}</dt><dd><a href={mailHref()}>{company.email}</a></dd></div>
          {tg && <div><dt>{tr('contacts.telegram')}</dt><dd><a href={tg} rel="noopener">@{company.telegramBot}</a></dd></div>}
          <div><dt>{tr('contacts.cabinet')}</dt><dd><a href={company.cabinet.loginUrl}>{company.cabinet.url.replace(/^https?:\/\//, '')}</a></dd></div>
        </dl>

        <section class="req" id="requisites" aria-labelledby="req-title">
          <h2 id="req-title">{tr('contacts.requisites')}</h2>
          <dl class="list list--compact">
            <div><dt>{tr('contacts.fullName')}</dt><dd>{tField(company, 'fullName', lang)}</dd></div>
            <div><dt>{tr('contacts.inn')}</dt><dd>{company.inn}</dd></div>
            <div><dt>{tr('contacts.legal')}</dt><dd>{tField(company, 'legalAddress', lang)}</dd></div>
            <div><dt>{tr('contacts.bank')}</dt><dd>{tField(company.bank, 'name', lang)}</dd></div>
            <div><dt>{tr('contacts.mfo')}</dt><dd>{company.bank.mfo}</dd></div>
            <div><dt>{tr('contacts.account')}</dt><dd class="num">{company.bank.account}</dd></div>
          </dl>
        </section>
      </div>
      <div class="form" id="request">
        <h2>{tField(p, 'formTitle', lang)}</h2>
        <p class="muted">{tField(p, 'formText', lang)}</p>
        <LeadFormBlock idPrefix="contacts-lead" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: 28px 96px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }
  .info {
    display: grid;
    gap: 40px;
  }
  .list {
    margin: 0;
    border-top: 1px solid var(--c-line);
  }
  .list div {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--c-line);
  }
  .list dt {
    color: var(--c-muted);
    font-size: 15px;
  }
  .list dd {
    margin: 0;
    font-weight: 500;
  }
  .list--compact div {
    padding: 10px 0;
    font-size: 15px;
  }
  .num {
    font-variant-numeric: tabular-nums;
    word-break: break-all;
  }
  .req h2,
  .form h2 {
    font-size: 26px;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .form > p {
    margin-bottom: 20px;
  }
  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .form {
      order: -1;
    }
  }
  @media (max-width: 760px) {
    .page {
      padding-block: 20px 56px;
    }
    .list div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
      padding: 12px 0;
    }
  }
</style>
