---
import { responsiveImage, SIZES } from '../../../utils/images';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase, telHref } from '../../../utils/url';
import I18nText from '../../../components/I18nText.astro';
import HudViewportFrame from '../../../components/hud/HudViewportFrame.astro';
import { marked } from 'marked';
import globalData from '../../../data/cms/global.json';
import pagesData from '../../../data/cms/pages.json';
import { expandLangs, localeHref, pick, tField } from '../../../i18n';
import { t } from '../../../i18n/ui';
import { entrySeo, absoluteUrl, plainText, siteSeo } from '../../../utils/seo';
import { navLabel } from '../../../utils/nav';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  const paths = blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
  return expandLangs(paths);
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const lang = Astro.locals.lang;
const tr = (key: string, vars?: Record<string, string | number>) => t(lang, key, vars);
const L = (obj: Record<string, any>, field: string) => tField(obj, field, lang) as string;

const data = entry.data;
const bPage = pagesData.blogPage;
const detail = bPage.detail;
const postRoute = `/blog/${entry.slug}/`;
const postUrl = absoluteUrl(localeHref(postRoute, lang), Astro.site);
const orgId = `${absoluteUrl('/', Astro.site)}#organization`;
const title = L(data, 'title');
const categoryName = L(data, 'category');
const tags = pick<string[]>(lang, data.tags, data.tags_uz, data.tags_en);

// Markdown body: translated body_uz / body_en when present, otherwise the RU body.
const localizedBody = lang === 'uz' ? data.body_uz : lang === 'en' ? data.body_en : undefined;
const bodyHtml = localizedBody ? await marked.parse(localizedBody) : '';

// Author: explicit per-post author, otherwise the site-wide default from pages.json (localized).
const author =
  data.author && data.author !== bPage.defaultAuthor
    ? data.author
    : pick(lang, bPage.defaultAuthor, bPage.defaultAuthor_uz, bPage.defaultAuthor_en);
// Read time: CMS value, otherwise estimated from the body (~180 words per minute).
const readTime =
  L(data, 'readTime') ||
  tr('blog.readTimeMinutes', {
    n: Math.max(1, Math.round(plainText(localizedBody || entry.body).split(' ').filter(Boolean).length / 180)),
  });

const seo = entrySeo(data, lang, { descriptionFields: ['summary'], body: localizedBody || entry.body });
const imagePath = data.image || siteSeo(lang).defaultImage;

const blogPostingJsonLd = {
  '@type': 'BlogPosting',
  '@id': `${postUrl}#article`,
  headline: title,
  description: seo.description,
  image: absoluteUrl(withBase(imagePath), Astro.site),
  datePublished: data.publishDate,
  dateModified: data.publishDate,
  inLanguage: lang,
  url: postUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  author:
    data.author && data.author !== bPage.defaultAuthor
      ? { '@type': 'Person', name: data.author }
      : { '@type': 'Organization', name: author, url: absoluteUrl('/', Astro.site) },
  publisher: { '@id': orgId },
  articleSection: categoryName,
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
};

const phoneHref = telHref(globalData.phone);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  image={data.image}
  ogType="article"
  breadcrumbs={[
    { name: navLabel('/blog/', lang), path: '/blog/' },
    { name: title, path: postRoute },
  ]}
  jsonLd={blogPostingJsonLd}
>
  <article class="max-w-5xl mx-auto px-4 py-10 font-sans">
    <!-- Breadcrumbs -->
    <nav aria-label={tr('breadcrumb.aria')} class="flex items-center space-x-2 font-mono text-xs text-[#4A5056] mb-6">
      <a href={localeHref('/', lang)} class="hover:underline">
        <I18nText k="nav.home" />
      </a>
      <span>/</span>
      <a href={localeHref('/blog/', lang)} class="hover:underline">
        {navLabel('/blog/', lang)}
      </a>
      <span>/</span>
      <span class="text-[#0A0A0A] font-bold truncate max-w-xs sm:max-w-md">
        <I18nText ru={data.title} uz={data.title_uz} en={data.title_en} />
      </span>
    </nav>

    <!-- Article Header Box -->
    <header class="border-b-2 border-[#0A0A0A] pb-6 mb-8 font-mono">
      <div class="flex flex-wrap items-center gap-2 text-xs mb-3">
        <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-2 py-0.5 font-bold">
          <I18nText ru={data.category} uz={data.category_uz} en={data.category_en} />
        </span>
        <span class="border border-[#0A0A0A] bg-[#C8CDD2] px-2 py-0.5 text-[#0A0A0A]">
          <I18nText k="blog.date" /> {data.publishDate}
        </span>
        <span class="border border-[#0A0A0A]/40 bg-[#D4D8DC] px-2 py-0.5 text-[#4A5056]">
          <I18nText k="blog.readTimeLabel" /> {readTime}
        </span>
      </div>

      <I18nText
        as="h1"
        class="font-sans text-2xl sm:text-3xl lg:text-4xl font-bold text-[#0A0A0A] tracking-tight mb-4 leading-tight"
        ru={data.title}
        uz={data.title_uz}
        en={data.title_en}
      />

      <I18nText
        as="p"
        class="font-sans text-base text-[#4A5056] leading-relaxed mb-4"
        ru={data.summary}
        uz={data.summary_uz}
        en={data.summary_en}
      />

      <!-- Metadata Telemetry Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-[#0A0A0A]/20 text-xs text-[#4A5056]">
        <div>
          <I18nText k="blog.author" /> <span class="font-bold text-[#0A0A0A]">{author}</span>
        </div>
        <div class="flex flex-wrap gap-1.5 text-[11px]">
          {tags.map((tag) => (
            <span class="border border-[#0A0A0A]/30 bg-[#C8CDD2]/60 px-2 py-0.5 text-[#0A0A0A]">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Article Body -->
      <div class="lg:col-span-8">
        {data.image && (
          <div class="mb-8">
            <HudViewportFrame
              topLabel={tr('blog.article.frameTop', { category: categoryName })}
              bottomLabel={detail.frameBottom}
            >
              <div class="aspect-[16/9] overflow-hidden">
                <img
                  {...responsiveImage(data.image, SIZES.wide)}
                  alt={title}
                  class="w-full h-full object-cover"
                  style={{ filter: 'grayscale(0.15) contrast(1.05)' }}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </div>
            </HudViewportFrame>
          </div>
        )}

        <div class="hud-glass-card p-6 lg:p-8 font-sans">
          <div class="prose prose-sm sm:prose max-w-none text-[#0A0A0A] leading-relaxed prose-headings:font-bold prose-headings:text-[#0A0A0A] prose-headings:border-b prose-headings:border-[#0A0A0A]/30 prose-headings:pb-2 prose-pre:bg-[#0A0A0A] prose-pre:text-[#D4D8DC] prose-pre:border prose-pre:border-[#0A0A0A] prose-code:font-mono prose-code:text-[#0A0A0A] prose-code:bg-[#D4D8DC] prose-code:px-1 prose-strong:text-[#0A0A0A] prose-blockquote:border-l-4 prose-blockquote:border-[#0A0A0A] prose-blockquote:bg-[#D4D8DC] prose-blockquote:p-3 prose-li:text-[#0A0A0A]">
            {bodyHtml ? <div set:html={bodyHtml} /> : <Content />}
          </div>
        </div>

        <!-- Back to blog link -->
        <div class="mt-6 font-mono text-xs">
          <a
            href={localeHref('/blog/', lang)}
            class="hud-btn hud-btn--ghost"
          >
            <I18nText k="blog.article.back" />
          </a>
        </div>
      </div>

      <!-- Right Column: Commercial & RFQ Sidebar -->
      <aside class="lg:col-span-4 flex flex-col space-y-6">
        <!-- Lead Trigger Card -->
        <div class="hud-glass-card p-6 font-mono sticky top-20 gap-4">
          <div class="border-b border-[#0A0A0A]/20 pb-2">
            <span class="text-xs font-bold text-[#0A0A0A] uppercase tracking-wider block">
              <I18nText ru={detail.sidebarTitle} uz={detail.sidebarTitle_uz} en={detail.sidebarTitle_en} />
            </span>
            <span class="text-[11px] text-[#4A5056]">
              <I18nText ru={detail.sidebarNote} uz={detail.sidebarNote_uz} en={detail.sidebarNote_en} />
            </span>
          </div>

          <p class="text-xs text-[#4A5056] font-sans leading-relaxed mb-6">
            <I18nText ru={detail.sidebarText} uz={detail.sidebarText_uz} en={detail.sidebarText_en} />
          </p>

          <div class="space-y-3">
            <button
              type="button"
              data-lead-modal
              data-lead-subject={t(lang, 'lead.subject.blogArticle', { title: tField(data, 'title', lang) })}
              class="w-full border-2 border-[#0A0A0A] bg-[#0A0A0A] text-white py-3 text-xs font-bold tracking-wider hover:bg-transparent hover:text-[#0A0A0A] transition-colors cursor-pointer"
            >
              <I18nText k="blog.article.requestQuote" />
            </button>

            <a
              href={phoneHref}
              class="w-full border border-[#0A0A0A] bg-white text-[#0A0A0A] py-2.5 text-xs font-bold text-center block hover:bg-[#0A0A0A] hover:text-white transition-colors"
            >
              {globalData.phone} ↗
            </a>
          </div>

          <div class="mt-6 pt-4 border-t border-[#0A0A0A]/20 text-[11px] text-[#4A5056] space-y-1">
            {(detail.sidebarFacts || []).map((fact: any) => (
              <div>
                <I18nText ru={fact.text} uz={fact.text_uz} en={fact.text_en} />
              </div>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
