---
import BaseLayout from '../../layouts/BaseLayout.astro';
import I18nText from '../../components/I18nText.astro';
import globalData from '../../data/cms/global.json';
import legalData from '../../data/cms/legal.json';
import { langStaticPaths, localeHref, tField } from '../../i18n';
import { pageSeo, plainText } from '../../utils/seo';

export const getStaticPaths = langStaticPaths;

const lang = Astro.locals.lang;
const seo = pageSeo('terms', lang);
const doc = legalData.terms;
const other = legalData.privacy;
const crumb: string = tField(doc, 'crumb', lang);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  breadcrumbs={[{ name: plainText(crumb), path: '/terms/' }]}
  jsonLd={{
    '@type': 'WebPage',
    name: plainText(tField(doc, 'title', lang)),
    description: seo.description,
    inLanguage: lang,
  }}
>
  <div class="max-w-4xl mx-auto px-4 py-10 font-sans">
    <!-- Breadcrumbs -->
    <div class="flex items-center space-x-2 font-mono text-xs text-[#4A5056] mb-4">
      <a href={localeHref('/', lang)} class="hover:underline">
        <I18nText k="nav.home" />
      </a>
      <span>/</span>
      <span class="text-[#0A0A0A] font-bold">
        <I18nText ru={doc.crumb} uz={doc.crumb_uz} en={doc.crumb_en} />
      </span>
    </div>

    <!-- Header Section -->
    <div class="border-b-2 border-[#0A0A0A] pb-6 mb-8 font-mono">
      <div class="flex flex-wrap items-center gap-2 text-xs mb-3">
        <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-2 py-0.5 font-bold inline-block">
          <I18nText ru={doc.badgeService} uz={doc.badgeService_uz} en={doc.badgeService_en} />
        </span>
        <span class="border border-[#0A0A0A] bg-[#C8CDD2] px-2 py-0.5 text-[#0A0A0A] inline-block">
          <I18nText ru={doc.badgeOffer} uz={doc.badgeOffer_uz} en={doc.badgeOffer_en} />
        </span>
        <span class="border border-emerald-600 bg-emerald-100 text-emerald-900 px-2 py-0.5 font-bold inline-block">
          <I18nText ru={doc.badgeEdition} uz={doc.badgeEdition_uz} en={doc.badgeEdition_en} />
        </span>
      </div>

      <I18nText
        as="h1"
        class="font-sans text-2xl sm:text-3xl lg:text-4xl font-bold text-[#0A0A0A] tracking-tight mb-2"
        ru={doc.title}
        uz={doc.title_uz}
        en={doc.title_en}
      />

      <p class="text-sm text-[#4A5056]">
        <I18nText
          ru={doc.subtitle}
          uz={doc.subtitle_uz}
          en={doc.subtitle_en}
        />
      </p>
    </div>

    <!-- Document Content from CMS -->
    <div class="border border-[#0A0A0A] bg-[#D4D8DC] p-6 lg:p-8 font-mono text-xs space-y-6 leading-relaxed">
      {doc.sections.map((sec) => (
        <div class="border-b border-[#0A0A0A]/15 pb-4 last:border-0 last:pb-0">
          <div class="font-bold text-sm text-[#0A0A0A] mb-2">
            <I18nText ru={sec.title} uz={sec.title_uz} en={sec.title_en} />
          </div>
          <p class="text-[#4A5056] font-sans leading-relaxed">
            <I18nText ru={sec.content} uz={sec.content_uz} en={sec.content_en} />
          </p>
        </div>
      ))}
    </div>

    <!-- Bottom Actions -->
    <div class="mt-8 pt-6 border-t border-[#0A0A0A]/30 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
      <div class="text-[#4A5056]">
        {tField(doc, 'contactLabel', lang)} {globalData.emailLegal}
      </div>
      <a
        href={localeHref('/privacy/', lang)}
        class="border border-[#0A0A0A] bg-white px-4 py-2 hover:bg-[#0A0A0A] hover:text-white transition-colors"
      >
        <I18nText ru={other.crumb} uz={other.crumb_uz} en={other.crumb_en} /> <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</BaseLayout>
