---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import I18nText from '../../../components/I18nText.astro';
import HudPageHeader from '../../../components/hud/HudPageHeader.astro';
import { ProductMediaGallery } from '../../../components/islands/ProductMediaGallery';
import { withBase, telHref } from '../../../utils/url';
import { marked } from 'marked';
import globalData from '../../../data/cms/global.json';
import pagesData from '../../../data/cms/pages.json';
import { expandLangs, localeHref, pick, tField } from '../../../i18n';
import { t } from '../../../i18n/ui';
import { entrySeo, absoluteUrl } from '../../../utils/seo';
import { navLabel, navLabels } from '../../../utils/nav';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  const paths = projectEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
  return expandLangs(paths);
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const lang = Astro.locals.lang;
const tr = (key: string, vars?: Record<string, string | number>) => t(lang, key, vars);
const L = (obj: Record<string, any>, field: string) => tField(obj, field, lang) as string;

const data = entry.data;
const pPage = pagesData.projectsPage;
const detail = pPage.detail;
const projectRoute = `/projects/${entry.slug}/`;
const projectUrl = absoluteUrl(localeHref(projectRoute, lang), Astro.site);
const orgId = `${absoluteUrl('/', Astro.site)}#organization`;
const title = L(data, 'title');

// Category → legacy tag → pages.json projectsPage.defaultCategory
const category = data.category
  ? { ru: data.category, uz: data.category_uz, en: data.category_en }
  : data.tag
    ? { ru: data.tag, uz: data.tag_uz, en: data.tag_en }
    : { ru: pPage.defaultCategory, uz: pPage.defaultCategory_uz, en: pPage.defaultCategory_en };
const categoryName = pick(lang, category.ru, category.uz, category.en);

const imagePath = data.image || '/images/hero/warehouse.jpg';

// Markdown body: translated body_uz / body_en when present, otherwise the RU body.
const localizedBody = lang === 'uz' ? data.body_uz : lang === 'en' ? data.body_en : undefined;
const bodyHtml = localizedBody ? await marked.parse(localizedBody) : '';

const seo = entrySeo(data, lang, { descriptionFields: ['subtitle', 'description'], body: localizedBody || entry.body });

const articleJsonLd = {
  '@type': 'Article',
  '@id': `${projectUrl}#article`,
  headline: title,
  description: seo.description,
  image: absoluteUrl(withBase(imagePath), Astro.site),
  url: projectUrl,
  inLanguage: lang,
  articleSection: categoryName,
  ...(data.year ? { dateCreated: data.year } : {}),
  author: { '@id': orgId },
  publisher: { '@id': orgId },
  mainEntityOfPage: { '@type': 'WebPage', '@id': projectUrl },
};

const phoneHref = telHref(globalData.phone);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  image={imagePath}
  ogType="article"
  breadcrumbs={[
    { name: navLabel('/projects/', lang), path: '/projects/' },
    { name: title, path: projectRoute },
  ]}
  jsonLd={articleJsonLd}
>
  <div class="max-w-7xl mx-auto px-4 pb-16 font-sans">
    <HudPageHeader
      code={tr('projects.detail.code', { code: data.code })}
      parent={{ href: '/projects/', label: navLabels('/projects/') }}
      crumb={{ ru: data.title, uz: data.title_uz, en: data.title_en }}
      title={{ ru: data.title, uz: data.title_uz, en: data.title_en }}
      lead={{ ru: data.subtitle, uz: data.subtitle_uz, en: data.subtitle_en }}
    />

    <!-- Telemetry Status Bar -->
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs mb-8">
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A] font-bold border border-[#0A0A0A]">
        {data.code}
      </span>
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A]">
        {categoryName}
      </span>
      {data.year && (
        <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A]">
          {tr('projects.detail.year', { year: data.year })}
        </span>
      )}
      <span class="hud-glass-card px-2.5 py-1 text-emerald-900 font-bold bg-emerald-100/50">
        {tr('projects.detail.statusCompleted')}
      </span>
    </div>

    <!-- Main Content Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Photo & Key Metrics -->
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <ProductMediaGallery
          client:load
          lang={lang}
          sku={data.code}
          title={data.title}
          title_uz={data.title_uz}
          title_en={data.title_en}
          category={category.ru}
          category_uz={category.uz}
          category_en={category.en}
          status={tr('projects.detail.statusShort')}
          image={imagePath}
          images={data.images}
          gallery={data.gallery}
        />

        <!-- Metrics Cards Grid -->
        {data.metrics && data.metrics.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono">
            {data.metrics.map((m, idx) => (
              <div class="hud-glass-card p-4 flex flex-col justify-between">
                <span class="text-[10px] text-[#4A5056] border-b border-[#0A0A0A]/15 pb-1 block mb-2">
                  {tr('projects.detail.metric', { n: idx + 1 })}
                </span>
                <span class="font-bold text-[#0A0A0A] text-sm leading-snug">
                  <I18nText ru={m} uz={data.metrics_uz?.[idx]} en={data.metrics_en?.[idx]} />
                </span>
              </div>
            ))}
          </div>
        )}

        <!-- Downloadable Documents (if attached) -->
        {data.documents && data.documents.length > 0 && (
          <div class="hud-glass-card p-6 font-mono text-xs">
            <div class="border-b border-[#0A0A0A]/20 pb-2 mb-4 font-bold text-[#0A0A0A] flex items-center justify-between">
              <span>
                <I18nText ru={detail.materialsTitle} uz={detail.materialsTitle_uz} en={detail.materialsTitle_en} />
              </span>
              <span class="text-[#4A5056]">{tr('docs.filesCount', { count: data.documents.length })}</span>
            </div>
            <div class="space-y-2">
              {data.documents.map((doc) => (
                <div class="flex items-center justify-between p-2.5 border border-[#0A0A0A]/20 bg-white/40">
                  <span class="font-bold text-[#0A0A0A]">
                    <I18nText ru={doc.title} uz={doc.title_uz} en={doc.title_en} />
                  </span>
                  <a
                    href={doc.file.startsWith('http') ? doc.file : withBase(doc.file)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hud-btn hud-btn--ghost text-[10px] py-1 px-2.5"
                  >
                    <I18nText k="projects.detail.download" />
                  </a>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Right Column: Case Scope, Solution & RFQ Form -->
      <div class="lg:col-span-5 flex flex-col space-y-6">
        <!-- Case Details -->
        <div class="hud-glass-card p-6">
          <div class="border-b border-[#0A0A0A]/20 pb-2 mb-4 font-mono text-xs font-bold text-[#0A0A0A] uppercase tracking-wider">
            <I18nText ru={detail.scopeTitle} uz={detail.scopeTitle_uz} en={detail.scopeTitle_en} />
          </div>
          <div class="prose prose-sm text-[#0A0A0A] max-w-none leading-relaxed">
            {bodyHtml ? <div set:html={bodyHtml} /> : <Content />}
          </div>
        </div>

        <!-- Commercial CTA Card -->
        <div class="hud-glass-card p-6 font-mono text-xs space-y-4">
          <div class="border-b border-[#0A0A0A]/20 pb-2">
            <span class="font-bold text-[#0A0A0A] text-sm block">
              <I18nText ru={detail.orderTitle} uz={detail.orderTitle_uz} en={detail.orderTitle_en} />
            </span>
            <span class="text-[11px] text-[#4A5056] leading-tight block mt-1">
              <I18nText ru={detail.orderNote} uz={detail.orderNote_uz} en={detail.orderNote_en} />
            </span>
          </div>

          <div class="space-y-2 text-[#4A5056]">
            <div class="flex justify-between">
              <span><I18nText k="projects.detail.settlement" /></span>
              <span class="font-bold text-[#0A0A0A]"><I18nText ru={detail.settlementValue} uz={detail.settlementValue_uz} en={detail.settlementValue_en} /></span>
            </div>
            <div class="flex justify-between">
              <span><I18nText k="projects.detail.leadTime" /></span>
              <span class="font-bold text-[#0A0A0A]"><I18nText ru={detail.leadTimeValue} uz={detail.leadTimeValue_uz} en={detail.leadTimeValue_en} /></span>
            </div>
            <div class="flex justify-between">
              <span><I18nText k="projects.detail.directLine" /></span>
              <a href={phoneHref} class="font-bold text-[#0A0A0A] hover:underline">{globalData.phone}</a>
            </div>
          </div>

          <div class="pt-2 flex flex-col gap-2">
            <button
              type="button"
              data-lead-modal
              data-lead-subject={t(lang, 'lead.subject.projectSimilar', { title: tField(data, 'title', lang), code: data.code })}
              class="hud-btn w-full cursor-pointer text-center"
            >
              <I18nText ru={detail.orderButton} uz={detail.orderButton_uz} en={detail.orderButton_en} />
            </button>
            <a
              href={localeHref('/projects/', lang)}
              class="hud-btn hud-btn--ghost w-full text-center"
            >
              <I18nText k="projects.detail.back" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
