---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CadInspector } from '../components/islands/CadInspector';
import { withBase } from '../utils/url';

const projectItems = await getCollection('projects');
projectItems.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Спецпроекты, локализация и Арт-лаборатория — ООО «RailTech»"
  description="Трансфер зарубежных железнодорожных технологий в Узбекистан, организация полигонных испытаний на путях ГАЖК «УТЙ», а также культурная инициатива и выставки RailTech Art Lab в Ташкенте."
  keywords="локализация жд производства узбекистан, испытания утй, трансфер технологий машиностроения, railtech art lab, индустриальное искусство ташкент"
>
  <div class="max-w-7xl mx-auto px-4 py-10 font-sans">
    <!-- Breadcrumbs -->
    <div class="flex items-center space-x-2 font-mono text-xs text-[#4A5056] mb-4">
      <a href={`${base}/`} class="hover:underline">ГЛАВНАЯ</a>
      <span>/</span>
      <span class="text-[#0A0A0A] font-bold">СПЕЦПРОЕКТЫ & АРТ-ЛАБОРАТОРИЯ (.PROJECTS)</span>
    </div>

    <!-- Header Section -->
    <div class="border-b-2 border-[#0A0A0A] pb-6 mb-8">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs mb-3">
        <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-2 py-0.5 font-bold">
          R&D И КУЛЬТУРНЫЕ ИНИЦИАТИВЫ
        </span>
        <span class="border border-[#0A0A0A] bg-[#C8CDD2] px-2 py-0.5 text-[#0A0A0A]">
          ТАШКЕНТ // ИСПЫТАТЕЛЬНЫЙ ПОЛИГОН
        </span>
        <span class="border border-[#0A0A0A] px-2 py-0.5 font-bold text-[#0A0A0A]">
          АРТ-РЕЗИДЕНЦИЯ INDEX
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold text-[#0A0A0A] tracking-tight mb-3">
        ТЕХНОЛОГИЧЕСКИЙ ТРАНСФЕР, ЛОКАЛИЗАЦИЯ И АРТ-ЛАБОРАТОРИЯ
      </h1>

      <p class="text-base text-[#4A5056] max-w-3xl leading-relaxed">
        Деятельность RailTech выходит за рамки классической дистрибуции. Мы содействуем внедрению инновационных инженерных решений в транспортную инфраструктуру Республики Узбекистан и одновременно поддерживаем монументальное индустриальное искусство через собственную Арт-лабораторию.
      </p>
    </div>

    <!-- Top Two-Column Grid: CAD + Value Proposition -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12 items-start">
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <div class="border-2 border-[#0A0A0A] bg-[#C8CDD2] p-6 font-mono">
          <div class="text-xs font-bold text-[#0A0A0A] border-b border-[#0A0A0A] pb-2 mb-4">
            НАПРАВЛЕНИЯ СПЕЦИАЛЬНЫХ ПРОЕКТОВ RAILTECH:
          </div>
          <div class="space-y-4 text-xs">
            <div class="flex items-start space-x-3">
              <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5 font-bold">01</span>
              <div>
                <span class="font-bold text-[#0A0A0A] block">ТРАНСФЕР ТЕХНОЛОГИЙ И ЛОКАЛИЗАЦИЯ</span>
                <span class="text-[#4A5056]">Адаптация конструкторской документации европейских и азиатских машиностроительных заводов под стандарты колеи 1520 мм и ГОСТ Узбекистана.</span>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5 font-bold">02</span>
              <div>
                <span class="font-bold text-[#0A0A0A] block">ПОЛИГОННЫЕ ИСПЫТАНИЯ И СЕРТИФИКАЦИЯ</span>
                <span class="text-[#4A5056]">Организация опытной эксплуатации новых типов оборудования на полигонах ГАЖК «Узбекистон темир йуллари» с инструментальной фиксацией износа.</span>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5 font-bold">03</span>
              <div>
                <span class="font-bold text-[#0A0A0A] block">RAILTECH ART LAB (КУРАТОРСКАЯ ПРОГРАММА)</span>
                <span class="text-[#4A5056]">Исследование индустриальной эстетики, коллекционирование современной живописи, архитектурной графики и проведение тематических экспозиций в Ташкенте.</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5">
        <CadInspector
          client:load
          modelType="hypercube"
          title="ПОВОРОТНЫЙ ЛИМБ ГИПЕРКУБА"
          subtitle="МАТРИЦА СИНЕРГИИ ТЕХНОЛОГИЙ И АРТ-ПРОСТРАНСТВА"
        />
      </div>
    </div>

    <!-- Section: Projects Cards -->
    <div class="border-b-2 border-[#0A0A0A] pb-4 mb-8">
      <div class="font-mono text-xs font-bold text-[#0A0A0A] uppercase tracking-wider">
        ТЕКУЩИЕ ИНИЦИАТИВЫ
      </div>
      <h2 class="text-2xl font-bold text-[#0A0A0A] mt-1">
        ПОРТФЕЛЬ СПЕЦПРОЕКТОВ И КУЛЬТУРНЫХ ИНИЦИАТИВ
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {projectItems.map((prj) => (
        <div class="border-2 border-[#0A0A0A] bg-[#D4D8DC] p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between font-mono text-xs border-b border-[#0A0A0A]/30 pb-2 mb-3">
              <span class="font-bold text-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5">{prj.data.code}</span>
              <span class="text-[#4A5056] text-[10px]">{prj.data.tag}</span>
            </div>

            {prj.data.image && (
              <div class="mb-3 border border-[#0A0A0A] overflow-hidden bg-[#C8CDD2]">
                <img
                  src={withBase(prj.data.image)}
                  alt={prj.data.title}
                  class="w-full h-40 object-cover"
                />
              </div>
            )}

            <h3 class="font-sans font-bold text-lg text-[#0A0A0A] mb-2 leading-snug">
              {prj.data.title}
            </h3>

            <p class="text-xs text-[#4A5056] leading-relaxed mb-4">
              {prj.data.subtitle}
            </p>
          </div>

          <div class="pt-3 border-t border-[#0A0A0A]/20 font-mono text-[11px] text-[#0A0A0A] space-y-1.5 bg-[#C8CDD2]/50 p-3">
            {prj.data.metrics.map((metric) => (
              <div>• {metric}</div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Section: Art Lab Curatorial Statement -->
    <div class="border-2 border-[#0A0A0A] bg-[#C8CDD2] p-8 font-mono">
      <div class="border-b border-[#0A0A0A] pb-3 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div class="flex items-center space-x-2">
          <span class="w-3 h-3 bg-[#0A0A0A] inline-block"></span>
          <span class="font-bold text-sm text-[#0A0A0A] uppercase tracking-wider">
            МАНИФЕСТ RAILTECH ART LAB
          </span>
        </div>
        <span class="text-xs text-[#4A5056]">
          КУРАТОРСКАЯ РЕЗИДЕНЦИЯ В КОМПЛЕКСЕ INDEX
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-xs font-sans text-[#0A0A0A] leading-relaxed">
        <div>
          <p class="mb-3">
            Железная дорога — это не просто логистическая артерия, но и величайшая визуальная метафора индустриального века. Геометрия параллельных рельсов, строгие контуры стрелочных переводов, массивная текстура литой стали и мерный ритм колесных пар сформировали визуальный язык конструктивизма и модернизма XX века.
          </p>
          <p>
            RailTech Art Lab объединяет художников, архитекторов и инженеров Центральной Азии. Мы предоставляем выставочные площади в пространстве нашего складского хаба, организуем пленэры на действующих депо и формируем постоянную коллекцию монументальной живописи.
          </p>
        </div>
        <div class="border border-[#0A0A0A] p-5 bg-[#D4D8DC] font-mono text-xs flex flex-col justify-between">
          <div class="space-y-2">
            <div class="font-bold text-[#0A0A0A]">ДЛЯ ВЕНДОРОВ И ХУДОЖНИКОВ:</div>
            <p class="text-[11px] text-[#4A5056]">
              Если вы представляете зарубежный завод и заинтересованы в испытаниях на полигонах Узбекистана, либо являетесь автором индустриального искусства — свяжитесь с кураторской группой RailTech.
            </p>
          </div>
          <div class="pt-4">
            <button
              type="button"
              data-lead-modal
              data-lead-subject="Запрос сотрудничества по спецпроектам / Art Lab"
              class="w-full border border-[#0A0A0A] bg-[#0A0A0A] text-white py-2.5 text-xs font-bold hover:bg-transparent hover:text-[#0A0A0A] transition-colors cursor-pointer"
            >
              [ ПРЕДЛОЖИТЬ ПРОЕКТ / СОТРУДНИЧЕСТВО ]
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
