---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CadInspector } from '../components/islands/CadInspector';
import { withBase } from '../utils/url';
import I18nText from '../components/I18nText.astro';

const projectItems = await getCollection('projects');
projectItems.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Спецпроекты, локализация и Арт-лаборатория — ООО «RailTech»"
  description="Трансфер зарубежных железнодорожных технологий в Узбекистан, организация полигонных испытаний на путях ГАЖК «УТЙ», а также культурная инициатива и выставки RailTech Art Lab в Ташкенте."
  keywords="локализация жд производства узбекистан, испытания утй, трансфер технологий машиностроения, railtech art lab, индустриальное искусство ташкент"
>
  <div class="max-w-7xl mx-auto px-4 py-10 font-sans">
    <!-- Breadcrumbs -->
    <div class="flex items-center space-x-2 font-mono text-xs text-[#4A5056] mb-4">
      <a href={`${base}/`} class="hover:underline">
        <I18nText ru="ГЛАВНАЯ" uz="BOSH SAHIFA" en="HOME" />
      </a>
      <span>/</span>
      <span class="text-[#0A0A0A] font-bold">
        <I18nText ru="СПЕЦПРОЕКТЫ & АРТ-ЛАБОРАТОРИЯ (.PROJECTS)" uz="MAXSUS LOYIHALAR VA ART-LABORATORIYA (.PROJECTS)" en="SPECIAL PROJECTS & ART LAB (.PROJECTS)" />
      </span>
    </div>

    <!-- Header Section -->
    <div class="border-b-2 border-[#0A0A0A] pb-6 mb-8">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs mb-3">
        <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-2 py-0.5 font-bold inline-block">
          <I18nText ru="R&D И КУЛЬТУРНЫЕ ИНИЦИАТИВЫ" uz="R&D VA MADANIY TASHABBUSLAR" en="R&D & CULTURAL INITIATIVES" />
        </span>
        <span class="border border-[#0A0A0A] bg-[#C8CDD2] px-2 py-0.5 text-[#0A0A0A] inline-block">
          <I18nText ru="ТАШКЕНТ // ИСПЫТАТЕЛЬНЫЙ ПОЛИГОН" uz="TOSHKENT // SINOV POLIGONI" en="TASHKENT // TEST TRACK" />
        </span>
        <span class="border border-[#0A0A0A] px-2 py-0.5 font-bold text-[#0A0A0A] inline-block">
          <I18nText ru="АРТ-РЕЗИДЕНЦИЯ INDEX" uz="INDEX ART-REZIDENSIYASI" en="INDEX ART RESIDENCY" />
        </span>
      </div>

      <I18nText
        as="h1"
        class="text-3xl sm:text-4xl font-bold text-[#0A0A0A] tracking-tight mb-3"
        ru="ТЕХНОЛОГИЧЕСКИЙ ТРАНСФЕР, ЛОКАЛИЗАЦИЯ И АРТ-ЛАБОРАТОРИЯ"
        uz="TEXNOLOGIK TRANSFER, LOKALIZATSIYA VA ART-LABORATORIYA"
        en="TECHNOLOGY TRANSFER, LOCALIZATION & ART LAB"
      />

      <I18nText
        as="p"
        class="text-base text-[#4A5056] max-w-3xl leading-relaxed"
        ru="Деятельность RailTech выходит за рамки классической дистрибуции. Мы содействуем внедрению инновационных инженерных решений в транспортную инфраструктуру Республики Узбекистан и одновременно поддерживаем монументальное индустриальное искусство через собственную Арт-лабораторию."
        uz="«RailTech» faoliyati an'anaviy distribyutsiya doirasidan ancha kengdir. Biz O'zbekiston Respublikasi transport infratuzilmasiga innovatsion muhandislik yechimlarini joriy etishga ko'maklashamiz va ayni paytda o'zimizning Art-laboratoriyamiz orqali monumental sanoat san'atini qo'llab-quvvatlaymiz."
        en="RailTech's operational scope extends far beyond classic parts distribution. We facilitate the adoption of pioneering engineering technologies across Uzbekistan's transport grid while curating and patronizing monumental industrial art through the RailTech Art Lab."
      />
    </div>

    <!-- Top Two-Column Grid: CAD + Value Proposition -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12 items-start">
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <div class="border-2 border-[#0A0A0A] bg-[#C8CDD2] p-6 font-mono">
          <div class="text-xs font-bold text-[#0A0A0A] border-b border-[#0A0A0A] pb-2 mb-4">
            <I18nText
              ru="НАПРАВЛЕНИЯ СПЕЦИАЛЬНЫХ ПРОЕКТОВ RAILTECH:"
              uz="RAILTECH MAXSUS LOYIHALARINING ASOSIY YO'NALISHLARI:"
              en="RAILTECH SPECIAL PROJECTS STRATEGIC DIRECTIONS:"
            />
          </div>
          <div class="space-y-4 text-xs">
            <div class="flex items-start space-x-3">
              <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5 font-bold">01</span>
              <div>
                <span class="font-bold text-[#0A0A0A] block">
                  <I18nText ru="ТРАНСФЕР ТЕХНОЛОГИЙ И ЛОКАЛИЗАЦИЯ" uz="TEXNOLOGIYALAR TRANSFERI VA LOKALIZATSIYA" en="TECHNOLOGY TRANSFER & LOCALIZATION" />
                </span>
                <span class="text-[#4A5056]">
                  <I18nText
                    ru="Адаптация конструкторской документации европейских и азиатских машиностроительных заводов под стандарты колеи 1520 мм и ГОСТ Узбекистана."
                    uz="Yevropa va Osiyo mashinasozlik korxonalari konstruktorlik hujjatlarini 1520 mm temir yo'l izi va O'zbekiston GOST standartlariga moslashtirish."
                    en="Adapting engineering documentation from European and Asian machinery builders to the 1520 mm track gauge and Uzbekistan GOST standards."
                  />
                </span>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5 font-bold">02</span>
              <div>
                <span class="font-bold text-[#0A0A0A] block">
                  <I18nText ru="ПОЛИГОННЫЕ ИСПЫТАНИЯ И СЕРТИФИКАЦИЯ" uz="POLIGON SINOVLARI VA SERTIFIKATSIYA" en="TRACK TESTING & CERTIFICATION" />
                </span>
                <span class="text-[#4A5056]">
                  <I18nText
                    ru="Организация опытной эксплуатации новых типов оборудования на полигонах ГАЖК «Узбекистон темир йуллари» с инструментальной фиксацией износа."
                    uz="«O'zbekiston temir yo'llari» AJ sinov poligonlarida yangi uskuna turlarini tajriba sinovlaridan o'tkazish va yeyilishni asbobiy qayd etish."
                    en="Coordinating in-service operational trials of advanced rolling stock assemblies on Uzbekistan Railways (UTY) testbeds with wear instrumentation."
                  />
                </span>
              </div>
            </div>
            <div class="flex items-start space-x-3">
              <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5 font-bold">03</span>
              <div>
                <span class="font-bold text-[#0A0A0A] block">
                  <I18nText ru="RAILTECH ART LAB (КУРАТОРСКАЯ ПРОГРАММА)" uz="RAILTECH ART LAB (KURATORLIK DASTURI)" en="RAILTECH ART LAB (CURATORIAL PROGRAM)" />
                </span>
                <span class="text-[#4A5056]">
                  <I18nText
                    ru="Исследование индустриальной эстетики, коллекционирование современной живописи, архитектурной графики и проведение тематических экспозиций в Ташкенте."
                    uz="Sanoat estetikasini o'rganish, zamonaviy rangtasvir va me'moriy grafikani to'plash hamda Toshkentda ko'rgazmalar o'tkazish."
                    en="Exploring industrial aesthetics, curating contemporary painting and architectural graphics, and organizing public exhibitions in Tashkent."
                  />
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5">
        <CadInspector
          client:load
          modelType="hypercube"
          title="ПОВОРОТНЫЙ ЛИМБ ГИПЕРКУБА"
          titleUz="GIPERKUB BURILMA LIMBI"
          titleEn="HYPERCUBE ROTARY LIMB"
          subtitle="МАТРИЦА СИНЕРГИИ ТЕХНОЛОГИЙ И АРТ-ПРОСТРАНСТВА"
          subtitleUz="TEXNOLOGIYALAR VA SAN'AT MAYDONI SINERGIYASI MATRITSASI"
          subtitleEn="SYNERGY MATRIX OF TECHNOLOGY & ART LAB"
        />
      </div>
    </div>

    <!-- Section: Projects Cards -->
    <div class="border-b-2 border-[#0A0A0A] pb-4 mb-8">
      <div class="font-mono text-xs font-bold text-[#0A0A0A] uppercase tracking-wider">
        <I18nText ru="ТЕКУЩИЕ ИНИЦИАТИВЫ" uz="JORIY TASHABBUSLAR" en="CURRENT INITIATIVES" />
      </div>
      <I18nText
        as="h2"
        class="text-2xl font-bold text-[#0A0A0A] mt-1"
        ru="ПОРТФЕЛЬ СПЕЦПРОЕКТОВ И КУЛЬТУРНЫХ ИНИЦИАТИВ"
        uz="MAXSUS LOYIHALAR VA MADANIY TASHABBUSLAR PORTFELI"
        en="SPECIAL PROJECTS & CULTURAL INITIATIVES PORTFOLIO"
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {projectItems.map((prj) => (
        <div class="border-2 border-[#0A0A0A] bg-[#D4D8DC] p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between font-mono text-xs border-b border-[#0A0A0A]/30 pb-2 mb-3">
              <span class="font-bold text-[#0A0A0A] bg-[#0A0A0A] text-white px-1.5 py-0.5">{prj.data.code}</span>
              <span class="text-[#4A5056] text-[10px]">
                <I18nText ru={prj.data.tag} uz={prj.data.tag_uz} en={prj.data.tag_en} />
              </span>
            </div>

            {prj.data.image && (
              <div class="mb-3 border border-[#0A0A0A] overflow-hidden bg-[#C8CDD2]">
                <img
                  src={withBase(prj.data.image)}
                  alt={prj.data.title}
                  class="w-full h-40 object-cover"
                />
              </div>
            )}

            <h3 class="font-sans font-bold text-lg text-[#0A0A0A] mb-2 leading-snug">
              <I18nText ru={prj.data.title} uz={prj.data.title_uz} en={prj.data.title_en} />
            </h3>

            <p class="text-xs text-[#4A5056] leading-relaxed mb-4">
              <I18nText ru={prj.data.subtitle} uz={prj.data.subtitle_uz} en={prj.data.subtitle_en} />
            </p>
          </div>

          <div class="pt-3 border-t border-[#0A0A0A]/20 font-mono text-[11px] text-[#0A0A0A] space-y-1.5 bg-[#C8CDD2]/50 p-3">
            {prj.data.metrics.map((metric, idx) => {
              const metricUz = prj.data.metrics_uz && prj.data.metrics_uz[idx];
              const metricEn = prj.data.metrics_en && prj.data.metrics_en[idx];
              return (
                <div>• <I18nText ru={metric} uz={metricUz} en={metricEn} /></div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- Section: Art Lab Curatorial Statement -->
    <div class="border-2 border-[#0A0A0A] bg-[#C8CDD2] p-8 font-mono">
      <div class="border-b border-[#0A0A0A] pb-3 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div class="flex items-center space-x-2">
          <span class="w-3 h-3 bg-[#0A0A0A] inline-block"></span>
          <span class="font-bold text-sm text-[#0A0A0A] uppercase tracking-wider">
            <I18nText ru="МАНИФЕСТ RAILTECH ART LAB" uz="RAILTECH ART LAB MANIFESTI" en="RAILTECH ART LAB MANIFESTO" />
          </span>
        </div>
        <span class="text-xs text-[#4A5056]">
          <I18nText ru="КУРАТОРСКАЯ РЕЗИДЕНЦИЯ В КОМПЛЕКСЕ INDEX" uz="INDEX MAJMUASIDAGI KURATORLIK REZIDENSIYASI" en="CURATORIAL RESIDENCY AT INDEX COMPLEX" />
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-xs font-sans text-[#0A0A0A] leading-relaxed">
        <div>
          <p class="mb-3">
            <I18nText
              ru="Железная дорога — это не просто логистическая артерия, но и величайшая визуальная метафора индустриального века. Геометрия параллельных рельсов, строгие контуры стрелочных переводов, массивная текстура литой стали и мерный ритм колесных пар сформировали визуальный язык конструктивизма и модернизма XX века."
              uz="Temir yo'l shunchaki logistika arteriyasi emas, balki sanoat asrining eng buyuk vizual metaforasidir. Parallel relslar geometriyasi, strelka o'tkazgichlarining qat'iy konturlari, quyma po'latning ulkan teksturasi va g'ildirak juftlarining bir maromdagi ritmi XX asr konstruktivizmi va modernizmining vizual tilini shakllantirdi."
              en="The railway is more than a logistical artery; it is the definitive visual metaphor of the industrial era. The geometry of parallel tracks, the severe contours of turnout switches, the massive textures of cast steel, and the cadence of rolling wheelsets established the visual vocabulary of 20th-century constructivism and modernism."
            />
          </p>
          <p>
            <I18nText
              ru="RailTech Art Lab объединяет художников, архитекторов и инженеров Центральной Азии. Мы предоставляем выставочные площади в пространстве нашего складского хаба, организуем пленэры на действующих депо и формируем постоянную коллекцию монументальной живописи."
              uz="RailTech Art Lab Markaziy Osiyo rassomlari, me'morlari va muhandislarini birlashtiradi. Biz ombor xabimiz maydonida ko'rgazma maydonlarini taqdim etamiz, faoliyatdagi depolarda plenerlar tashkil qilamiz va monumental rangtasvirning doimiy kolleksiyasini shakllantiramiz."
              en="RailTech Art Lab unites artists, architects, and engineers across Central Asia. We provide exhibition space within our Tashkent terminal, arrange on-site plein-airs at active locomotive depots, and assemble a permanent collection of monumental industrial art."
            />
          </p>
        </div>
        <div class="border border-[#0A0A0A] p-5 bg-[#D4D8DC] font-mono text-xs flex flex-col justify-between">
          <div class="space-y-2">
            <div class="font-bold text-[#0A0A0A]">
              <I18nText ru="ДЛЯ ВЕНДОРОВ И ХУДОЖНИКОВ:" uz="ISHLAB CHIQARUVCHILAR VA RASSOMLAR UCHUN:" en="FOR VENDORS & ARTISTS:" />
            </div>
            <p class="text-[11px] text-[#4A5056]">
              <I18nText
                ru="Если вы представляете зарубежный завод и заинтересованы в испытаниях на полигонах Узбекистана, либо являетесь автором индустриального искусства — свяжитесь с кураторской группой RailTech."
                uz="Agar siz xorijiy zavod vakili bo'lsangiz va O'zbekiston poligonlaridagi sinovlarga qiziqsangiz, yoki sanoat san'ati muallifi bo'lsangiz — RailTech kuratorlik guruhi bilan bog'laning."
                en="If you represent an international manufacturer interested in testbed operations in Uzbekistan, or are an artist working with industrial themes, get in touch with the RailTech curatorial team."
              />
            </p>
          </div>
          <div class="pt-4">
            <button
              type="button"
              data-lead-modal
              data-lead-subject="Запрос сотрудничества по спецпроектам / Art Lab"
              class="w-full border border-[#0A0A0A] bg-[#0A0A0A] text-white py-2.5 text-xs font-bold hover:bg-transparent hover:text-[#0A0A0A] transition-colors cursor-pointer"
            >
              <I18nText ru="[ ПРЕДЛОЖИТЬ ПРОЕКТ / СОТРУДНИЧЕСТВО ]" uz="[ LOYIHA / HAMKORLIK TAKLIF QILISH ]" en="[ SUBMIT PROPOSAL / PARTNERSHIP ]" />
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
