---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ContactsLeadForm } from '../components/islands/ContactsLeadForm';
import contactsData from '../data/cms/contacts.json';
import globalData from '../data/cms/global.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={`Контакты и реквизиты — ${globalData.companyName} Ташкент, ТПК Index B2-2097`}
  description={`Контакты отделов снабжения, ВЭД и бухгалтерии ${globalData.companyName}. Адрес склада: ${globalData.address}. Телефон ${globalData.phone}, электронная почта ${contactsData.departments[0].email}, схема проезда.`}
  keywords="контакты railtech, склад index b2-2097 ташкент, телефон отдела снабжения railtech uz, схема проезда к комплексу index, реквизиты ооо railtech"
>
  <div class="max-w-7xl mx-auto px-4 py-10 font-sans">
    <!-- Breadcrumbs -->
    <div class="flex items-center space-x-2 font-mono text-xs text-[#4A5056] mb-4">
      <a href={`${base}/`} class="hover:underline">ГЛАВНАЯ</a>
      <span>/</span>
      <span class="text-[#0A0A0A] font-bold">КОНТАКТЫ & РЕКВИЗИТЫ</span>
    </div>

    <!-- Header Section -->
    <div class="border-b-2 border-[#0A0A0A] pb-6 mb-8 font-mono">
      <div class="flex flex-wrap items-center gap-2 text-xs mb-3">
        <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-2 py-0.5 font-bold">
          {contactsData.badge}
        </span>
        <span class="border border-[#0A0A0A] bg-[#C8CDD2] px-2 py-0.5 text-[#0A0A0A]">
          {contactsData.location}
        </span>
        <span class="border border-emerald-600 bg-emerald-100 text-emerald-900 px-2 py-0.5 font-bold">
          {contactsData.statusBadge}
        </span>
      </div>

      <h1 class="font-sans text-3xl sm:text-4xl font-bold text-[#0A0A0A] tracking-tight mb-3">
        {contactsData.pageTitle}
      </h1>

      <p class="font-sans text-base text-[#4A5056] max-w-3xl leading-relaxed">
        {contactsData.pageSubtitle}
      </p>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-14">
      <!-- Left Column: Department Directory & Logistics -->
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <!-- Direct Lines Table -->
        <div class="border-2 border-[#0A0A0A] bg-[#D4D8DC] font-mono">
          <div class="border-b border-[#0A0A0A] bg-[#0A0A0A] text-white px-4 py-2 text-xs font-bold tracking-wider">
            ПРЯМЫЕ КОНТАКТЫ ПОДРАЗДЕЛЕНИЙ
          </div>
          <div class="divide-y divide-[#0A0A0A]/20 text-xs">
            {contactsData.departments.map((dept) => (
              <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-[#C8CDD2]/50">
                <div>
                  <span class="font-bold text-[#0A0A0A] block text-sm">{dept.name}</span>
                  <span class="text-[#4A5056]">{dept.desc}</span>
                </div>
                <div class="text-right">
                  <a href={`tel:${dept.phone.replace(/[\s-]/g, '')}`} class="font-bold text-sm text-[#0A0A0A] hover:underline block">
                    {dept.phone}
                  </a>
                  <a href={`mailto:${dept.email}`} class="text-[11px] text-[#4A5056] hover:underline">
                    {dept.email}
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Logistics & Access Guidelines -->
        <div class="border-2 border-[#0A0A0A] bg-[#C8CDD2] p-6 font-mono text-xs">
          <div class="text-xs font-bold text-[#0A0A0A] border-b border-[#0A0A0A] pb-2 mb-3">
            ИНСТРУКЦИЯ ПО ПРОЕЗДУ ДЛЯ ГРУЗОВОГО ТРАНСПОРТА:
          </div>
          <div class="space-y-3 text-[#4A5056] font-sans">
            {contactsData.logisticsInstructions.map((instruction) => (
              <p>{instruction}</p>
            ))}
          </div>

          <div class="mt-4 pt-3 border-t border-[#0A0A0A]/20 flex items-center justify-between text-[11px]">
            <div>GPS: <span class="text-[#0A0A0A] font-bold">{contactsData.gps}</span></div>
            <a
              href={contactsData.yandexMapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="border border-[#0A0A0A] bg-white px-2.5 py-1 text-[#0A0A0A] font-bold hover:bg-[#0A0A0A] hover:text-white transition-colors"
            >
              ОТКРЫТЬ НА ЯНДЕКС.КАРТАХ ↗
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Feedback & RFQ Form -->
      <div class="lg:col-span-5 flex flex-col space-y-6">
        <ContactsLeadForm client:load />

        <!-- Official Bank Details Box -->
        <div class="border border-[#0A0A0A] bg-[#C8CDD2] p-5 font-mono text-xs space-y-2">
          <div class="font-bold text-[#0A0A0A]">БАНКОВСКИЕ РЕКВИЗИТЫ ДЛЯ ДОГОВОРОВ:</div>
          <div class="text-[11px] text-[#4A5056] space-y-1">
            <div>Получатель: <span class="text-[#0A0A0A] font-bold">{contactsData.bankDetails.recipient}</span></div>
            <div>ИНН: <span class="text-[#0A0A0A] font-bold">{globalData.inn}</span></div>
            <div>Статус НДС: <span class="text-[#0A0A0A] font-bold">{contactsData.bankDetails.vatCode}</span></div>
            <div>Расчетный счет: <span class="text-[#0A0A0A]">{contactsData.bankDetails.account}</span></div>
            <div>Банк: {contactsData.bankDetails.bank}</div>
            <div>МФО: {contactsData.bankDetails.mfo}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
