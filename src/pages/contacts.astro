---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ContactsLeadForm } from '../components/islands/ContactsLeadForm';
import I18nText from '../components/I18nText.astro';
import HudPageHeader from '../components/hud/HudPageHeader.astro';
import contactsData from '../data/cms/contacts.json';
import globalData from '../data/cms/global.json';
---

<BaseLayout
  title={`Контакты и реквизиты — ${globalData.companyName} Ташкент, ТПК Index B2-2097`}
  description={`Контакты отделов снабжения, ВЭД и бухгалтерии ${globalData.companyName}. Адрес склада: ${globalData.address}. Телефон ${globalData.phone}, электронная почта ${contactsData.departments[0].email}, схема проезда.`}
  keywords="контакты railtech, склад index b2-2097 ташкент, телефон отдела снабжения railtech uz, схема проезда к комплексу index, реквизиты ооо railtech"
>
  <div class="max-w-7xl mx-auto px-4 py-6 font-sans">
    <HudPageHeader
      code={contactsData.badge || 'SEC.06 // CONTACTS'}
      crumb={{ ru: 'КОНТАКТЫ & РЕКВИЗИТЫ', uz: 'KONTAKTLAR VA REKVIZITLAR', en: 'CONTACTS & REQUISITES' }}
      title={{ ru: contactsData.pageTitle, uz: contactsData.pageTitle_uz, en: contactsData.pageTitle_en }}
      lead={{ ru: contactsData.pageSubtitle, uz: contactsData.pageSubtitle_uz, en: contactsData.pageSubtitle_en }}
    />

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-14">
      <!-- Left Column: Department Directory & Logistics -->
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <!-- Direct Lines Table -->
        <div class="hud-glass-card p-0 font-mono overflow-hidden">
          <div class="border-b border-[#0A0A0A] bg-[#0A0A0A] text-white px-4 py-2 text-xs font-bold tracking-wider">
            <I18nText ru="ПРЯМЫЕ КОНТАКТЫ ПОДРАЗДЕЛЕНИЙ" uz="BO'LIMLARNING TO'G'RIDAN-TO'G'RI KONTAKTLARI" en="DIRECT DEPARTMENTAL CONTACTS" />
          </div>
          <div class="divide-y divide-[#0A0A0A]/20 text-xs">
            {contactsData.departments.map((dept) => (
              <div class="p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-[#C8CDD2]/50">
                <div>
                  <span class="font-bold text-[#0A0A0A] block text-sm">
                    <I18nText ru={dept.name} uz={dept.name_uz} en={dept.name_en} />
                  </span>
                  <span class="text-[#4A5056]">
                    <I18nText ru={dept.desc} uz={dept.desc_uz} en={dept.desc_en} />
                  </span>
                </div>
                <div class="text-right">
                  <a href={`tel:${dept.phone.replace(/[\s-]/g, '')}`} class="font-bold text-sm text-[#0A0A0A] hover:underline block">
                    {dept.phone}
                  </a>
                  <a href={`mailto:${dept.email}`} class="text-[11px] text-[#4A5056] hover:underline">
                    {dept.email}
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Logistics & Access Guidelines -->
        <div class="hud-glass-card p-6 font-mono text-xs">
          <div class="text-xs font-bold text-[#0A0A0A] border-b border-[#0A0A0A] pb-2 mb-3">
            <I18nText
              ru="ИНСТРУКЦИЯ ПО ПРОЕЗДУ ДЛЯ ГРУЗОВОГО ТРАНСПОРТА:"
              uz="YUK TRANSPORTI UCHUN HARAKAT YO'RIQNOMASI:"
              en="HEAVY TRANSPORT ACCESS GUIDELINES:"
            />
          </div>
          <div class="space-y-3 text-[#4A5056] font-sans">
            {contactsData.logisticsInstructions.map((instruction, idx) => {
              const instrUz = contactsData.logisticsInstructions_uz && contactsData.logisticsInstructions_uz[idx];
              const instrEn = contactsData.logisticsInstructions_en && contactsData.logisticsInstructions_en[idx];
              return (
                <p>
                  <I18nText ru={instruction} uz={instrUz} en={instrEn} />
                </p>
              );
            })}
          </div>

          <div class="mt-4 pt-3 border-t border-[#0A0A0A]/20 flex items-center justify-between text-[11px]">
            <div>GPS: <span class="text-[#0A0A0A] font-bold">{contactsData.gps}</span></div>
            <a
              href={contactsData.yandexMapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hud-btn px-2.5 py-1 text-xs font-bold"
            >
              <I18nText ru="ОТКРЫТЬ НА ЯНДЕКС.КАРТАХ ↗" uz="YANDEX.XARITALARDA OCHISH ↗" en="OPEN IN YANDEX MAPS ↗" />
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Feedback & RFQ Form -->
      <div class="lg:col-span-5 flex flex-col space-y-6">
        <ContactsLeadForm client:load />

        <!-- Official Bank Details Box -->
        <div class="hud-glass-card p-5 font-mono text-xs space-y-2">
          <div class="font-bold text-[#0A0A0A]">
            <I18nText ru="БАНКОВСКИЕ РЕКВИЗИТЫ ДЛЯ ДОГОВОРОВ:" uz="SHARTNOMALAR UCHUN BANK REKVIZITLARI:" en="BANKING DETAILS FOR AGREEMENTS:" />
          </div>
          <div class="text-[11px] text-[#4A5056] space-y-1">
            <div>
              <I18nText ru="Получатель:" uz="Qabul qiluvchi:" en="Beneficiary:" />{' '}
              <span class="text-[#0A0A0A] font-bold">
                <I18nText
                  ru={contactsData.bankDetails.recipient}
                  uz={contactsData.bankDetails.recipient_uz || contactsData.bankDetails.recipient}
                  en={contactsData.bankDetails.recipient_en || contactsData.bankDetails.recipient}
                />
              </span>
            </div>
            <div>
              <I18nText ru="ИНН:" uz="STIR:" en="TIN:" />{' '}
              <span class="text-[#0A0A0A] font-bold">{globalData.inn}</span>
            </div>
            <div>
              <I18nText ru="Статус НДС:" uz="QQS maqomi:" en="VAT Status:" />{' '}
              <span class="text-[#0A0A0A] font-bold">
                <I18nText
                  ru={contactsData.bankDetails.vatCode}
                  uz={contactsData.bankDetails.vatCode_uz || contactsData.bankDetails.vatCode}
                  en={contactsData.bankDetails.vatCode_en || contactsData.bankDetails.vatCode}
                />
              </span>
            </div>
            <div>
              <I18nText ru="Расчетный счет:" uz="Hisob raqami:" en="Settlement Account:" />{' '}
              <span class="text-[#0A0A0A]">{contactsData.bankDetails.account}</span>
            </div>
            <div>
              <I18nText ru="Банк:" uz="Bank:" en="Bank:" />{' '}
              <span>
                <I18nText
                  ru={contactsData.bankDetails.bank}
                  uz={contactsData.bankDetails.bank_uz || contactsData.bankDetails.bank}
                  en={contactsData.bankDetails.bank_en || contactsData.bankDetails.bank}
                />
              </span>
            </div>
            <div>
              <I18nText ru="МФО:" uz="MFO:" en="MFO:" /> {contactsData.bankDetails.mfo}
            </div>
          </div>

          <button
            type="button"
            id="copy-requisites-btn"
            class="hud-btn w-full mt-3 py-2 px-3 text-xs font-mono font-bold cursor-pointer flex items-center justify-center gap-1.5"
          >
            <span id="copy-btn-text">
              <I18nText
                ru="[ Скопировать реквизиты компании ]"
                uz="[ Korxona rekvizitlarini nusxalash ]"
                en="[ Copy Company Requisites ]"
              />
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{
    requisitesPayload: `ООО «RailTech»
ИНН: ${globalData.inn} (${contactsData.bankDetails.vatCode})
Р/С: ${contactsData.bankDetails.account}
Банк: ${contactsData.bankDetails.bank}
МФО: ${contactsData.bankDetails.mfo}
ОКЭД: 46.69.0
Юр. адрес: 100140, Республика Узбекистан, ${globalData.address}
ЭСФ: Didox / Soliq / Factura.uz
Телефон: ${globalData.phone}
Email: ${globalData.emailGeneral}`
  }}>
    const btn = document.getElementById('copy-requisites-btn');
    const label = document.getElementById('copy-btn-text');
    if (btn && label) {
      const originalHTML = label.innerHTML;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(requisitesPayload);
          const lang = document.documentElement.lang || 'ru';
          label.textContent = lang === 'uz' ? '[ ✓ Rekvizitlar nusxalandi ]' : lang === 'en' ? '[ ✓ Requisites copied ]' : '[ ✓ Реквизиты скопированы ]';
          btn.classList.add('bg-[#0A0A0A]', 'text-white');
          setTimeout(() => {
            label.innerHTML = originalHTML;
            btn.classList.remove('bg-[#0A0A0A]', 'text-white');
          }, 2000);
        } catch (e) {
          console.error(e);
        }
      });
    }
  </script>
</BaseLayout>
