---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/services/turnkey-import-ddp/`;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Перенаправление в раздел Услуги ВЭД DDP — ООО «RailTech»</title>
  </head>
  <body>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
    <p>Перенаправление в раздел <a href={target}>Услуги ВЭД DDP</a>...</p>
  </body>
</html>
