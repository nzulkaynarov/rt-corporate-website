---
/** Legacy URL kept for old links/bookmarks: permanent client-side redirect, excluded from the sitemap. */
import { localeHref } from '../i18n';
import { t } from '../i18n/ui';
const target = localeHref('/services/turnkey-import-ddp/', 'ru');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <title>{t('ru', 'legacyRedirect.note')}</title>
  </head>
  <body>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
    <p><a href={target}>{t('ru', 'legacyRedirect.note')}</a></p>
  </body>
</html>
