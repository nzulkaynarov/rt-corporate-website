---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import I18nText from '../../components/I18nText.astro';
import HudPageHeader from '../../components/hud/HudPageHeader.astro';
import { ProductMediaGallery } from '../../components/islands/ProductMediaGallery';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const projectUrl = `https://railtech.uz/projects/${entry.slug}`;
const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : projectUrl;

const categoryName = entry.data.category || entry.data.tag || 'Спецпроект';
const categoryNameUz = entry.data.category_uz || entry.data.tag_uz || categoryName;
const categoryNameEn = entry.data.category_en || entry.data.tag_en || categoryName;

const photoUrl = withBase(entry.data.image || '/images/hero/warehouse.jpg');
const fullPhotoUrl = photoUrl.startsWith('http') ? photoUrl : `https://railtech.uz${photoUrl}`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.subtitle || entry.data.title,
  image: fullPhotoUrl,
  url: siteUrl,
  author: {
    '@type': 'Organization',
    name: 'ООО «RailTech»',
    url: 'https://railtech.uz',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ООО «RailTech»',
    url: 'https://railtech.uz',
    logo: {
      '@type': 'ImageObject',
      url: 'https://railtech.uz/favicon.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': siteUrl,
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Главная',
      item: 'https://railtech.uz/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Проекты',
      item: 'https://railtech.uz/projects/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: entry.data.title,
      item: siteUrl,
    },
  ],
};
---

<BaseLayout
  title={`${entry.data.title} — Проекты ООО «RailTech»`}
  description={entry.data.subtitle || entry.data.title}
  keywords={`${entry.data.title}, ${categoryName}, проекты railtech, узбекистан, ddp ташкент`}
  image={photoUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="max-w-7xl mx-auto px-4 pb-16 font-sans">
    <HudPageHeader
      code={`CASE // ${entry.data.code}`}
      parent={{ href: '/projects/', label: { ru: 'ПРОЕКТЫ', uz: 'LOYIHALAR', en: 'PROJECTS' } }}
      crumb={{ ru: entry.data.title, uz: entry.data.title_uz, en: entry.data.title_en }}
      title={{ ru: entry.data.title, uz: entry.data.title_uz, en: entry.data.title_en }}
      lead={{ ru: entry.data.subtitle, uz: entry.data.subtitle_uz, en: entry.data.subtitle_en }}
    />

    <!-- Telemetry Status Bar -->
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs mb-8">
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A] font-bold border border-[#0A0A0A]">
        {entry.data.code}
      </span>
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A]">
        <I18nText ru={categoryName} uz={categoryNameUz} en={categoryNameEn} />
      </span>
      {entry.data.year && (
        <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A]">
          YEAR // {entry.data.year}
        </span>
      )}
      <span class="hud-glass-card px-2.5 py-1 text-emerald-900 font-bold bg-emerald-100/50">
        STATUS // COMPLETED
      </span>
    </div>

    <!-- Main Content Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Photo & Key Metrics -->
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <ProductMediaGallery
          client:load
          sku={entry.data.code}
          title={entry.data.title}
          title_uz={entry.data.title_uz}
          title_en={entry.data.title_en}
          category={categoryName}
          category_uz={categoryNameUz}
          category_en={categoryNameEn}
          status="COMPLETED"
          image={entry.data.image || '/images/hero/warehouse.jpg'}
          images={entry.data.images}
          gallery={entry.data.gallery}
        />

        <!-- Metrics Cards Grid -->
        {entry.data.metrics && entry.data.metrics.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono">
            {entry.data.metrics.map((m, idx) => (
              <div class="hud-glass-card p-4 flex flex-col justify-between">
                <span class="text-[10px] text-[#4A5056] border-b border-[#0A0A0A]/15 pb-1 block mb-2">
                  METRIC // 0{idx + 1}
                </span>
                <span class="font-bold text-[#0A0A0A] text-sm leading-snug">
                  <I18nText ru={m} uz={entry.data.metrics_uz?.[idx]} en={entry.data.metrics_en?.[idx]} />
                </span>
              </div>
            ))}
          </div>
        )}

        <!-- Downloadable Documents (if attached) -->
        {entry.data.documents && entry.data.documents.length > 0 && (
          <div class="hud-glass-card p-6 font-mono text-xs">
            <div class="border-b border-[#0A0A0A]/20 pb-2 mb-4 font-bold text-[#0A0A0A] flex items-center justify-between">
              <span>
                <I18nText ru="ПРИКРЕПЛЕННЫЕ МАТЕРИАЛЫ КЕЙСА" uz="LOYIHAGA BIRIKTIRILGAN MATERIALLAR" en="ATTACHED CASE MATERIALS" />
              </span>
              <span class="text-[#4A5056]">FILES // 0{entry.data.documents.length}</span>
            </div>
            <div class="space-y-2">
              {entry.data.documents.map((doc) => (
                <div class="flex items-center justify-between p-2.5 border border-[#0A0A0A]/20 bg-white/40">
                  <span class="font-bold text-[#0A0A0A]">
                    <I18nText ru={doc.title} uz={doc.title_uz} en={doc.title_en} />
                  </span>
                  <a
                    href={doc.file.startsWith('http') ? doc.file : withBase(doc.file)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hud-btn hud-btn--ghost text-[10px] py-1 px-2.5"
                  >
                    <I18nText ru="СКАЧАТЬ ↓" uz="YUKLAB OLISH ↓" en="DOWNLOAD ↓" />
                  </a>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Right Column: Case Scope, Solution & RFQ Form -->
      <div class="lg:col-span-5 flex flex-col space-y-6">
        <!-- Case Details -->
        <div class="hud-glass-card p-6">
          <div class="border-b border-[#0A0A0A]/20 pb-2 mb-4 font-mono text-xs font-bold text-[#0A0A0A] uppercase tracking-wider">
            <I18nText ru="ОПИСАНИЕ И РЕЗУЛЬТАТЫ ПРОЕКТА" uz="LOYIHA TAVSIFI VA NATIJALARI" en="PROJECT SCOPE & DELIVERABLES" />
          </div>
          <div class="prose prose-sm text-[#0A0A0A] max-w-none leading-relaxed">
            <div class="rt-lang rt-lang-ru">
              <Content />
            </div>
            <div class="rt-lang rt-lang-uz">
              {entry.data.body_uz ? <div class="space-y-4 whitespace-pre-line">{entry.data.body_uz}</div> : <Content />}
            </div>
            <div class="rt-lang rt-lang-en">
              {entry.data.body_en ? <div class="space-y-4 whitespace-pre-line">{entry.data.body_en}</div> : <Content />}
            </div>
          </div>
        </div>

        <!-- Commercial CTA Card -->
        <div class="hud-glass-card p-6 font-mono text-xs space-y-4">
          <div class="border-b border-[#0A0A0A]/20 pb-2">
            <span class="font-bold text-[#0A0A0A] text-sm block">
              <I18nText ru="ЗАКАЗАТЬ АНАЛОГИЧНЫЙ ПРОЕКТ" uz="O'XSHASH LOYIHANI BUYURTMA QILISH" en="ORDER A SIMILAR PROJECT" />
            </span>
            <span class="text-[11px] text-[#4A5056] leading-tight block mt-1">
              <I18nText
                ru="Реализация под ключ: ВЭД, инженерная адаптация, поставка со склада в Ташкенте и техническое сопровождение."
                uz="Kalit ostida amalga oshirish: TQI, muhandislik adaptatsiyasi, Toshkent omboridan yetkazib berish va texnik ko'mak."
                en="Turnkey implementation: foreign trade, engineering adaptation, Tashkent warehouse delivery, and ongoing technical support."
              />
            </span>
          </div>

          <div class="space-y-2 text-[#4A5056]">
            <div class="flex justify-between">
              <span><I18nText ru="Базис расчетов:" uz="Hisob-kitob asosi:" en="Settlement basis:" /></span>
              <span class="font-bold text-[#0A0A0A]"><I18nText ru="DDP Ташкент (12% НДС)" uz="DDP Toshkent (12% QQS)" en="DDP Tashkent (12% VAT)" /></span>
            </div>
            <div class="flex justify-between">
              <span><I18nText ru="Сроки подготовки сметы:" uz="Smeta tayyorlash muddati:" en="Proposal preparation time:" /></span>
              <span class="font-bold text-[#0A0A0A]"><I18nText ru="24-48 часов" uz="24-48 soat" en="24-48 hours" /></span>
            </div>
            <div class="flex justify-between">
              <span><I18nText ru="Прямой телефон:" uz="To'g'ridan-to'g'ri aloqa:" en="Direct line:" /></span>
              <a href="tel:+998901189000" class="font-bold text-[#0A0A0A] hover:underline">+998 90 118-90-00</a>
            </div>
          </div>

          <div class="pt-2 flex flex-col gap-2">
            <button
              type="button"
              data-lead-modal
              data-lead-subject={`Запрос на реализацию проекта по кейсу: ${entry.data.title} (${entry.data.code})`}
              class="hud-btn w-full cursor-pointer text-center"
            >
              <I18nText ru="[ ЗАКАЗАТЬ АНАЛОГИЧНЫЙ ПРОЕКТ ↗ ]" uz="[ O'XSHASH LOYIHANI BUYURTMA QILISH ↗ ]" en="[ REQUEST SIMILAR PROJECT ↗ ]" />
            </button>
            <a
              href={`${base}/projects/`}
              class="hud-btn hud-btn--ghost w-full text-center"
            >
              <I18nText ru="← ВСЕ ПРОЕКТЫ КОМПАНИИ" uz="← BARCHA LOYIHALAR" en="← ALL COMPANY PROJECTS" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
