---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import I18nText from '../../components/I18nText.astro';
import HudPageHeader from '../../components/hud/HudPageHeader.astro';
import HudViewportFrame from '../../components/hud/HudViewportFrame.astro';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const projectUrl = `https://railtech.uz/projects/${entry.slug}`;
const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : projectUrl;

const projectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.subtitle,
  image: entry.data.image ? new URL(withBase(entry.data.image), siteUrl).href : undefined,
  author: {
    '@type': 'Organization',
    name: 'ООО «RailTech»',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ООО «RailTech»',
  },
  url: siteUrl,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Главная',
      item: 'https://railtech.uz/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Проекты',
      item: 'https://railtech.uz/projects/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: entry.data.title,
      item: siteUrl,
    },
  ],
};
---

<BaseLayout
  title={`${entry.data.title} (${entry.data.code}) — Проекты ООО «RailTech»`}
  description={entry.data.subtitle}
  keywords={`${entry.data.title}, ${entry.data.category || ''}, проекты railtech, узбекистан`}
  image={withBase(entry.data.image)}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(projectJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="max-w-7xl mx-auto px-4 pb-16 font-sans">
    <HudPageHeader
      code={`PRJ // ${entry.data.code}`}
      parent={{ href: '/projects/', label: { ru: 'ПРОЕКТЫ', uz: 'LOYIHALAR', en: 'PROJECTS' } }}
      crumb={{ ru: entry.data.code, uz: entry.data.code, en: entry.data.code }}
      title={{ ru: entry.data.title, uz: entry.data.title_uz, en: entry.data.title_en }}
      lead={{ ru: entry.data.subtitle, uz: entry.data.subtitle_uz, en: entry.data.subtitle_en }}
    />

    <!-- Status Badges Bar -->
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs mb-8">
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A] font-bold border border-[#0A0A0A]">
        {entry.data.code}
      </span>
      {entry.data.category && (
        <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A]">
          <I18nText ru={entry.data.category} uz={entry.data.category_uz} en={entry.data.category_en} />
        </span>
      )}
      <span class="hud-glass-card px-2.5 py-1 text-emerald-900 font-bold bg-emerald-100/50">
        <I18nText ru="СТАТУС: РЕАЛИЗОВАН" uz="HOLAT: AMALGA OSHIRILDI" en="STATUS: DELIVERED" />
      </span>
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A]">
        ТАШКЕНТ // УЗБЕКИСТАН
      </span>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Case Study Narrative -->
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <div class="hud-glass-card p-6">
          <div class="border-b border-[#0A0A0A]/20 pb-2 mb-4 font-mono text-xs font-bold text-[#0A0A0A] uppercase tracking-wider">
            <I18nText ru="ОПИСАНИЕ И ИТОГИ ПРОЕКТА" uz="LOYIHA TAVSIFI VA NATIJALARI" en="CASE OVERVIEW & DELIVERABLES" />
          </div>
          <div class="prose prose-sm text-[#0A0A0A] max-w-none leading-relaxed">
            <div class="rt-lang rt-lang-ru">
              <Content />
            </div>
            <div class="rt-lang rt-lang-uz">
              {entry.data.body_uz ? <p>{entry.data.body_uz}</p> : <Content />}
            </div>
            <div class="rt-lang rt-lang-en">
              {entry.data.body_en ? <p>{entry.data.body_en}</p> : <Content />}
            </div>
          </div>
        </div>

        <!-- Metrics Box -->
        <div class="hud-glass-card p-5">
          <div class="border-b border-[#0A0A0A]/20 pb-2 mb-3 font-mono text-xs font-bold text-[#0A0A0A] uppercase tracking-wider">
            <I18nText ru="КЛЮЧЕВЫЕ ПОКАЗАТЕЛИ КЕЙСА" uz="LOYIHANING ASOSIY KO'RSATKICHLARI" en="KEY PERFORMANCE INDICATORS" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 font-mono text-xs">
            {entry.data.metrics.map((m, idx) => (
              <div class="p-2.5 bg-white/40 border border-[#0A0A0A]/15">
                <span class="text-[#4A5056] text-[10px] block">METRIC 0{idx + 1}</span>
                <span class="font-bold text-[#0A0A0A]">
                  <I18nText ru={m} uz={entry.data.metrics_uz?.[idx]} en={entry.data.metrics_en?.[idx]} />
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Media Frame & Action Box -->
      <div class="lg:col-span-5 flex flex-col space-y-6">
        {entry.data.image && (
          <HudViewportFrame
            topLabel={`CASE // ${entry.data.code}`}
            bottomLabel="RAILTECH SPECIAL INITIATIVE"
          >
            <div class="aspect-[16/10] overflow-hidden">
              <img
                src={withBase(entry.data.image)}
                alt={entry.data.title}
                class="w-full h-full object-cover"
                style={{ filter: 'grayscale(0.15) contrast(1.05)' }}
                loading="eager"
                decoding="async"
              />
            </div>
          </HudViewportFrame>
        )}

        <!-- Commercial Action Card -->
        <div class="hud-glass-card p-6 font-mono gap-4">
          <div class="border-b border-[#0A0A0A]/20 pb-2">
            <span class="text-xs font-bold text-[#0A0A0A] uppercase tracking-wider block">
              <I18nText ru="ИНИЦИИРОВАТЬ АНАЛОГИЧНЫЙ КЕЙС" uz="O'XSHASH LOYIHANI BOSHLASH" en="INITIATE SIMILAR PROJECT" />
            </span>
            <span class="text-[11px] text-[#4A5056]">
              <I18nText ru="Консультация с проектным бюро RailTech" uz="RailTech loyiha byurosi bilan konsultatsiya" en="Consultation with RailTech Engineering Desk" />
            </span>
          </div>

          <p class="text-xs text-[#4A5056] font-sans leading-relaxed">
            <I18nText
              ru="Заинтересованы во внедрении аналогичных решений, технологическом трансфере или проведении совместных испытаний в Узбекистане?"
              uz="O'zbekistonda shunga o'xshash yechimlarni joriy etish, texnologiyalar transferi yoki birgalikda sinovlar o'tkazishga qiziqasizmi?"
              en="Interested in deploying similar solutions, technology localization, or coordinated track trials in Uzbekistan?"
            />
          </p>

          <div class="pt-2 flex flex-col gap-2">
            <button
              type="button"
              data-lead-modal
              data-lead-subject={`Запрос по проекту ${entry.data.title} (${entry.data.code})`}
              class="hud-btn w-full cursor-pointer"
            >
              <I18nText ru="ОБСУДИТЬ ПРОЕКТ ↗" uz="LOYIHANI MUHOKAMA QILISH ↗" en="DISCUSS PROJECT ↗" />
            </button>
            <a
              href={`${base}/projects/`}
              class="hud-btn hud-btn--ghost w-full text-center"
            >
              <I18nText ru="← ВСЕ ПРОЕКТЫ" uz="← BARCHA LOYIHALAR" en="← ALL PROJECTS" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

