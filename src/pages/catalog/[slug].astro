---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ProductMediaGallery } from '../../components/islands/ProductMediaGallery';
import I18nText from '../../components/I18nText.astro';
import HudPageHeader from '../../components/hud/HudPageHeader.astro';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const catalogEntries = await getCollection('catalog');
  return catalogEntries.map((entry) => {
    const entryCat = entry.data.category || entry.data.subsystem || '';
    const related = catalogEntries
      .filter((e) => e.slug !== entry.slug)
      .sort((a, b) => {
        const aCat = a.data.category || a.data.subsystem || '';
        const bCat = b.data.category || b.data.subsystem || '';
        const aMatch = aCat === entryCat;
        const bMatch = bCat === entryCat;
        if (aMatch && !bMatch) return -1;
        if (!aMatch && bMatch) return 1;
        return 0;
      })
      .slice(0, 3);

    return {
      params: { slug: entry.slug },
      props: { entry, related },
    };
  });
}

const { entry, related } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const productUrl = `https://railtech.uz/catalog/${entry.slug}`;
const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : productUrl;

const categoryName = entry.data.category || entry.data.subsystem || 'Оборудование';
const categoryNameUz = entry.data.category_uz || entry.data.subsystem_uz || categoryName;
const categoryNameEn = entry.data.category_en || entry.data.subsystem_en || categoryName;

const mainImageUrl = entry.data.image || `/images/catalog/${entry.data.sku.toLowerCase()}.jpg`;

const productJsonLd = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: entry.data.title,
  image: mainImageUrl.startsWith('http') ? mainImageUrl : new URL(withBase(mainImageUrl), siteUrl).href,
  description: entry.data.specs || entry.data.title,
  sku: entry.data.sku,
  mpn: entry.data.sku,
  category: categoryName,
  brand: {
    '@type': 'Brand',
    name: 'RailTech',
  },
  offers: {
    '@type': 'Offer',
    url: siteUrl,
    priceCurrency: 'UZS',
    price: entry.data.price || '0',
    priceValidUntil: '2026-12-31',
    itemCondition: 'https://schema.org/NewCondition',
    availability: 'https://schema.org/InStock',
    seller: {
      '@type': 'Organization',
      name: 'ООО «RailTech»',
    },
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Главная',
      item: 'https://railtech.uz/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Каталог товаров',
      item: 'https://railtech.uz/catalog/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: entry.data.title,
      item: siteUrl,
    },
  ],
};
---

<BaseLayout
  title={`${entry.data.title} (${entry.data.sku}) — Спецификация оборудования | ООО «RailTech»`}
  description={`Технические параметры и заказ: ${entry.data.title} (${entry.data.sku}). Категория: ${categoryName}. Склад: ${entry.data.warehouse}. Официальная поставка в Ташкенте с НДС 12%.`}
  keywords={`${entry.data.title}, ${entry.data.sku}, промышленное оборудование, ташкент, склад index, узбекистан`}
  image={withBase(mainImageUrl)}
>
  <!-- Product & Breadcrumb Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="max-w-7xl mx-auto px-4 pb-16 font-sans">
    <HudPageHeader
      code={`SKU // ${entry.data.sku}`}
      parent={{ href: '/catalog/', label: { ru: 'КАТАЛОГ', uz: 'KATALOG', en: 'CATALOG' } }}
      crumb={{ ru: entry.data.sku, uz: entry.data.sku, en: entry.data.sku }}
      title={{ ru: entry.data.title, uz: entry.data.title_uz, en: entry.data.title_en }}
      lead={entry.data.specs ? { ru: entry.data.specs, uz: entry.data.specs_uz, en: entry.data.specs_en } : undefined}
    />

    <!-- Status and Meta Badges Bar -->
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs mb-8">
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A] font-bold border border-[#0A0A0A]">
        {entry.data.sku}
      </span>
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A]">
        <I18nText ru={categoryName} uz={categoryNameUz} en={categoryNameEn} />
      </span>
      <span class="hud-glass-card px-2.5 py-1 text-emerald-900 font-bold bg-emerald-100/50">
        <I18nText ru={entry.data.status} uz={entry.data.status_uz} en={entry.data.status_en} />
      </span>
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A]">
        <I18nText ru="НДС 12% ВКЛЮЧЕН" uz="12% QQS BILAN" en="12% VAT INCLUDED" />
      </span>
      {entry.data.price && (
        <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A] font-bold">
          {entry.data.price}
        </span>
      )}
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Specs Table & Detailed Text -->
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <!-- Technical Specifications Table -->
        <div class="hud-glass-card p-6">
          <div class="border-b border-[#0A0A0A]/20 pb-2 mb-4 flex justify-between items-center font-mono text-xs">
            <span class="font-bold text-[#0A0A0A] tracking-wider uppercase">
              <I18nText ru="ТЕХНИЧЕСКИЕ ХАРАКТЕРИСТИКИ" uz="TEXNIK XUSUSIYATLAR" en="TECHNICAL SPECIFICATIONS" />
            </span>
            <span class="text-[#4A5056]">RT // TECHNICAL-SPEC</span>
          </div>

          <table class="w-full font-mono text-xs border-collapse">
            <tbody class="divide-y divide-[#0A0A0A]/15">
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056] w-2/5">
                  <I18nText ru="Артикул / SKU:" uz="Artikul / SKU:" en="Part Number / SKU:" />
                </td>
                <td class="py-2.5 font-bold text-[#0A0A0A]">{entry.data.sku}</td>
              </tr>
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056]">
                  <I18nText ru="Категория:" uz="Kategoriya:" en="Category:" />
                </td>
                <td class="py-2.5 text-[#0A0A0A]">
                  <I18nText ru={categoryName} uz={categoryNameUz} en={categoryNameEn} />
                </td>
              </tr>
              {/* Dynamic CMS attributes */}
              {entry.data.attributes && entry.data.attributes.map((attr) => (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="py-2.5 pr-3 text-[#4A5056]">
                    <I18nText ru={attr.label} uz={attr.label_uz} en={attr.label_en} />
                  </td>
                  <td class="py-2.5 font-bold text-[#0A0A0A]">
                    <I18nText ru={attr.value} uz={attr.value_uz} en={attr.value_en} />
                  </td>
                </tr>
              ))}
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056]">
                  <I18nText ru="Базис отгрузки:" uz="Yuklash ombori:" en="Dispatch Facility:" />
                </td>
                <td class="py-2.5 font-bold text-[#0A0A0A]">
                  <I18nText ru={entry.data.warehouse} uz={entry.data.warehouse_uz || entry.data.warehouse} en={entry.data.warehouse_en || entry.data.warehouse} />
                </td>
              </tr>
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056]">
                  <I18nText ru="Гарантия:" uz="Kafolat:" en="Warranty:" />
                </td>
                <td class="py-2.5 text-[#0A0A0A]">
                  <I18nText
                    ru={entry.data.warranty || '12 месяцев с момента ввода в эксплуатацию'}
                    uz={entry.data.warranty_uz}
                    en={entry.data.warranty_en}
                  />
                </td>
              </tr>
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056]">
                  <I18nText ru="Условия цены:" uz="Narx shartlari:" en="Pricing Terms:" />
                </td>
                <td class="py-2.5 font-bold text-[#0A0A0A]">
                  <I18nText
                    ru={entry.data.priceNote || 'Цена по запросу (с НДС 12%)'}
                    uz={entry.data.priceNote_uz}
                    en={entry.data.priceNote_en}
                  />
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Detailed Description Content -->
        <div class="hud-glass-card p-6">
          <div class="border-b border-[#0A0A0A]/20 pb-2 mb-4 font-mono text-xs font-bold text-[#0A0A0A] uppercase tracking-wider">
            <I18nText ru="ОПИСАНИЕ И ЭКСПЛУАТАЦИОННЫЕ ОСОБЕННОСТИ" uz="TAVSIF VA FOYDALANISH XUSUSIYATLARI" en="DESCRIPTION & OPERATIONAL PARAMETERS" />
          </div>
          <div class="prose prose-sm text-[#0A0A0A] max-w-none leading-relaxed">
            <div class="rt-lang rt-lang-ru">
              <Content />
            </div>
            <div class="rt-lang rt-lang-uz">
              {entry.data.body_uz ? <p>{entry.data.body_uz}</p> : <Content />}
            </div>
            <div class="rt-lang rt-lang-en">
              {entry.data.body_en ? <p>{entry.data.body_en}</p> : <Content />}
            </div>
          </div>
        </div>

        <!-- Downloadable Documentation & Files -->
        {entry.data.documents && entry.data.documents.length > 0 && (
          <div class="hud-glass-card p-6">
            <div class="border-b border-[#0A0A0A]/20 pb-2 mb-4 flex justify-between items-center font-mono text-xs">
              <span class="font-bold text-[#0A0A0A] tracking-wider uppercase flex items-center gap-2">
                <span class="w-2 h-2 bg-[#0A0A0A] inline-block"></span>
                <I18nText ru="ДОКУМЕНТАЦИЯ И ФАЙЛЫ ДЛЯ СКАЧИВАНИЯ" uz="HUJJATLAR VA YUKLAB OLISH UCHUN FAYLLAR" en="DOCUMENTATION & DOWNLOADABLE FILES" />
              </span>
              <span class="text-[#4A5056]">FILES // 0{entry.data.documents.length}</span>
            </div>
            <div class="space-y-2.5 font-mono text-xs">
              {entry.data.documents.map((doc) => {
                const fileUrl = doc.file.startsWith('http') ? doc.file : withBase(doc.file);
                return (
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3 border border-[#0A0A0A]/20 bg-white/40 hover:bg-white/80 transition-colors gap-2">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <span class="text-base select-none">📄</span>
                      <div class="min-w-0">
                        <div class="font-bold text-[#0A0A0A] truncate">
                          <I18nText ru={doc.title} uz={doc.title_uz} en={doc.title_en} />
                        </div>
                        <div class="text-[10px] text-[#4A5056] uppercase tracking-wider">
                          {doc.type || 'PDF DOCUMENT'}
                        </div>
                      </div>
                    </div>
                    <a
                      href={fileUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hud-btn hud-btn--ghost text-[11px] py-1.5 px-3 self-start sm:self-auto text-center shrink-0"
                    >
                      <I18nText ru="СКАЧАТЬ / ОТКРЫТЬ ↓" uz="YUKLAB OLISH / OCHISH ↓" en="DOWNLOAD / OPEN ↓" />
                    </a>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        <!-- Completeness of Supply & Regulatory Box -->
        <div class="hud-glass-card p-5 font-mono text-xs space-y-2">
          <div class="font-bold text-[#0A0A0A] flex items-center gap-2">
            <span class="w-2 h-2 bg-[#0A0A0A] inline-block"></span>
            <I18nText ru="КОМПЛЕКТНОСТЬ ПОСТАВКИ И ДОКУМЕНТЫ:" uz="YETKAZIB BERISH TO'PLAMI VA HUJJATLAR:" en="COMPLETENESS OF SUPPLY & DOCUMENTATION:" />
          </div>
          <div class="text-[#4A5056] space-y-1.5 text-[11px] leading-relaxed">
            <div>
              <I18nText
                ru="• Оригинальный технический паспорт и сертификат соответствия завода-изготовителя."
                uz="• Ishlab chiqaruvchining asl texnik pasporti va muvofiqlik sertifikati."
                en="• Original manufacturer technical passport and certificate of conformity."
              />
            </div>
            <div>
              <I18nText
                ru="• Сертификаты соответствия техническим регламентам и стандартам Республики Узбекистан."
                uz="• O'zbekiston Respublikasi texnik reglamentlari va standartlariga muvofiqlik sertifikatlari."
                en="• Certificates of conformity with technical regulations and standards of Uzbekistan."
              />
            </div>
            <div>
              <I18nText
                ru="• Товарно-транспортная накладная, акт приема-передачи и электронный счет-фактура (ЭСФ Didox) с НДС 12%."
                uz="• Tovar-transport yukxati, topshirish-qabul qilish dalolatnomasi va 12% QQS bilan EHF (Didox)."
                en="• Waybill, certificate of acceptance, and electronic tax invoice (Didox) with 12% VAT."
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Media Gallery & Commercial Ordering Card -->
      <div class="lg:col-span-5 flex flex-col space-y-6">
        <ProductMediaGallery
          client:load
          sku={entry.data.sku}
          title={entry.data.title}
          title_uz={entry.data.title_uz}
          title_en={entry.data.title_en}
          category={categoryName}
          category_uz={categoryNameUz}
          category_en={categoryNameEn}
          status={entry.data.status}
          status_uz={entry.data.status_uz}
          status_en={entry.data.status_en}
          specs={entry.data.specs}
          specs_uz={entry.data.specs_uz}
          specs_en={entry.data.specs_en}
          image={mainImageUrl}
          images={entry.data.images}
          gallery={entry.data.gallery}
        />

        <!-- Commercial Action Box -->
        <div class="hud-glass-card p-6 font-mono gap-4">
          <div class="border-b border-[#0A0A0A]/20 pb-2">
            <span class="text-xs font-bold text-[#0A0A0A] uppercase tracking-wider block">
              <I18nText ru="ОТДЕЛ СНАБЖЕНИЯ // ТАШКЕНТ" uz="TA'MINOT BO'LIMI // TOSHKENT" en="PROCUREMENT DESK // TASHKENT" />
            </span>
            <span class="text-[11px] text-[#4A5056]">
              <I18nText ru="Отгрузка со склада Index B2-2097 от 24 часов" uz="Index B2-2097 omboridan 24 soatdan yuklash" en="Dispatch from Index B2-2097 from 24 hours" />
            </span>
          </div>

          <div class="space-y-2 text-xs">
            <div class="flex justify-between text-[#4A5056]">
              <span><I18nText ru="Статус наличия:" uz="Mavjudlik holati:" en="Stock status:" /></span>
              <span class="font-bold text-[#0A0A0A]">
                <I18nText ru={entry.data.status} uz={entry.data.status_uz} en={entry.data.status_en} />
              </span>
            </div>
            <div class="flex justify-between text-[#4A5056]">
              <span><I18nText ru="Налогообложение:" uz="Soliqqa tortish:" en="Taxation:" /></span>
              <span class="font-bold text-[#0A0A0A]">
                <I18nText ru="НДС 12% включен" uz="12% QQS kiritilgan" en="12% VAT included" />
              </span>
            </div>
            <div class="flex justify-between text-[#4A5056]">
              <span><I18nText ru="Отдел продаж:" uz="Sotuv bo'limi:" en="Sales direct:" /></span>
              <a href="tel:+998901189000" class="font-bold text-[#0A0A0A] hover:underline">+998 90 118-90-00</a>
            </div>
          </div>

          <div class="pt-2 flex flex-col gap-2">
            <button
              type="button"
              data-lead-modal
              data-lead-subject={`Запрос счета на позицию ${entry.data.title} (${entry.data.sku})`}
              class="hud-btn w-full cursor-pointer"
            >
              <I18nText ru="ЗАПРОСИТЬ КП / СЧЕТ ↗" uz="TIJORAT TAKLIFI / HISOB SO'ROVI ↗" en="REQUEST QUOTE / INVOICE ↗" />
            </button>
            <a
              href={`${base}/catalog/`}
              class="hud-btn hud-btn--ghost w-full text-center"
            >
              <I18nText ru="← ВЕРНУТЬСЯ В КАТАЛОГ" uz="← KATALOGGA QAYTISH" en="← BACK TO CATALOG" />
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    {related && related.length > 0 && (
      <div class="mt-12 pt-8 border-t border-[#0A0A0A]/20 font-mono">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-[#0A0A0A] inline-block"></span>
            <h2 class="text-sm sm:text-base font-bold text-[#0A0A0A] uppercase tracking-wider">
              <I18nText ru="ПОХОЖИЕ ПОЗИЦИИ ИЗ КАТАЛОГА" uz="KATALOGDAGI O'XSHASH MAHSULOTLAR" en="SIMILAR ITEMS FROM CATALOG" />
            </h2>
          </div>
          <a href={`${base}/catalog/`} class="text-xs font-bold text-[#0A0A0A] hover:underline">
            <I18nText ru="ВЕСЬ КАТАЛОГ →" uz="BARCHA KATALOG →" en="VIEW FULL CATALOG →" />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {related.map((item) => (
            <a
              href={`${base}/catalog/${item.slug}`}
              class="hud-glass-card p-4 group flex flex-col justify-between hover:border-[#0A0A0A] transition-all"
            >
              <div>
                <div class="hud-viewport-frame mb-3 overflow-hidden aspect-[16/10]">
                  <img
                    src={withBase(item.data.image || `/images/catalog/${item.data.sku.toLowerCase()}.jpg`)}
                    alt={item.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="flex items-center justify-between text-[11px] text-[#4A5056] mb-1">
                  <span class="font-bold text-[#0A0A0A]">{item.data.sku}</span>
                  <span class="uppercase truncate max-w-[50%]">{item.data.category || item.data.subsystem}</span>
                </div>
                <h3 class="text-xs sm:text-sm font-bold text-[#0A0A0A] line-clamp-2 mb-2 group-hover:underline">
                  {item.data.title}
                </h3>
              </div>
              <div class="pt-3 border-t border-[#0A0A0A]/15 flex items-center justify-between text-xs mt-2">
                <span class="text-emerald-900 font-bold text-[11px] bg-emerald-100/60 px-1.5 py-0.5">
                  {item.data.status}
                </span>
                <span class="font-bold text-[#0A0A0A]">
                  Подробнее →
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
