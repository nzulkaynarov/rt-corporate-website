---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ProductMediaGallery } from '../../components/islands/ProductMediaGallery';
import I18nText from '../../components/I18nText.astro';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const catalogEntries = await getCollection('catalog');
  return catalogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const productUrl = `https://railtech.uz/catalog/${entry.slug}`;
const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : productUrl;

const productJsonLd = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: entry.data.title,
  image: entry.data.image
    ? (entry.data.image.startsWith('http') ? entry.data.image : new URL(withBase(entry.data.image), siteUrl).href)
    : `https://railtech.uz/images/catalog/${entry.data.sku.toLowerCase()}.jpg`,
  description: entry.data.specs,
  sku: entry.data.sku,
  mpn: entry.data.gost,
  brand: {
    '@type': 'Brand',
    name: 'RailTech',
  },
  offers: {
    '@type': 'Offer',
    url: siteUrl,
    priceCurrency: 'UZS',
    price: '0',
    priceValidUntil: '2026-12-31',
    itemCondition: 'https://schema.org/NewCondition',
    availability: 'https://schema.org/InStock',
    seller: {
      '@type': 'Organization',
      name: 'ООО «RailTech»',
    },
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Главная',
      item: 'https://railtech.uz/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Каталог оборудования',
      item: 'https://railtech.uz/catalog/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: entry.data.title,
      item: siteUrl,
    },
  ],
};
---

<BaseLayout
  title={`${entry.data.title} (${entry.data.sku}) — Паспорт изделия | ООО «RailTech» Ташкент`}
  description={`Технический паспорт и заказ ${entry.data.title} (${entry.data.sku}). Стандарт ${entry.data.gost}, ТН ВЭД ${entry.data.tnved}. Склад в Ташкенте (ТПК Index B2-2097). Поставка с НДС 12%.`}
  keywords={`${entry.data.title}, ${entry.data.sku}, ${entry.data.gost}, ${entry.data.tnved}, купить в ташкенте, жд запчасти узбекистан`}
  image={withBase(entry.data.image)}
>
  <!-- Product & Breadcrumb Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="max-w-7xl mx-auto px-4 py-10 font-sans">
    <!-- Breadcrumbs -->
    <div class="flex items-center space-x-2 font-mono text-xs text-[#4A5056] mb-6">
      <a href={`${base}/`} class="hover:underline">
        <I18nText ru="ГЛАВНАЯ" uz="BOSH SAHIFA" en="HOME" />
      </a>
      <span>/</span>
      <a href={`${base}/catalog/`} class="hover:underline">
        <I18nText ru="КАТАЛОГ ЖД ОБОРУДОВАНИЯ" uz="TEMIR YO'L KATALOGI" en="RAILWAY CATALOG" />
      </a>
      <span>/</span>
      <span class="text-[#0A0A0A] font-bold">{entry.data.sku}</span>
    </div>

    <!-- Product Header Box -->
    <div class="border-b-2 border-[#0A0A0A] pb-6 mb-8">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs mb-3">
        <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-2 py-0.5 font-bold">
          <I18nText ru={`АРТИКУЛ: ${entry.data.sku}`} uz={`ARTIKUL: ${entry.data.sku}`} en={`SKU: ${entry.data.sku}`} />
        </span>
        <span class="border border-[#0A0A0A] bg-[#C8CDD2] px-2 py-0.5 text-[#0A0A0A]">
          <I18nText ru={`СИСТЕМА: ${entry.data.subsystem}`} uz={`TIZIM: ${entry.data.subsystem_uz || entry.data.subsystem}`} en={`SYSTEM: ${entry.data.subsystem_en || entry.data.subsystem}`} />
        </span>
        <span class="border border-emerald-600 bg-emerald-100 text-emerald-900 px-2 py-0.5 font-bold">
          <I18nText ru={`СТАТУС: ${entry.data.status}`} uz={`MAQOM: ${entry.data.status_uz || entry.data.status}`} en={`STATUS: ${entry.data.status_en || entry.data.status}`} />
        </span>
        <span class="border border-[#0A0A0A] px-2 py-0.5 font-bold text-[#0A0A0A]">
          <I18nText ru="НДС 12%" uz="QQS 12%" en="VAT 12%" />
        </span>
      </div>

      <I18nText
        ru={entry.data.title}
        uz={entry.data.title_uz}
        en={entry.data.title_en}
        as="h1"
        class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#0A0A0A] tracking-tight mb-2"
      />

      <I18nText
        ru={entry.data.specs}
        uz={entry.data.specs_uz}
        en={entry.data.specs_en}
        as="p"
        class="text-base text-[#4A5056] font-mono"
      />
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Left Column: Specs Table & Details -->
      <div class="lg:col-span-7 flex flex-col space-y-8">
        <!-- Technical Passport Table -->
        <div class="border-2 border-[#0A0A0A] bg-[#D4D8DC]">
          <div class="border-b border-[#0A0A0A] bg-[#0A0A0A] text-white px-4 py-2 font-mono text-xs font-bold tracking-wider flex justify-between items-center">
            <span>
              <I18nText ru="ТЕХНИЧЕСКИЙ ПАСПОРТ ИЗДЕЛИЯ" uz="MAHSULOT TEXNIK PASPORTI" en="PRODUCT TECHNICAL DATASHEET" />
            </span>
            <span class="text-zinc-400">PASSPORT-DOC // UZ-GOST</span>
          </div>

          <table class="w-full font-mono text-xs border-collapse">
            <tbody class="divide-y divide-[#0A0A0A]/20">
              <tr class="hover:bg-[#C8CDD2]/50">
                <td class="p-3 text-[#4A5056] w-1/3">
                  <I18nText ru="Номенклатурный код (SKU):" uz="Nomenklatura kodi (SKU):" en="Part Number (SKU):" />
                </td>
                <td class="p-3 font-bold text-[#0A0A0A]">{entry.data.sku}</td>
              </tr>
              <tr class="hover:bg-[#C8CDD2]/50">
                <td class="p-3 text-[#4A5056]">
                  <I18nText ru="Государственный стандарт:" uz="Davlat standarti:" en="Government Standard:" />
                </td>
                <td class="p-3 font-bold text-[#0A0A0A]">{entry.data.gost}</td>
              </tr>
              <tr class="hover:bg-[#C8CDD2]/50">
                <td class="p-3 text-[#4A5056]">
                  <I18nText ru="Код ТН ВЭД Республики Узбекистан:" uz="O'zbekiston TIF TN kodi:" en="Uzbekistan HS Code:" />
                </td>
                <td class="p-3 font-bold text-[#0A0A0A]">{entry.data.tnved}</td>
              </tr>
              <tr class="hover:bg-[#C8CDD2]/50">
                <td class="p-3 text-[#4A5056]">
                  <I18nText ru="Назначение и классификация:" uz="Vazifasi va klassifikatsiyasi:" en="Subsystem & Purpose:" />
                </td>
                <td class="p-3 text-[#0A0A0A]">
                  <I18nText ru={entry.data.subsystem} uz={entry.data.subsystem_uz} en={entry.data.subsystem_en} />
                </td>
              </tr>
              <tr class="hover:bg-[#C8CDD2]/50">
                <td class="p-3 text-[#4A5056]">
                  <I18nText ru="Склад отгрузки:" uz="Yuklash ombori:" en="Dispatch Facility:" />
                </td>
                <td class="p-3 font-bold text-[#0A0A0A]">
                  <I18nText ru={entry.data.warehouse} uz={entry.data.warehouse_uz || entry.data.warehouse} en={entry.data.warehouse_en || entry.data.warehouse} />
                </td>
              </tr>
              <tr class="hover:bg-[#C8CDD2]/50">
                <td class="p-3 text-[#4A5056]">
                  <I18nText ru="Заводская гарантия:" uz="Zavod kafolati:" en="Manufacturer Warranty:" />
                </td>
                <td class="p-3 text-[#0A0A0A]">
                  <I18nText
                    ru={entry.data.warranty || '12 месяцев с момента ввода в эксплуатацию'}
                    uz={entry.data.warranty_uz || 'Foydalanishga topshirilgan kundan boshlab 12 oy'}
                    en={entry.data.warranty_en || '12 months from commissioning date'}
                  />
                </td>
              </tr>
              <tr class="hover:bg-[#C8CDD2]/50">
                <td class="p-3 text-[#4A5056]">
                  <I18nText ru="Условия ценообразования:" uz="Narx belgilash shartlari:" en="Pricing Terms:" />
                </td>
                <td class="p-3 font-bold text-[#0A0A0A]">
                  <I18nText
                    ru={entry.data.priceNote || 'Цена по запросу (с НДС 12%)'}
                    uz={entry.data.priceNote_uz || 'Narx so\'rov bo\'yicha (12% QQS bilan)'}
                    en={entry.data.priceNote_en || 'Price on request (incl. 12% VAT)'}
                  />
                </td>
              </tr>
              <tr class="hover:bg-[#C8CDD2]/50">
                <td class="p-3 text-[#4A5056]">
                  <I18nText ru="Входной контроль:" uz="Kirish nazorati:" en="Quality Verification:" />
                </td>
                <td class="p-3 text-emerald-800 font-bold">
                  <I18nText
                    ru="УЗК-дефектоскопия пройдена, бирка завода сохранена"
                    uz="UZD-defektoskopiya o'tkazilgan, zavod yorlig'i saqlangan"
                    en="Ultrasonic NDT inspection passed, factory tags verified"
                  />
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Detailed Description Content -->
        <div class="border border-[#0A0A0A] bg-[#C8CDD2] p-6 font-sans">
          <h2 class="font-mono text-xs font-bold text-[#0A0A0A] uppercase tracking-wider border-b border-[#0A0A0A] pb-2 mb-4">
            <I18nText ru="ОПИСАНИЕ И ЭКСПЛУАТАЦИОННЫЕ ОСОБЕННОСТИ" uz="TAVSIF VA FOYDALANISH XUSUSIYATLARI" en="DESCRIPTION & OPERATIONAL PARAMETERS" />
          </h2>
          <div class="prose prose-sm text-[#0A0A0A] leading-relaxed">
            <div class="rt-lang rt-lang-ru">
              <Content />
            </div>
            <div class="rt-lang rt-lang-uz">
              {entry.data.body_uz ? <p>{entry.data.body_uz}</p> : <Content />}
            </div>
            <div class="rt-lang rt-lang-en">
              {entry.data.body_en ? <p>{entry.data.body_en}</p> : <Content />}
            </div>
          </div>
        </div>

        <!-- Compliance & Regulatory Box -->
        <div class="border border-[#0A0A0A]/40 bg-[#D4D8DC] p-4 font-mono text-xs space-y-2">
          <div class="font-bold text-[#0A0A0A]">
            <I18nText ru="КОМПЛЕКТНОСТЬ ПОСТАВКИ И ДОКУМЕНТЫ:" uz="YETKAZIB BERISH TO'PLAMI VA HUJJATLAR:" en="COMPLETENESS OF SUPPLY & DOCUMENTATION:" />
          </div>
          <div class="text-[#4A5056] space-y-1 text-[11px]">
            <div>
              <I18nText
                ru="• Оригинальный паспорт завода-изготовителя с отметкой ОТК и сертификатом плавки."
                uz="• OTK belgisi va quyma sertifikatiga ega ishlab chiqaruvchining asl pasporti."
                en="• Original manufacturer quality passport with QC stamp and heat certificate."
              />
            </div>
            <div>
              <I18nText
                ru="• Сертификат соответствия требованиям ТР ТС 001/2011 «О безопасности железнодорожного подвижного состава»."
                uz="• «Temir yo'l harakatdagi tarkibi xavfsizligi to'g'risida»gi TR TS 001/2011 muvofiqlik sertifikati."
                en="• Certificate of conformity with TR CU 001/2011 «On Safety of Railway Rolling Stock»."
              />
            </div>
            <div>
              <I18nText
                ru="• Товарно-транспортная накладная, акт приема-передачи и электронный счет-фактура (ЭСФ Didox) с НДС 12%."
                uz="• Tovar-transport yukxati, topshirish-qabul qilish dalolatnomasi va 12% QQS bilan EHF (Didox)."
                en="• Waybill, certificate of acceptance, and electronic tax invoice (Didox) with 12% VAT."
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Product Media Gallery & Commercial Card -->
      <div class="lg:col-span-5 flex flex-col space-y-6">
        <!-- Product Media Gallery (Photo, Blueprint, 3D CAD) -->
        <ProductMediaGallery
          client:load
          sku={entry.data.sku}
          title={entry.data.title}
          title_uz={entry.data.title_uz}
          title_en={entry.data.title_en}
          gost={entry.data.gost}
          subsystem={entry.data.subsystem}
          subsystem_uz={entry.data.subsystem_uz}
          subsystem_en={entry.data.subsystem_en}
          specs={entry.data.specs}
          specs_uz={entry.data.specs_uz}
          specs_en={entry.data.specs_en}
          modelType={entry.data.modelType || 'bogie'}
          image={withBase(entry.data.image)}
        />

        <!-- Commercial Action Box -->
        <div class="border-2 border-[#0A0A0A] bg-[#C8CDD2] p-6 font-mono">
          <div class="border-b border-[#0A0A0A] pb-2 mb-4">
            <span class="text-xs font-bold text-[#0A0A0A] uppercase tracking-wider block">
              <I18nText ru="КОММЕРЧЕСКИЙ ОТДЕЛ // ТАШКЕНТ" uz="TIJORAT BO'LIMI // TOSHKENT" en="COMMERCIAL DESK // TASHKENT" />
            </span>
            <span class="text-[11px] text-[#4A5056]">
              <I18nText ru="Отгрузка со склада Index B2-2097 за 24 часа" uz="Index B2-2097 omboridan 24 soatda yuklash" en="24-hour dispatch from Index B2-2097 warehouse" />
            </span>
          </div>

          <div class="space-y-3 mb-6">
            <div class="text-xs text-[#4A5056]">
              <I18nText ru="Текущий статус:" uz="Joriy maqom:" en="Current status:" />
              <span class="font-bold text-[#0A0A0A]">
                <I18nText ru={` ${entry.data.status}`} uz={` ${entry.data.status_uz || entry.data.status}`} en={` ${entry.data.status_en || entry.data.status}`} />
              </span>
            </div>
            <div class="text-xs text-[#4A5056]">
              <I18nText ru="Налогообложение:" uz="Soliqqa tortish:" en="Taxation:" />
              <span class="font-bold text-[#0A0A0A]">
                <I18nText ru=" НДС 12% включен в стоимость" uz=" 12% QQS narxga kiritilgan" en=" 12% VAT included in price" />
              </span>
            </div>
            <div class="text-xs text-[#4A5056]">
              <I18nText ru="Прямой телефон снабжения:" uz="To'g'ridan-to'g'ri ta'minot telefoni:" en="Direct procurement line:" />
              <a href="tel:+998901189000" class="block font-bold text-sm text-[#0A0A0A] hover:underline mt-0.5">
                +998 90 118-90-00
              </a>
            </div>
          </div>

          <div class="space-y-2">
            <button
              type="button"
              data-lead-modal
              data-lead-subject={`Запрос официального счета-фактуры на ${entry.data.title} (${entry.data.sku})`}
              class="w-full border-2 border-[#0A0A0A] bg-[#0A0A0A] text-white py-3 text-xs font-bold tracking-wider hover:bg-transparent hover:text-[#0A0A0A] transition-colors cursor-pointer"
            >
              <I18nText ru="[ ЗАПРОСИТЬ ОФИЦИАЛЬНЫЙ СЧЕТ-ФАКТУРУ ]" uz="[ RASMIY HISOB-FAKTURA SO'RASH ]" en="[ REQUEST OFFICIAL INVOICE ]" />
            </button>
            <button
              type="button"
              data-lead-modal
              data-lead-subject={`Запрос чертежей и паспорта завода на ${entry.data.title} (${entry.data.sku})`}
              class="w-full border border-[#0A0A0A] bg-white text-[#0A0A0A] py-2.5 text-xs font-bold hover:bg-[#0A0A0A] hover:text-white transition-colors cursor-pointer"
            >
              <I18nText ru="СКАЧАТЬ ЧЕРТЕЖ И ПАСПОРТ (PDF) ↗" uz="CHIZMA VA PASPORTNI YUKLASH (PDF) ↗" en="DOWNLOAD DRAWING & DATASHEET (PDF) ↗" />
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
