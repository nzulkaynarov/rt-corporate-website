---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ProductMediaGallery } from '../../components/islands/ProductMediaGallery';
import I18nText from '../../components/I18nText.astro';
import HudPageHeader from '../../components/hud/HudPageHeader.astro';
import { withBase } from '../../utils/url';

export async function getStaticPaths() {
  const catalogEntries = await getCollection('catalog');
  return catalogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const productUrl = `https://railtech.uz/catalog/${entry.slug}`;
const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : productUrl;

const categoryName = entry.data.category || entry.data.subsystem || 'Оборудование';
const categoryNameUz = entry.data.category_uz || entry.data.subsystem_uz || categoryName;
const categoryNameEn = entry.data.category_en || entry.data.subsystem_en || categoryName;

const productJsonLd = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: entry.data.title,
  image: entry.data.image
    ? (entry.data.image.startsWith('http') ? entry.data.image : new URL(withBase(entry.data.image), siteUrl).href)
    : `https://railtech.uz/images/catalog/${entry.data.sku.toLowerCase()}.jpg`,
  description: entry.data.specs || entry.data.title,
  sku: entry.data.sku,
  mpn: entry.data.gost || entry.data.sku,
  category: categoryName,
  brand: {
    '@type': 'Brand',
    name: 'RailTech',
  },
  offers: {
    '@type': 'Offer',
    url: siteUrl,
    priceCurrency: 'UZS',
    price: entry.data.price || '0',
    priceValidUntil: '2026-12-31',
    itemCondition: 'https://schema.org/NewCondition',
    availability: 'https://schema.org/InStock',
    seller: {
      '@type': 'Organization',
      name: 'ООО «RailTech»',
    },
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Главная',
      item: 'https://railtech.uz/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Каталог товаров',
      item: 'https://railtech.uz/catalog/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: entry.data.title,
      item: siteUrl,
    },
  ],
};
---

<BaseLayout
  title={`${entry.data.title} (${entry.data.sku}) — Паспорт изделия | ООО «RailTech»`}
  description={`Технический паспорт и заказ: ${entry.data.title} (${entry.data.sku}). ${entry.data.gost ? `Стандарт ${entry.data.gost}.` : ''} ${entry.data.tnved ? `ТН ВЭД ${entry.data.tnved}.` : ''} Склад: ${entry.data.warehouse}. Поставка с НДС 12%.`}
  keywords={`${entry.data.title}, ${entry.data.sku}, ${entry.data.gost || ''}, ${entry.data.tnved || ''}, купить в ташкенте, оборудование узбекистан`}
  image={withBase(entry.data.image)}
>
  <!-- Product & Breadcrumb Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="max-w-7xl mx-auto px-4 pb-16 font-sans">
    <HudPageHeader
      code={`SKU // ${entry.data.sku}`}
      parent={{ href: '/catalog/', label: { ru: 'КАТАЛОГ', uz: 'KATALOG', en: 'CATALOG' } }}
      crumb={{ ru: entry.data.sku, uz: entry.data.sku, en: entry.data.sku }}
      title={{ ru: entry.data.title, uz: entry.data.title_uz, en: entry.data.title_en }}
      lead={entry.data.specs ? { ru: entry.data.specs, uz: entry.data.specs_uz, en: entry.data.specs_en } : undefined}
    />

    <!-- Status and Meta Badges Bar -->
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs mb-8">
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A] font-bold border border-[#0A0A0A]">
        {entry.data.sku}
      </span>
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A]">
        <I18nText ru={categoryName} uz={categoryNameUz} en={categoryNameEn} />
      </span>
      <span class="hud-glass-card px-2.5 py-1 text-emerald-900 font-bold bg-emerald-100/50">
        <I18nText ru={entry.data.status} uz={entry.data.status_uz} en={entry.data.status_en} />
      </span>
      <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A]">
        <I18nText ru="НДС 12% ВКЛЮЧЕН" uz="12% QQS BILAN" en="12% VAT INCLUDED" />
      </span>
      {entry.data.price && (
        <span class="hud-glass-card px-2.5 py-1 text-[#0A0A0A] font-bold">
          {entry.data.price}
        </span>
      )}
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Specs Table & Detailed Text -->
      <div class="lg:col-span-7 flex flex-col space-y-6">
        <!-- Technical Passport Table -->
        <div class="hud-glass-card p-6">
          <div class="border-b border-[#0A0A0A]/20 pb-2 mb-4 flex justify-between items-center font-mono text-xs">
            <span class="font-bold text-[#0A0A0A] tracking-wider uppercase">
              <I18nText ru="ТЕХНИЧЕСКИЙ ПАСПОРТ ИЗДЕЛИЯ" uz="MAHSULOT TEXNIK PASPORTI" en="PRODUCT TECHNICAL DATASHEET" />
            </span>
            <span class="text-[#4A5056]">RT // PASSPORT-SPEC</span>
          </div>

          <table class="w-full font-mono text-xs border-collapse">
            <tbody class="divide-y divide-[#0A0A0A]/15">
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056] w-2/5">
                  <I18nText ru="Артикул / SKU:" uz="Artikul / SKU:" en="Part Number / SKU:" />
                </td>
                <td class="py-2.5 font-bold text-[#0A0A0A]">{entry.data.sku}</td>
              </tr>
              {entry.data.gost && (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="py-2.5 pr-3 text-[#4A5056]">
                    <I18nText ru="Стандарт / ГОСТ:" uz="Standart / GOST:" en="Standard / Specification:" />
                  </td>
                  <td class="py-2.5 font-bold text-[#0A0A0A]">{entry.data.gost}</td>
                </tr>
              )}
              {entry.data.tnved && (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="py-2.5 pr-3 text-[#4A5056]">
                    <I18nText ru="Код ТН ВЭД:" uz="TIF TN kodi:" en="HS Code:" />
                  </td>
                  <td class="py-2.5 font-bold text-[#0A0A0A]">{entry.data.tnved}</td>
                </tr>
              )}
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056]">
                  <I18nText ru="Категория:" uz="Kategoriya:" en="Category:" />
                </td>
                <td class="py-2.5 text-[#0A0A0A]">
                  <I18nText ru={categoryName} uz={categoryNameUz} en={categoryNameEn} />
                </td>
              </tr>
              {entry.data.dimensions && (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="py-2.5 pr-3 text-[#4A5056]">
                    <I18nText ru="Габариты (мм):" uz="O'lchamlar (mm):" en="Dimensions (mm):" />
                  </td>
                  <td class="py-2.5 font-bold text-[#0A0A0A]">{entry.data.dimensions}</td>
                </tr>
              )}
              {entry.data.weight && (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="py-2.5 pr-3 text-[#4A5056]">
                    <I18nText ru="Масса / вес:" uz="Massa / og'irlik:" en="Weight:" />
                  </td>
                  <td class="py-2.5 font-bold text-[#0A0A0A]">{entry.data.weight}</td>
                </tr>
              )}
              {entry.data.material && (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="py-2.5 pr-3 text-[#4A5056]">
                    <I18nText ru="Материал / сталь:" uz="Material / po'lat:" en="Material / Alloy:" />
                  </td>
                  <td class="py-2.5 font-bold text-[#0A0A0A]">{entry.data.material}</td>
                </tr>
              )}
              {/* Dynamic CMS attributes */}
              {entry.data.attributes && entry.data.attributes.map((attr) => (
                <tr class="hover:bg-white/30 transition-colors">
                  <td class="py-2.5 pr-3 text-[#4A5056]">
                    <I18nText ru={attr.label} uz={attr.label_uz} en={attr.label_en} />
                  </td>
                  <td class="py-2.5 font-bold text-[#0A0A0A]">
                    <I18nText ru={attr.value} uz={attr.value_uz} en={attr.value_en} />
                  </td>
                </tr>
              ))}
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056]">
                  <I18nText ru="Базис отгрузки:" uz="Yuklash ombori:" en="Dispatch Facility:" />
                </td>
                <td class="py-2.5 font-bold text-[#0A0A0A]">
                  <I18nText ru={entry.data.warehouse} uz={entry.data.warehouse_uz || entry.data.warehouse} en={entry.data.warehouse_en || entry.data.warehouse} />
                </td>
              </tr>
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056]">
                  <I18nText ru="Гарантия:" uz="Kafolat:" en="Warranty:" />
                </td>
                <td class="py-2.5 text-[#0A0A0A]">
                  <I18nText
                    ru={entry.data.warranty || '12 месяцев с момента ввода в эксплуатацию'}
                    uz={entry.data.warranty_uz}
                    en={entry.data.warranty_en}
                  />
                </td>
              </tr>
              <tr class="hover:bg-white/30 transition-colors">
                <td class="py-2.5 pr-3 text-[#4A5056]">
                  <I18nText ru="Условия цены:" uz="Narx shartlari:" en="Pricing Terms:" />
                </td>
                <td class="py-2.5 font-bold text-[#0A0A0A]">
                  <I18nText
                    ru={entry.data.priceNote || 'Цена по запросу (с НДС 12%)'}
                    uz={entry.data.priceNote_uz}
                    en={entry.data.priceNote_en}
                  />
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Detailed Description Content -->
        <div class="hud-glass-card p-6">
          <div class="border-b border-[#0A0A0A]/20 pb-2 mb-4 font-mono text-xs font-bold text-[#0A0A0A] uppercase tracking-wider">
            <I18nText ru="ОПИСАНИЕ И ЭКСПЛУАТАЦИОННЫЕ ОСОБЕННОСТИ" uz="TAVSIF VA FOYDALANISH XUSUSIYATLARI" en="DESCRIPTION & OPERATIONAL PARAMETERS" />
          </div>
          <div class="prose prose-sm text-[#0A0A0A] max-w-none leading-relaxed">
            <div class="rt-lang rt-lang-ru">
              <Content />
            </div>
            <div class="rt-lang rt-lang-uz">
              {entry.data.body_uz ? <p>{entry.data.body_uz}</p> : <Content />}
            </div>
            <div class="rt-lang rt-lang-en">
              {entry.data.body_en ? <p>{entry.data.body_en}</p> : <Content />}
            </div>
          </div>
        </div>

        <!-- Compliance & Regulatory Box -->
        <div class="hud-glass-card p-5 font-mono text-xs space-y-2">
          <div class="font-bold text-[#0A0A0A] flex items-center gap-2">
            <span class="w-2 h-2 bg-[#0A0A0A] inline-block"></span>
            <I18nText ru="КОМПЛЕКТНОСТЬ ПОСТАВКИ И ДОКУМЕНТЫ:" uz="YETKAZIB BERISH TO'PLAMI VA HUJJATLAR:" en="COMPLETENESS OF SUPPLY & DOCUMENTATION:" />
          </div>
          <div class="text-[#4A5056] space-y-1.5 text-[11px] leading-relaxed">
            <div>
              <I18nText
                ru="• Оригинальный паспорт завода-изготовителя с отметкой ОТК и сертификатом плавки/качества."
                uz="• OTK belgisi va sifat sertifikatiga ega ishlab chiqaruvchining asl pasporti."
                en="• Original manufacturer quality passport with QC stamp and test certificates."
              />
            </div>
            <div>
              <I18nText
                ru="• Сертификаты соответствия действующим техническим регламентам и стандартам РУз."
                uz="• O'zR amaldagi texnik reglamentlari va standartlariga muvofiqlik sertifikatlari."
                en="• Certificates of conformity with applicable technical regulations and standards."
              />
            </div>
            <div>
              <I18nText
                ru="• Товарно-транспортная накладная, акт приема-передачи и электронный счет-фактура (ЭСФ Didox) с НДС 12%."
                uz="• Tovar-transport yukxati, topshirish-qabul qilish dalolatnomasi va 12% QQS bilan EHF (Didox)."
                en="• Waybill, certificate of acceptance, and electronic tax invoice (Didox) with 12% VAT."
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Media Gallery & Commercial Ordering Card -->
      <div class="lg:col-span-5 flex flex-col space-y-6">
        <ProductMediaGallery
          client:load
          sku={entry.data.sku}
          title={entry.data.title}
          title_uz={entry.data.title_uz}
          title_en={entry.data.title_en}
          gost={entry.data.gost}
          subsystem={categoryName}
          subsystem_uz={categoryNameUz}
          subsystem_en={categoryNameEn}
          category={categoryName}
          specs={entry.data.specs}
          specs_uz={entry.data.specs_uz}
          specs_en={entry.data.specs_en}
          modelType="bogie"
          image={withBase(entry.data.image)}
        />

        <!-- Commercial Action Box -->
        <div class="hud-glass-card p-6 font-mono gap-4">
          <div class="border-b border-[#0A0A0A]/20 pb-2">
            <span class="text-xs font-bold text-[#0A0A0A] uppercase tracking-wider block">
              <I18nText ru="ОТДЕЛ СНАБЖЕНИЯ // ТАШКЕНТ" uz="TA'MINOT BO'LIMI // TOSHKENT" en="PROCUREMENT DESK // TASHKENT" />
            </span>
            <span class="text-[11px] text-[#4A5056]">
              <I18nText ru="Отгрузка со склада Index B2-2097 от 24 часов" uz="Index B2-2097 omboridan 24 soatdan yuklash" en="Dispatch from Index B2-2097 from 24 hours" />
            </span>
          </div>

          <div class="space-y-2 text-xs">
            <div class="flex justify-between text-[#4A5056]">
              <span><I18nText ru="Статус наличия:" uz="Mavjudlik holati:" en="Stock status:" /></span>
              <span class="font-bold text-[#0A0A0A]">
                <I18nText ru={entry.data.status} uz={entry.data.status_uz} en={entry.data.status_en} />
              </span>
            </div>
            <div class="flex justify-between text-[#4A5056]">
              <span><I18nText ru="Налогообложение:" uz="Soliqqa tortish:" en="Taxation:" /></span>
              <span class="font-bold text-[#0A0A0A]">
                <I18nText ru="НДС 12% включен" uz="12% QQS kiritilgan" en="12% VAT included" />
              </span>
            </div>
            <div class="flex justify-between text-[#4A5056]">
              <span><I18nText ru="Отдел продаж:" uz="Sotuv bo'limi:" en="Sales direct:" /></span>
              <a href="tel:+998901189000" class="font-bold text-[#0A0A0A] hover:underline">+998 90 118-90-00</a>
            </div>
          </div>

          <div class="pt-2 flex flex-col gap-2">
            <button
              type="button"
              data-lead-modal
              data-lead-subject={`Запрос счета на позицию ${entry.data.title} (${entry.data.sku})`}
              class="hud-btn w-full cursor-pointer"
            >
              <I18nText ru="ЗАПРОСИТЬ КП / СЧЕТ ↗" uz="TIJORAT TAKLIFI / HISOB SO'ROVI ↗" en="REQUEST QUOTE / INVOICE ↗" />
            </button>
            <a
              href={`${base}/catalog/`}
              class="hud-btn hud-btn--ghost w-full text-center"
            >
              <I18nText ru="← ВЕРНУТЬСЯ В КАТАЛОГ" uz="← KATALOGGA QAYTISH" en="← BACK TO CATALOG" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
