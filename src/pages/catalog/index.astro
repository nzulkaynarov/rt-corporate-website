---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CatalogFilterTable } from '../../components/islands/CatalogFilterTable';
import I18nText from '../../components/I18nText.astro';
import HudPageHeader from '../../components/hud/HudPageHeader.astro';
import HudStepDivider from '../../components/hud/HudStepDivider.astro';
import { withBase } from '../../utils/url';
import pagesData from '../../data/cms/pages.json';

const catalogEntries = await getCollection('catalog');
catalogEntries.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const items = catalogEntries.map((entry) => ({
  slug: entry.slug,
  sku: entry.data.sku,
  title: entry.data.title,
  title_uz: entry.data.title_uz,
  title_en: entry.data.title_en,
  category: entry.data.category || entry.data.subsystem,
  category_uz: entry.data.category_uz || entry.data.subsystem_uz,
  category_en: entry.data.category_en || entry.data.subsystem_en,
  subsystem: entry.data.subsystem || entry.data.category,
  subsystem_uz: entry.data.subsystem_uz || entry.data.category_uz,
  subsystem_en: entry.data.subsystem_en || entry.data.category_en,
  attributes: entry.data.attributes,
  price: entry.data.price,
  gost: entry.data.gost,
  tnved: entry.data.tnved,
  warehouse: entry.data.warehouse,
  status: entry.data.status,
  status_uz: entry.data.status_uz,
  status_en: entry.data.status_en,
  statusKey: entry.data.statusKey,
  specs: entry.data.specs,
  specs_uz: entry.data.specs_uz,
  specs_en: entry.data.specs_en,
  image: withBase(entry.data.image || `/images/catalog/${entry.data.sku.toLowerCase()}.jpg`),
}));
const cPage = pagesData.catalogPage;
---

<BaseLayout
  title="Каталог оборудования со склада в Ташкенте — ООО «RailTech»"
  description="Складская программа промышленного оборудования и комплектующих в Ташкенте (комплекс Index B2-2097). Паспорта качества, гарантия 12 месяцев, официальная поставка с НДС 12%."
  keywords="каталог оборудования ташкент, склад index b2-2097, поставка оборудования узбекистан, ндс 12%, технический паспорт"
>
  <div class="max-w-7xl mx-auto px-4 py-6 font-sans">
    <HudPageHeader
      code={cPage.code || 'SEC.01 // CATALOG'}
      crumb={{ ru: 'КАТАЛОГ', uz: 'KATALOG', en: 'CATALOG' }}
      title={{ ru: cPage.title, uz: cPage.title_uz, en: cPage.title_en }}
      lead={{ ru: cPage.subtitle, uz: cPage.subtitle_uz, en: cPage.subtitle_en }}
    />

    <!-- Warehouse specs banner -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8 font-mono text-xs">
      <div class="hud-glass-card p-3">
        <div class="text-[#4A5056] text-[10px]">
          <I18nText ru="ЛОКАЦИЯ СКЛАДА:" uz="OMBOR JOYI:" en="FACILITY LOCATION:" />
        </div>
        <div class="font-bold text-[#0A0A0A]">Ташкент, ТПК Index B2-2097</div>
      </div>
      <div class="hud-glass-card p-3">
        <div class="text-[#4A5056] text-[10px]">
          <I18nText ru="ЛОГИСТИЧЕСКИЙ ДОСТУП:" uz="LOGISTIKA YO'LLARI:" en="LOGISTICS ACCESS:" />
        </div>
        <div class="font-bold text-[#0A0A0A]">КПП №3 (ТПК Index)</div>
      </div>
      <div class="hud-glass-card p-3">
        <div class="text-[#4A5056] text-[10px]">
          <I18nText ru="СКОРОСТЬ ОТГРУЗКИ:" uz="YUKLASH TEZLIGI:" en="DISPATCH LEAD TIME:" />
        </div>
        <div class="font-bold text-[#0A0A0A]">
          <I18nText ru="От 24 часов" uz="24 soatdan boshlab" en="From 24 hours" />
        </div>
      </div>
      <div class="hud-glass-card p-3">
        <div class="text-[#4A5056] text-[10px]">
          <I18nText ru="ДОКУМЕНТООБОРОТ:" uz="HUJJAT AYLANISHI:" en="FISCAL E-INVOICING:" />
        </div>
        <div class="font-bold text-[#0A0A0A]">ЭСФ Didox / Soliq (12% НДС)</div>
      </div>
    </div>

    <!-- Interactive Filter Table Island -->
    <CatalogFilterTable client:load items={items} />

    <!-- Sourcing Divider & Banner from CMS -->
    <HudStepDivider label="SOURCING // RFQ" class="my-10" />

    <div class="hud-glass-card p-6 lg:p-8 flex flex-col md:flex-row items-center justify-between gap-6 font-mono">
      <div class="space-y-2">
        <div class="text-xs font-bold text-[#0A0A0A] flex items-center space-x-2">
          <span class="w-2.5 h-2.5 bg-[#0A0A0A] inline-block"></span>
          <span>
            <I18nText
              ru={cPage.ctaTitle}
              uz={cPage.ctaTitle_uz}
              en={cPage.ctaTitle_en}
            />
          </span>
        </div>
        <I18nText
          ru={cPage.ctaSubtitle}
          uz={cPage.ctaSubtitle_uz}
          en={cPage.ctaSubtitle_en}
          as="p"
          class="text-xs text-[#4A5056] max-w-2xl font-sans leading-relaxed"
        />
      </div>

      <button
        type="button"
        data-lead-modal
        data-lead-subject="Запрос подбора и поставки оборудования с сайта"
        class="hud-btn px-6 py-3 text-xs font-bold whitespace-nowrap cursor-pointer"
      >
        <I18nText
          ru={cPage.ctaButton}
          uz={cPage.ctaButton_uz}
          en={cPage.ctaButton_en}
        />
      </button>
    </div>
  </div>
</BaseLayout>
