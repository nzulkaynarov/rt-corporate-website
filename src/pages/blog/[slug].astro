---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/url';
import I18nText from '../../components/I18nText.astro';
import HudViewportFrame from '../../components/hud/HudViewportFrame.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const articleUrl = `https://railtech.uz/blog/${entry.slug}`;
const siteUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : articleUrl;

const techArticleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.summary,
  image: entry.data.image
    ? (entry.data.image.startsWith('http') ? entry.data.image : new URL(withBase(entry.data.image), siteUrl).href)
    : new URL(withBase('/og-cover.png'), siteUrl).href,
  datePublished: entry.data.publishDate,
  dateModified: entry.data.publishDate,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': siteUrl,
  },
  author: {
    '@type': 'Organization',
    name: entry.data.author || 'Инженерный отдел ООО «RailTech»',
    url: 'https://railtech.uz',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ООО «RailTech»',
    url: 'https://railtech.uz',
    logo: {
      '@type': 'ImageObject',
      url: new URL(withBase('/og-cover.png'), siteUrl).href,
    },
  },
  keywords: entry.data.tags.join(', '),
  articleSection: entry.data.category,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Главная',
      item: 'https://railtech.uz/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Блог и Новости',
      item: 'https://railtech.uz/blog/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: entry.data.title,
      item: siteUrl,
    },
  ],
};
---

<BaseLayout
  title={`${entry.data.title} — Блог инженеров ООО «RailTech»`}
  description={entry.data.summary}
  keywords={entry.data.tags.join(', ')}
  image={withBase(entry.data.image)}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(techArticleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <article class="max-w-5xl mx-auto px-4 py-10 font-sans">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="flex items-center space-x-2 font-mono text-xs text-[#4A5056] mb-6">
      <a href={`${base}/`} class="hover:underline">
        <I18nText ru="ГЛАВНАЯ" uz="BOSH SAHIFA" en="HOME" />
      </a>
      <span>/</span>
      <a href={`${base}/blog/`} class="hover:underline">
        <I18nText ru="БЛОГ & НОВОСТИ" uz="BLOG VA YANGILIKLAR" en="BLOG & NEWS" />
      </a>
      <span>/</span>
      <span class="text-[#0A0A0A] font-bold truncate max-w-xs sm:max-w-md">
        <I18nText ru={entry.data.title} uz={entry.data.title_uz} en={entry.data.title_en} />
      </span>
    </nav>

    <!-- Article Header Box -->
    <header class="border-b-2 border-[#0A0A0A] pb-6 mb-8 font-mono">
      <div class="flex flex-wrap items-center gap-2 text-xs mb-3">
        <span class="border border-[#0A0A0A] bg-[#0A0A0A] text-white px-2 py-0.5 font-bold">
          <I18nText ru={entry.data.category} uz={entry.data.category_uz} en={entry.data.category_en} />
        </span>
        <span class="border border-[#0A0A0A] bg-[#C8CDD2] px-2 py-0.5 text-[#0A0A0A]">
          <I18nText ru="ДАТА:" uz="SANA:" en="DATE:" /> {entry.data.publishDate}
        </span>
        <span class="border border-[#0A0A0A]/40 bg-[#D4D8DC] px-2 py-0.5 text-[#4A5056]">
          <I18nText ru="ВРЕМЯ ЧТЕНИЯ:" uz="O'QISH VAQTI:" en="READ TIME:" /> <I18nText ru={entry.data.readTime} uz={entry.data.readTime_uz} en={entry.data.readTime_en} />
        </span>
      </div>

      <I18nText
        as="h1"
        class="font-sans text-2xl sm:text-3xl lg:text-4xl font-bold text-[#0A0A0A] tracking-tight mb-4 leading-tight"
        ru={entry.data.title}
        uz={entry.data.title_uz}
        en={entry.data.title_en}
      />

      <I18nText
        as="p"
        class="font-sans text-base text-[#4A5056] leading-relaxed mb-4"
        ru={entry.data.summary}
        uz={entry.data.summary_uz}
        en={entry.data.summary_en}
      />

      <!-- Metadata Telemetry Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-[#0A0A0A]/20 text-xs text-[#4A5056]">
        <div>
          <I18nText ru="АВТОР:" uz="MUALLIF:" en="AUTHOR:" /> <span class="font-bold text-[#0A0A0A]">{entry.data.author}</span>
        </div>
        <div class="flex flex-wrap gap-1.5 text-[11px]">
          {entry.data.tags.map((tag) => (
            <span class="border border-[#0A0A0A]/30 bg-[#C8CDD2]/60 px-2 py-0.5 text-[#0A0A0A]">
              #{tag}
            </span>
          ))}
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Article Body -->
      <div class="lg:col-span-8">
        {entry.data.image && (
          <div class="mb-8">
            <HudViewportFrame
              topLabel={`ARTICLE // ${entry.data.category}`}
              bottomLabel="RAILTECH ENGINEERING DISPATCH"
            >
              <div class="aspect-[16/9] overflow-hidden">
                <img
                  src={withBase(entry.data.image)}
                  alt={entry.data.title}
                  class="w-full h-full object-cover"
                  style={{ filter: 'grayscale(0.15) contrast(1.05)' }}
                  loading="eager"
                  decoding="async"
                />
              </div>
            </HudViewportFrame>
          </div>
        )}

        <div class="hud-glass-card p-6 lg:p-8 font-sans">
          <div class="prose prose-sm sm:prose max-w-none text-[#0A0A0A] leading-relaxed prose-headings:font-bold prose-headings:text-[#0A0A0A] prose-headings:border-b prose-headings:border-[#0A0A0A]/30 prose-headings:pb-2 prose-pre:bg-[#0A0A0A] prose-pre:text-[#D4D8DC] prose-pre:border prose-pre:border-[#0A0A0A] prose-code:font-mono prose-code:text-[#0A0A0A] prose-code:bg-[#D4D8DC] prose-code:px-1 prose-strong:text-[#0A0A0A] prose-blockquote:border-l-4 prose-blockquote:border-[#0A0A0A] prose-blockquote:bg-[#D4D8DC] prose-blockquote:p-3 prose-li:text-[#0A0A0A]">
            <div class="rt-lang rt-lang-ru">
              <Content />
            </div>
            <div class="rt-lang rt-lang-uz">
              {entry.data.body_uz ? (
                <div class="space-y-4 whitespace-pre-line">{entry.data.body_uz}</div>
              ) : (
                <Content />
              )}
            </div>
            <div class="rt-lang rt-lang-en">
              {entry.data.body_en ? (
                <div class="space-y-4 whitespace-pre-line">{entry.data.body_en}</div>
              ) : (
                <Content />
              )}
            </div>
          </div>
        </div>

        <!-- Back to blog link -->
        <div class="mt-6 font-mono text-xs">
          <a
            href={`${base}/blog/`}
            class="hud-btn hud-btn--ghost"
          >
            <I18nText ru="← ВЕРНУТЬСЯ В РАЗДЕЛ БЛОГА" uz="← BLOG BO'LIMIGA QAYTISH" en="← BACK TO BLOG ARCHIVE" />
          </a>
        </div>
      </div>

      <!-- Right Column: Commercial & RFQ Sidebar -->
      <aside class="lg:col-span-4 flex flex-col space-y-6">
        <!-- Lead Trigger Card -->
        <div class="hud-glass-card p-6 font-mono sticky top-20 gap-4">
          <div class="border-b border-[#0A0A0A]/20 pb-2">
            <span class="text-xs font-bold text-[#0A0A0A] uppercase tracking-wider block">
              <I18nText ru="КОММЕРЧЕСКИЙ ОТДЕЛ // ВЭД" uz="TIJORAT BO'LIMI // TQI" en="COMMERCIAL DESK // TRADE" />
            </span>
            <span class="text-[11px] text-[#4A5056]">
              <I18nText ru="Расчет спецификации по теме публикации" uz="Maqola mavzusi bo'yicha hisob-kitob" en="RFQ calculation for article subject" />
            </span>
          </div>

          <p class="text-xs text-[#4A5056] font-sans leading-relaxed mb-6">
            <I18nText
              ru="Отправьте потребность вашего предприятия в ЖД узлах или системах СЦБ. Мы выставим счет с НДС 12% или подготовим расчет Landed Cost DDP в сумах за 60 минут."
              uz="Korxonangizning temir yo'l uzellari yoki STSB tizimlariga bo'lgan ehtiyojini yuboring. Biz 12% QQS bilan hisob taqdim etamiz yoki 60 daqiqada so'mda Landed Cost DDP hisobini tayyorlaymiz."
              en="Submit your company's bill of materials for rolling stock components or signaling units. We will issue an invoice with 12% VAT or a Landed Cost DDP quote in 60 minutes."
            />
          </p>

          <div class="space-y-3">
            <button
              type="button"
              data-lead-modal
              data-lead-subject={`Запрос расчета по материалу: ${entry.data.title}`}
              class="w-full border-2 border-[#0A0A0A] bg-[#0A0A0A] text-white py-3 text-xs font-bold tracking-wider hover:bg-transparent hover:text-[#0A0A0A] transition-colors cursor-pointer"
            >
              <I18nText ru="[ ЗАПРОСИТЬ РАСЧЕТ КП ]" uz="[ TIJORAT TAKLIFINI SO'RASH ]" en="[ REQUEST RFQ ESTIMATE ]" />
            </button>

            <a
              href={`tel:+998901189000`}
              class="w-full border border-[#0A0A0A] bg-white text-[#0A0A0A] py-2.5 text-xs font-bold text-center block hover:bg-[#0A0A0A] hover:text-white transition-colors"
            >
              +998 90 118-90-00 ↗
            </a>
          </div>

          <div class="mt-6 pt-4 border-t border-[#0A0A0A]/20 text-[11px] text-[#4A5056] space-y-1">
            <div>
              <I18nText ru="• Склад в Ташкенте: ТПК Index B2-2097" uz="• Toshkentdagi ombor: Index SICHM B2-2097" en="• Tashkent Hub: Index Complex B2-2097" />
            </div>
            <div>
              <I18nText ru="• Плательщик НДС: 12% (ЭСФ Didox)" uz="• QQS to'lovchisi: 12% (Didox EHF)" en="• VAT Payer: 12% (Didox ESF)" />
            </div>
            <div>
              <I18nText ru="• Поставка: DDP Ташкент под ключ" uz="• Yetkazib berish: DDP Toshkent kalit topshirish" en="• Delivery: DDP Tashkent Turnkey" />
            </div>
          </div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
