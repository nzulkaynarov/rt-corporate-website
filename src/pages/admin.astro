    <meta name="robots" content="noindex, nofollow" />
    <title>RailTech CMS — Панель управления контентом</title>
    <link href={`${base}/admin/config.yml`} type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script is:inline src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js"></script>
  </body>
</html>
