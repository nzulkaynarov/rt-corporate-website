---
// The CMS bundle comes from a CDN: pinned version + Subresource Integrity, so a changed file is refused by the browser.
// Upgrading Sveltia = new version AND new hash: `curl -sL <url> | openssl dgst -sha384 -binary | openssl base64 -A`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>RailTech CMS</title>
    <link href={`${base}/admin/config.yml`} type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script is:inline src="https://unpkg.com/@sveltia/cms@0.265.2/dist/sveltia-cms.js" integrity="sha384-3sX+CEbzGmrZkO4W96cXrSz3A22o6qqeT+pZiWYbyMQDPPTlX/KBZX7dmGwGQpA5" crossorigin="anonymous"></script>
  </body>
</html>
