{
  "name": "railtech-website",
  "type": "module",
  "version": "3.0.0",
  "description": "railtech.uz — company website of RailTech LLC (Astro, RU/UZ/EN). See docs/ARCHITECTURE.md",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/validate-cms-config.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "postbuild": "node scripts/check-build.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:cms": "node scripts/validate-cms-config.mjs",
    "check:content": "node scripts/check-content.mjs",
